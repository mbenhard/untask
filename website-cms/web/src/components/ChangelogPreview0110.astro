---
// v0.1.10 "Floating Spotlight" — Quick Add release preview
// Standalone Quick Add window floating over a mini app window backdrop
---

<div class="preview-0110" data-changelog-preview="0110">
  <div class="preview-0110-stage">

    <!-- Background: mini app window (decorative) -->
    <div class="preview-0110-bg-window">
      <div class="bg-win-chrome">
        <span class="bg-dot" style="background:#FF5F57"></span>
        <span class="bg-dot" style="background:#FEBC2E"></span>
        <span class="bg-dot" style="background:#28C840"></span>
      </div>
      <div class="bg-win-tabs">
        <span class="bg-tab bg-tab-active">Today</span>
        <span class="bg-tab">Tasks</span>
        <span class="bg-tab">Inbox</span>
      </div>
      <div class="bg-win-body">
        <div class="bg-task-row">
          <span class="bg-checkbox"></span>
          <span class="bg-dot-priority" style="background:var(--color-amber,#f59e0b)"></span>
          <span class="bg-title-line" style="width:70%"></span>
        </div>
        <div class="bg-task-row">
          <span class="bg-checkbox"></span>
          <span class="bg-dot-priority" style="background:var(--color-rose,#f43f5e)"></span>
          <span class="bg-title-line" style="width:55%"></span>
        </div>
        <div class="bg-task-row">
          <span class="bg-checkbox bg-checkbox-done"></span>
          <span class="bg-dot-priority" style="background:color-mix(in srgb, var(--foreground) 15%, transparent)"></span>
          <span class="bg-title-line bg-title-done" style="width:45%"></span>
        </div>
      </div>
    </div>

    <!-- Hero: Quick Add window -->
    <div id="qa-0110" class="preview-0110-qa">
      <div class="qa-window">
        <!-- Title input row -->
        <div class="qa-input-row">
          <div class="qa-checkbox-area">
            <span class="qa-ghost-checkbox"></span>
            <span id="qa-priority-dot-0110" class="qa-priority-dot"></span>
          </div>
          <div class="qa-input-wrap">
            <span id="qa-input-text-0110" class="qa-input-text"></span>
            <span id="qa-caret-0110" class="qa-caret"></span>
            <span class="qa-placeholder" id="qa-placeholder-0110">Add to inbox...</span>
          </div>
          <div class="qa-hints">
            <kbd class="qa-kbd" id="qa-kbd-tab-0110">tab</kbd>
            <kbd class="qa-kbd">↵</kbd>
          </div>
        </div>

        <!-- Slash command popover -->
        <div id="qa-popover-0110" class="qa-popover">
          <div id="qa-pop-high" class="qa-pop-item qa-pop-selected">
            <span class="qa-pop-dot" style="background:#f43f5e"></span>
            <span class="qa-pop-label">/priority</span>
            <span class="qa-pop-value">High</span>
          </div>
          <div class="qa-pop-item">
            <span class="qa-pop-dot" style="background:#f59e0b"></span>
            <span class="qa-pop-label">/priority</span>
            <span class="qa-pop-value">Medium</span>
          </div>
          <div class="qa-pop-item">
            <span class="qa-pop-dot" style="background:#22c55e"></span>
            <span class="qa-pop-label">/priority</span>
            <span class="qa-pop-value">Low</span>
          </div>
        </div>

        <!-- Metadata row (hidden initially) -->
        <div id="qa-meta-0110" class="qa-meta-row">
          <span id="qa-meta-priority-0110" class="qa-meta-seg qa-meta-active">
            <span class="qa-meta-dot" style="background:#f43f5e"></span>
            High
          </span>
          <span class="qa-meta-sep">&middot;</span>
          <span class="qa-meta-seg qa-meta-dim">due</span>
          <span class="qa-meta-sep">&middot;</span>
          <span id="qa-meta-today-0110" class="qa-meta-seg qa-meta-dim">today</span>
        </div>
      </div>
    </div>

    <!-- Demo cursor -->
    <div id="cursor-0110" class="preview-cursor">
      <div id="cursor-inner-0110" class="preview-cursor-inner">
        <img src="/cursor-default.svg" width="20" height="25" alt="" />
      </div>
    </div>

  </div>
</div>

<style>
  .preview-0110 {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.5rem;
  }

  .preview-0110-stage {
    width: 100%;
    height: 100%;
    position: relative;
    background: color-mix(in srgb, var(--background) 85%, black);
    background-image: radial-gradient(ellipse at 58% 52%, rgba(255,255,255,0.025) 0%, transparent 65%);
  }

  /* ─── Background mini window ─── */

  .preview-0110-bg-window {
    position: absolute;
    top: 8%;
    left: 5%;
    width: 280px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--background);
    opacity: 0.35;
    filter: blur(1px);
    transform-origin: top left;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .preview-0110-bg-window { display: none; }
  }

  .bg-win-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
  }

  .bg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.7;
  }

  .bg-win-tabs {
    display: flex;
    gap: 2px;
    padding: 0 8px 4px;
    justify-content: flex-end;
  }

  .bg-tab {
    font-family: var(--font-sans);
    font-size: 8px;
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--muted-foreground);
  }

  .bg-tab-active {
    background: var(--accent);
    color: var(--foreground);
  }

  .bg-win-body {
    padding: 6px 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--border);
  }

  .bg-task-row {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 16px;
  }

  .bg-checkbox {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--foreground) 30%, transparent);
    flex-shrink: 0;
  }

  .bg-checkbox-done {
    border-style: solid;
    border-color: var(--foreground);
    background: var(--foreground);
  }

  .bg-dot-priority {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bg-title-line {
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--foreground) 20%, transparent);
  }

  .bg-title-done {
    opacity: 0.4;
  }

  /* ─── Quick Add window ─── */

  .preview-0110-qa {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(260px, 60%, 380px);
    opacity: 0;
    animation: qa-float 3s ease-in-out infinite;
  }

  @keyframes qa-float {
    0%, 100% { margin-top: 0; }
    50% { margin-top: -2px; }
  }

  .qa-window {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: var(--background);
    box-shadow:
      0 0 80px -20px rgba(255,255,255,0.04),
      0 20px 50px -15px rgba(0,0,0,0.5);
    overflow: visible;
  }

  .qa-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    height: 42px;
  }

  .qa-checkbox-area {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .qa-ghost-checkbox {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--foreground) 30%, transparent);
  }

  .qa-priority-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--foreground) 15%, transparent);
    transition: background 0.3s;
  }

  .qa-input-wrap {
    flex: 1;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
  }

  .qa-input-text {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--foreground);
    white-space: nowrap;
  }

  .qa-caret {
    display: inline-block;
    width: 1.5px;
    height: 14px;
    background: var(--foreground);
    margin-left: 0.5px;
    opacity: 0;
    vertical-align: middle;
  }

  .qa-caret.blinking {
    animation: caret-blink 1s step-end infinite;
  }

  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .qa-placeholder {
    position: absolute;
    left: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    color: color-mix(in srgb, var(--muted-foreground) 35%, transparent);
    pointer-events: none;
  }

  .qa-hints {
    display: flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .qa-kbd {
    display: inline-flex;
    height: 16px;
    align-items: center;
    padding: 0 4px;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 40%, transparent);
    font-family: var(--font-mono);
    font-size: 8px;
    color: color-mix(in srgb, var(--muted-foreground) 60%, transparent);
    line-height: 1;
  }

  /* ─── Slash popover ─── */

  .qa-popover {
    position: absolute;
    bottom: 100%;
    left: 12px;
    right: 12px;
    margin-bottom: 4px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card, var(--background));
    box-shadow: 0 8px 24px -8px rgba(0,0,0,0.4);
    padding: 4px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .qa-popover.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .qa-pop-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-foreground);
  }

  .qa-pop-selected {
    background: var(--accent);
    color: var(--foreground);
  }

  .qa-pop-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .qa-pop-label {
    opacity: 0.5;
  }

  .qa-pop-value {
    margin-left: auto;
    font-size: 10px;
  }

  /* ─── Metadata row ─── */

  .qa-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    margin: 0 4px;
    padding-top: 6px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.25s ease;
  }

  .qa-meta-row.expanded {
    max-height: 30px;
    opacity: 1;
  }

  .qa-meta-seg {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: default;
  }

  .qa-meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .qa-meta-active {
    color: var(--foreground);
  }

  .qa-meta-dim {
    color: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
    transition: color 0.2s;
  }

  .qa-meta-dim.lit {
    color: var(--foreground);
  }

  .qa-meta-sep {
    color: var(--border);
    user-select: none;
  }

  /* ─── Cursor ─── */

  .preview-cursor {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s;
    will-change: transform;
  }

  .preview-cursor-inner {
    transition: transform 0.1s;
  }
</style>

<script is:inline>
(function() {
  var timers = [];
  var running = false;

  function delay(ms) {
    return new Promise(function(resolve) {
      var t = setTimeout(resolve, ms);
      timers.push(t);
    });
  }

  function clearAllTimers() {
    timers.forEach(clearTimeout);
    timers = [];
  }

  // DOM refs
  var qaWindow = document.getElementById('qa-0110');
  var inputText = document.getElementById('qa-input-text-0110');
  var caret = document.getElementById('qa-caret-0110');
  var placeholder = document.getElementById('qa-placeholder-0110');
  var priorityDot = document.getElementById('qa-priority-dot-0110');
  var popover = document.getElementById('qa-popover-0110');
  var metaRow = document.getElementById('qa-meta-0110');
  var metaToday = document.getElementById('qa-meta-today-0110');
  var kbdTab = document.getElementById('qa-kbd-tab-0110');
  var cursor = document.getElementById('cursor-0110');
  var cursorInner = document.getElementById('cursor-inner-0110');

  function moveCursor(el) {
    if (!cursor || !el) return;
    var stage = cursor.parentElement;
    if (!stage) return;
    var sr = stage.getBoundingClientRect();
    var er = el.getBoundingClientRect();
    var x = er.left - sr.left + er.width * 0.35;
    var y = er.top - sr.top + er.height * 0.35;
    cursor.style.opacity = '1';
    cursor.style.transform = 'translate(' + x + 'px,' + y + 'px)';
  }

  function clickCursor() {
    if (!cursorInner) return;
    cursorInner.style.transform = 'scale(0.75)';
    return delay(100).then(function() {
      cursorInner.style.transform = 'scale(1)';
    });
  }

  function typeText(text, speed) {
    var i = 0;
    return new Promise(function(resolve) {
      function step() {
        if (!running) return;
        if (i < text.length) {
          inputText.textContent += text[i];
          i++;
          var t = setTimeout(step, speed || 50);
          timers.push(t);
        } else {
          resolve();
        }
      }
      step();
    });
  }

  function resetState() {
    if (qaWindow) qaWindow.style.opacity = '0';
    if (inputText) inputText.textContent = '';
    if (caret) { caret.classList.remove('blinking'); caret.style.opacity = '0'; }
    if (placeholder) placeholder.style.opacity = '1';
    if (priorityDot) priorityDot.style.background = 'color-mix(in srgb, var(--foreground) 15%, transparent)';
    if (popover) popover.classList.remove('visible');
    if (metaRow) metaRow.classList.remove('expanded');
    if (metaToday) metaToday.classList.remove('lit');
    if (kbdTab) kbdTab.style.opacity = '';
    if (cursor) cursor.style.opacity = '0';
  }

  async function runDemo() {
    if (!running) return;
    resetState();

    // Fade in QA window
    if (qaWindow) {
      qaWindow.style.transition = 'opacity 0.4s ease-out';
      qaWindow.style.opacity = '1';
    }
    await delay(500);
    if (!running) return;

    // Show cursor, move to input
    var inputWrap = qaWindow ? qaWindow.querySelector('.qa-input-wrap') : null;
    if (inputWrap) moveCursor(inputWrap);
    await delay(500);
    if (!running) return;

    // Click
    await clickCursor();
    await delay(100);
    if (!running) return;

    // Show caret, hide placeholder
    if (caret) { caret.style.opacity = '1'; caret.classList.add('blinking'); }
    if (placeholder) placeholder.style.opacity = '0';

    // Type task title
    await typeText('Ship changelog previews', 50);
    if (!running) return;
    await delay(300);
    if (!running) return;

    // Type slash command
    if (caret) caret.classList.remove('blinking');
    await typeText(' /p', 80);
    if (!running) return;

    // Show popover
    if (popover) popover.classList.add('visible');
    await delay(400);
    if (!running) return;

    // Move cursor to "High" option
    var highItem = document.getElementById('qa-pop-high');
    if (highItem) moveCursor(highItem);
    await delay(450);
    if (!running) return;

    // Click "High"
    await clickCursor();
    await delay(100);
    if (!running) return;

    // Close popover, update priority dot, clean input
    if (popover) popover.classList.remove('visible');
    if (priorityDot) priorityDot.style.background = '#f43f5e';
    if (inputText) inputText.textContent = 'Ship changelog previews';
    if (caret) caret.classList.add('blinking');

    await delay(200);
    if (!running) return;

    // Expand metadata row
    if (metaRow) metaRow.classList.add('expanded');
    if (kbdTab) kbdTab.style.opacity = '0.3';
    await delay(400);
    if (!running) return;

    // Move cursor to "today" segment
    if (metaToday) moveCursor(metaToday);
    await delay(450);
    if (!running) return;

    // Click today
    await clickCursor();
    await delay(100);
    if (!running) return;
    if (metaToday) metaToday.classList.add('lit');

    // Hold
    await delay(1500);
    if (!running) return;

    // Fade out cursor
    if (cursor) cursor.style.opacity = '0';
    await delay(400);
    if (!running) return;

    // Fade out window
    if (qaWindow) {
      qaWindow.style.transition = 'opacity 0.4s, transform 0.4s';
      qaWindow.style.opacity = '0.5';
    }
    if (caret) { caret.classList.remove('blinking'); caret.style.opacity = '0'; }
    await delay(1500);
    if (!running) return;

    // Loop
    runDemo();
  }

  window.startPreview_0110 = function() {
    if (running) return;
    running = true;
    runDemo();
  };

  window.stopPreview_0110 = function() {
    running = false;
    clearAllTimers();
    resetState();
  };
})();
</script>

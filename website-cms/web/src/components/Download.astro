---
// Download section — tabbed terminal CTA
interface Props {
  heading: string;
  subheading: string;
  brewCommand: string;
  xattrCommand: string;
  version: string;
}

const { heading, subheading, brewCommand, xattrCommand, version } = Astro.props;
---

<section id="download" data-reveal class="px-6 pt-24 pb-4 sm:pt-32 sm:pb-6">
  <div data-thread-content class="mx-auto max-w-lg">

    <div class="flex flex-col items-center text-center">

      <div class="mb-6 flex flex-col items-center text-center">
        <h2 class="font-sans text-2xl font-normal tracking-tight text-foreground sm:text-3xl">
            {heading}
          </h2>
          <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/55">
            {subheading}
          </p>
      </div>

      <!-- Metadata strip -->
      <p class="font-mono text-[10px] tracking-[0.06em] text-muted-foreground/55">
        Untask <span class="text-muted-foreground/35">&middot;</span>
        {version} <span class="text-muted-foreground/35">&middot;</span>
        macOS <span class="text-muted-foreground/35">&middot;</span>
        <a
          href="https://github.com/mbenhard/untask/releases/latest"
          onclick="downloadLatest(event)"
          class="text-foreground/80 transition-colors hover:text-foreground"
        >.zip</a>
        <span class="text-muted-foreground/35">&middot;</span>
        <a
          href="https://github.com/mbenhard/untask"
          class="text-foreground/80 transition-colors hover:text-foreground"
        >source</a>
      </p>

      <!-- Terminal window (macOS style) -->
      <div class="term-window app-preview mt-4 w-full" id="install-terminal">

          <!-- Title bar with traffic lights + tabs -->
          <div class="term-titlebar">
            <div class="term-traffic">
              <span class="term-dot term-dot--close"></span>
              <span class="term-dot term-dot--minimize"></span>
              <span class="term-dot term-dot--zoom"></span>
            </div>
            <div class="term-tabs">
              <button
                class="term-tab term-tab--active"
                data-tab="brew"
                onclick="switchTab('brew')"
              >
                Homebrew
              </button>
              <button
                class="term-tab"
                data-tab="manual"
                onclick="switchTab('manual')"
              >
                Manual
              </button>
            </div>
          </div>

          <!-- Homebrew tab content -->
          <div class="term-body" id="tab-brew">
            <div class="term-lines" id="brew-lines">
              <div class="term-line" data-type="cmd" data-delay="0">
                <span class="term-prompt">$</span>
                <span class="term-text" data-text="brew install mbenhard/untask/untask"></span>
                <button class="term-copy" onclick="copyCmd('brew install mbenhard/untask/untask', this)" aria-label="Copy command">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <svg class="copy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </div>
              <div class="term-line term-line--output term-line--hidden" data-delay="600">
                <span class="term-muted">==> Tapping mbenhard/untask</span>
              </div>
              <div class="term-line term-line--output term-line--hidden" data-delay="1100">
                <span class="term-muted">==> Downloading Untask</span>
              </div>
              <div class="term-line term-line--output term-line--hidden" data-delay="1600">
                <span class="term-muted">==> Installing Cask untask</span>
              </div>
              <div class="term-line term-line--output term-line--hidden" data-delay="2100">
                <span class="term-muted">==> Moving Untask.app to /Applications</span>
              </div>
              <div class="term-line term-line--output term-line--hidden" data-delay="2600">
                <span class="term-success">&#10003;</span>
                <span class="term-muted"> untask was successfully installed!</span>
              </div>
              <div class="term-line term-line--hidden" data-delay="3100">
                <span class="term-prompt">$</span>
                <span class="term-cursor"></span>
              </div>
            </div>
          </div>

          <!-- Manual tab content -->
          <div class="term-body hidden" id="tab-manual">
            <div class="term-lines" id="manual-lines">
              <div class="term-line term-line--stagger">
                <span class="term-dim"># Untask is not code-signed.</span>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-dim"># Apple charges $99/yr &mdash; Untask is free.</span>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-dim"># Source is open. </span>
                <a href="https://github.com/mbenhard/untask" class="term-link term-link--dim">Verify it yourself.</a>
              </div>
              <div class="term-line term-line--stagger" aria-hidden="true">
                <span class="term-dim">#</span>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-muted"># 1. </span>
                <a
                  href="https://github.com/mbenhard/untask/releases/latest"
                  onclick="downloadLatest(event)"
                  class="term-link"
                >Download .zip from GitHub Releases</a>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-muted"># 2. Unzip &amp; drag Untask to /Applications</span>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-muted"># 3. Allow unsigned app</span>
              </div>
              <div class="term-line term-line--stagger">
                <span class="term-prompt">$</span>
                <span class="term-text">xattr -cr /Applications/Untask.app</span>
                <button class="term-copy" onclick="copyCmd('xattr -cr /Applications/Untask.app', this)" aria-label="Copy command">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <svg class="copy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

        </div>

      <!-- macOS Dock -->
      <div class="mt-6 flex justify-center" id="install-dock">
        <div class="install-dock-bar">
          <div class="install-dock-item">
            <img src="/finder.png" alt="" width="36" height="36" class="install-dock-icon" draggable="false" />
          </div>
          <div class="install-dock-item">
            <img src="/safari.png" alt="" width="36" height="36" class="install-dock-icon" draggable="false" />
          </div>
          <div class="install-dock-item">
            <img src="/messages.png" alt="" width="36" height="36" class="install-dock-icon" draggable="false" />
          </div>
          <div class="install-dock-item">
            <img src="/calendar.png" alt="" width="36" height="36" class="install-dock-icon" draggable="false" />
          </div>
          <!-- Terminal (active — its window is open above) -->
          <div class="install-dock-item">
            <img src="/terminal.png" alt="Terminal" width="36" height="36" class="install-dock-icon" draggable="false" />
            <span class="install-dock-dot install-dock-dot--active"></span>
          </div>
          <!-- Untask slot (empty until animation completes) -->
          <div class="install-dock-item install-dock-app" id="dock-untask-slot">
            <img src="/icon-app.png" alt="Untask" width="36" height="36" class="install-dock-icon install-dock-icon--incoming" draggable="false" />
          </div>
          <div class="install-dock-item">
            <img src="/reminders.png" alt="" width="36" height="36" class="install-dock-icon" draggable="false" />
          </div>
        </div>
      </div>



    </div>
  </div>
</section>

<style>
  /* ─── Terminal window (macOS style) ─── */
  .term-window {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow:
      0 8px 30px -12px rgba(0, 0, 0, 0.4),
      0 2px 8px -2px rgba(0, 0, 0, 0.15);
  }

  /* ─── Title bar ─── */
  .term-titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--accent) 60%, var(--card));
  }

  /* ─── Traffic light dots ─── */
  .term-traffic {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .term-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .term-dot--close    { background: #FF5F57; }
  .term-dot--minimize { background: #FEBC2E; }
  .term-dot--zoom     { background: #28C840; }

  /* ─── Tabs (inside title bar) ─── */
  .term-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }

  .term-tab {
    font-family: var(--font-mono, 'Geist Mono Variable', monospace);
    font-size: 10px;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: 4px;
    color: color-mix(in srgb, var(--muted-foreground) 45%, transparent);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .term-tab:hover {
    color: var(--muted-foreground);
  }

  .term-tab--active {
    color: var(--foreground);
    background: color-mix(in srgb, var(--muted-foreground) 10%, transparent);
  }

  /* ─── Terminal body ─── */
  .term-body {
    padding: 14px 16px;
    min-height: 100px;
  }

  /* ─── Lines ─── */
  .term-line {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono, 'Geist Mono Variable', monospace);
    font-size: 12px;
    line-height: 1.9;
    position: relative;
  }

  .term-line--comment {
    opacity: 0.7;
  }

  /* ─── Stagger fade-in for manual tab ─── */
  .term-line--stagger {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .term-line--stagger.term-line--entered {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Clickable link inside terminal ─── */
  .term-link {
    color: var(--muted-foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--muted-foreground) 30%, transparent);
    transition: color 0.15s, text-decoration-color 0.15s;
    cursor: pointer;
  }

  .term-link:hover {
    color: var(--foreground);
    text-decoration-color: var(--foreground);
  }

  .term-line--hidden {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .term-line--visible {
    opacity: 1;
  }

  .term-prompt {
    color: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
    user-select: none;
    flex-shrink: 0;
  }

  .term-text {
    color: var(--foreground);
    white-space: nowrap;
  }

  .term-muted {
    color: var(--muted-foreground);
  }

  .term-dim {
    color: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
  }

  .term-link--dim {
    color: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
    text-decoration-color: color-mix(in srgb, var(--muted-foreground) 20%, transparent);
  }

  .term-link--dim:hover {
    color: var(--muted-foreground);
    text-decoration-color: var(--muted-foreground);
  }

  .term-success {
    color: #4ade80;
    font-weight: 500;
  }

  /* ─── Blinking cursor ─── */
  .term-cursor {
    display: inline-block;
    width: 6px;
    height: 13px;
    background: var(--foreground);
    opacity: 0.7;
    animation: term-blink 1s step-end infinite;
  }

  @keyframes term-blink {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 0; }
  }

  /* ─── Typing cursor (during animation) ─── */
  .term-text--typing::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 13px;
    background: var(--foreground);
    opacity: 0.7;
    vertical-align: text-bottom;
    margin-left: 1px;
    animation: term-blink 1s step-end infinite;
  }

  /* ─── Copy button ─── */
  .term-copy {
    flex-shrink: 0;
    margin-left: auto;
    padding: 2px;
    color: color-mix(in srgb, var(--muted-foreground) 25%, transparent);
    cursor: pointer;
    transition: color 0.15s;
    background: none;
    border: none;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }

  .term-line:hover .term-copy {
    opacity: 1;
  }

  .term-copy:hover {
    color: var(--muted-foreground);
  }

  .term-copy svg {
    width: 11px;
    height: 11px;
  }

  .term-copy .copy-check {
    display: none;
    color: #4ade80;
  }

  .term-copy--copied .copy-icon {
    display: none;
  }

  .term-copy--copied .copy-check {
    display: block;
  }

  /* ─── Dock ─── */
  .install-dock-bar {
    display: flex;
    align-items: center;
    padding: 8px;
    border-radius: 14px;
    background: var(--dock-bg);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 0.5px solid var(--dock-border);
    box-shadow: var(--dock-shadow);
  }

  .install-dock-item {
    position: relative;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-left: 5px;
  }

  .install-dock-item:first-child {
    margin-left: 0;
  }

  /* Untask slot: fully collapsed until expanded */
  .install-dock-app {
    width: 0;
    height: 36px;
    overflow: hidden;
    margin-left: 0;
    transition: width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                margin-left 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .install-dock-app.install-dock-app--expanded {
    width: 36px;
    margin-left: 5px;
    overflow: visible;
  }

  .install-dock-icon {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    transform-origin: bottom center;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .install-dock-item:hover .install-dock-icon {
    transform: translateY(-4px) scale(1.10);
  }

  /* Untask icon — hidden until install animation triggers it */
  .install-dock-icon--incoming {
    opacity: 0;
    transform: translateY(-20px) scale(0.5);
  }

  .install-dock-icon--incoming.install-dock-icon--landed {
    opacity: 1;
    transform: translateY(0) scale(1);
    animation: dock-bounce-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes dock-bounce-in {
    0%   { opacity: 0; transform: translateY(-20px) scale(0.5); }
    50%  { opacity: 1; transform: translateY(2px) scale(1.05); }
    70%  { transform: translateY(-3px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Active dot under the icon (appears after landing) */
  .install-dock-dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0;
    margin: 1px auto 0;
    transition: opacity 0.3s ease 0.4s;
  }

  .install-dock-dot--active {
    opacity: 0.5;
  }

  /* ─── Reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .term-cursor,
    .term-text--typing::after {
      animation: none;
      opacity: 0.7;
    }
    .term-line--hidden {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  /* Tab switching */
  function switchTab(tab) {
    document.querySelectorAll('.term-tab').forEach(function(t) {
      t.classList.toggle('term-tab--active', t.dataset.tab === tab);
    });
    document.getElementById('tab-brew').classList.toggle('hidden', tab !== 'brew');
    document.getElementById('tab-manual').classList.toggle('hidden', tab !== 'manual');

    // Stagger fade-in for manual tab lines (once only)
    if (tab === 'manual' && !switchTab._manualPlayed) {
      switchTab._manualPlayed = true;
      var lines = document.querySelectorAll('#manual-lines .term-line--stagger');
      lines.forEach(function(line, i) {
        setTimeout(function() { line.classList.add('term-line--entered'); }, 60 + i * 80);
      });
    }
  }

  /* Typing animation for brew tab */
  (function() {
    var played = false;

    function typeText(el, text, speed, cb) {
      var i = 0;
      el.textContent = '';
      el.classList.add('term-text--typing');
      function tick() {
        if (i < text.length) {
          el.textContent += text[i];
          i++;
          setTimeout(tick, speed);
        } else {
          el.classList.remove('term-text--typing');
          if (cb) cb();
        }
      }
      tick();
    }

    function revealLines() {
      var lines = document.querySelectorAll('#brew-lines .term-line--hidden');
      var maxDelay = 0;
      lines.forEach(function(line) {
        var delay = parseInt(line.dataset.delay, 10) || 0;
        if (delay > maxDelay) maxDelay = delay;
        setTimeout(function() {
          line.classList.add('term-line--visible');
        }, delay);
      });

      // Expand dock slot, then bounce icon in
      setTimeout(function() {
        var slot = document.getElementById('dock-untask-slot');
        if (slot) slot.classList.add('install-dock-app--expanded');
        setTimeout(function() {
          var icon = document.querySelector('.install-dock-icon--incoming');
          if (icon) {
            icon.classList.add('install-dock-icon--landed');
            // After bounce animation finishes, strip animation classes
            // so the icon becomes a normal dock icon with working hover
            icon.addEventListener('animationend', function() {
              icon.classList.remove('install-dock-icon--incoming', 'install-dock-icon--landed');
              icon.style.opacity = '1';
            }, { once: true });
          }
        }, 250);
      }, maxDelay + 400);
    }

    function playAnimation() {
      if (played) return;
      played = true;

      var cmdLine = document.querySelector('#brew-lines .term-text[data-text]');
      if (!cmdLine) return;
      var text = cmdLine.dataset.text;

      typeText(cmdLine, text, 35, function() {
        revealLines();
      });
    }

    // Reduced motion: show everything immediately
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var cmdLine = document.querySelector('#brew-lines .term-text[data-text]');
      if (cmdLine) cmdLine.textContent = cmdLine.dataset.text;
      document.querySelectorAll('#brew-lines .term-line--hidden').forEach(function(l) {
        l.classList.add('term-line--visible');
      });
      var slot = document.getElementById('dock-untask-slot');
      if (slot) { slot.classList.add('install-dock-app--expanded'); slot.style.transition = 'none'; }
      var icon = document.querySelector('.install-dock-icon--incoming');
      if (icon) { icon.classList.add('install-dock-icon--landed'); icon.style.animation = 'none'; }
      document.querySelectorAll('#manual-lines .term-line--stagger').forEach(function(l) {
        l.classList.add('term-line--entered');
      });
      played = true;
    }

    // Trigger on scroll into view
    if ('IntersectionObserver' in window && !played) {
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          setTimeout(playAnimation, 300);
          observer.disconnect();
        }
      }, { threshold: 0.4 });

      var terminal = document.getElementById('install-terminal');
      if (terminal) observer.observe(terminal);
    } else if (!played) {
      playAnimation();
    }
  })();

  /* Copy command */
  function copyCmd(text, btn) {
    navigator.clipboard.writeText(text).then(function() {
      btn.classList.add('term-copy--copied');
      setTimeout(function() {
        btn.classList.remove('term-copy--copied');
      }, 1500);
    });
  }

  /* Download latest .zip */
  function downloadLatest(e) {
    e.preventDefault();
    fetch('https://api.github.com/repos/mbenhard/untask/releases/latest')
      .then(function(r) { return r.json(); })
      .then(function(release) {
        var zip = release.assets.find(function(a) { return a.name.endsWith('.zip'); });
        if (zip) {
          window.location.href = zip.browser_download_url;
        } else {
          window.location.href = release.html_url;
        }
      })
      .catch(function() {
        window.location.href = 'https://github.com/mbenhard/untask/releases/latest';
      });
  }
</script>

---
// v0.1.7 "Sync Bridge" — Apple Reminders Sync + Global Undo preview
// Two cards side-by-side with animated sync particles flowing between them
---

<div class="preview-0107" data-changelog-preview="0107">
  <div class="preview-0107-stage">

    <!-- Left card: Apple Reminders style -->
    <div id="rem-card-0107" class="rem-card-0107">
      <div class="rem-chrome">
        <svg class="rem-app-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="4"/>
          <path d="M8 12h8"/>
          <path d="M12 8v8"/>
        </svg>
        <span class="rem-title">Reminders</span>
      </div>
      <div class="rem-list">
        <div class="rem-item">
          <span class="rem-circle"></span>
          <span class="rem-text">Weekly team sync</span>
        </div>
        <div class="rem-item">
          <span class="rem-circle"></span>
          <span class="rem-text">Review Q3 budget</span>
        </div>
        <div id="rem-item-new-0107" class="rem-item rem-item-hidden">
          <span class="rem-circle"></span>
          <span class="rem-text">Ship v0.1.7 release</span>
        </div>
        <div class="rem-item">
          <span id="rem-circle-done-0107" class="rem-circle"></span>
          <span id="rem-text-done-0107" class="rem-text">Send invoice to Kaya</span>
        </div>
      </div>
    </div>

    <!-- Sync particles container -->
    <div class="sync-bridge-0107">
      <div class="sync-label-0107">
        <svg class="sync-icon-0107" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3 4 7l4 4"/><path d="M4 7h16"/>
          <path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>
        </svg>
      </div>
      <!-- Animated dots (created via CSS) -->
      <div id="sync-dot-lr-0107" class="sync-dot-0107 sync-dot-lr"></div>
      <div id="sync-dot-rl-0107" class="sync-dot-0107 sync-dot-rl"></div>
    </div>

    <!-- Right card: Untask style -->
    <div id="ut-card-0107" class="ut-card-0107">
      <div class="ut-chrome">
        <div class="ut-dots">
          <span style="background:#FF5F57"></span>
          <span style="background:#FEBC2E"></span>
          <span style="background:#28C840"></span>
        </div>
        <div class="ut-tabs">
          <span class="ut-tab ut-tab-active">Today</span>
          <span class="ut-tab">Tasks</span>
        </div>
      </div>
      <div class="ut-list">
        <div class="ut-item">
          <span class="ut-cb"></span>
          <span class="ut-pri" style="background:#f59e0b"></span>
          <span class="ut-title">Weekly team sync</span>
          <span class="ut-badge">today</span>
        </div>
        <div class="ut-item">
          <span class="ut-cb"></span>
          <span class="ut-pri" style="background:color-mix(in srgb, var(--foreground) 15%, transparent)"></span>
          <span class="ut-title">Review Q3 budget</span>
          <span class="ut-badge">Feb 20</span>
        </div>
        <div id="ut-item-done-0107" class="ut-item">
          <span id="ut-cb-done-0107" class="ut-cb"></span>
          <span id="ut-pri-done-0107" class="ut-pri" style="background:#f43f5e"></span>
          <span id="ut-title-done-0107" class="ut-title">Send invoice to Kaya</span>
        </div>
        <div id="ut-item-new-0107" class="ut-item ut-item-hidden">
          <span class="ut-cb"></span>
          <span class="ut-pri" style="background:#22c55e"></span>
          <span class="ut-title">Ship v0.1.7 release</span>
          <span class="ut-badge">tomorrow</span>
        </div>
      </div>
    </div>

    <!-- Undo toast -->
    <div id="toast-0107" class="toast-0107">
      <span id="toast-text-0107" class="toast-label">3 tasks synced</span>
      <span class="toast-sep">&middot;</span>
      <span class="toast-action">Undo</span>
    </div>

  </div>
</div>

<style>
  .preview-0107 {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.5rem;
  }

  .preview-0107-stage {
    width: 100%;
    height: 100%;
    position: relative;
    background: color-mix(in srgb, var(--background) 85%, black);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  /* ─── Reminders card (left) ─── */

  .rem-card-0107 {
    width: clamp(140px, 28%, 200px);
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--background);
    overflow: hidden;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .rem-card-0107.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .rem-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .rem-app-icon {
    width: 14px;
    height: 14px;
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  .rem-title {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    color: var(--foreground);
  }

  .rem-list {
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rem-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 4px;
    border-radius: 4px;
    transition: opacity 0.3s, transform 0.3s;
  }

  .rem-item-hidden {
    opacity: 0;
    max-height: 0;
    padding: 0 4px;
    overflow: hidden;
    transition: opacity 0.35s, max-height 0.35s ease, padding 0.35s;
  }

  .rem-item-hidden.shown {
    opacity: 1;
    max-height: 28px;
    padding: 4px 4px;
  }

  .rem-circle {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--muted-foreground) 35%, transparent);
    flex-shrink: 0;
    transition: background 0.3s, border-color 0.3s;
    position: relative;
  }

  .rem-circle.checked {
    background: color-mix(in srgb, var(--muted-foreground) 40%, transparent);
    border-color: color-mix(in srgb, var(--muted-foreground) 40%, transparent);
  }

  .rem-circle.checked::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 3.5px;
    width: 3px;
    height: 5px;
    border: solid var(--background);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .rem-text {
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s, text-decoration 0.3s;
  }

  .rem-text.struck {
    text-decoration: line-through;
    color: var(--muted-foreground);
  }

  /* ─── Sync bridge (center) ─── */

  .sync-bridge-0107 {
    width: clamp(50px, 10%, 80px);
    height: 80px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sync-label-0107 {
    opacity: 0.2;
  }

  .sync-icon-0107 {
    width: 16px;
    height: 16px;
    color: var(--muted-foreground);
  }

  .sync-dot-0107 {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--foreground);
    opacity: 0;
  }

  .sync-dot-lr {
    top: 35%;
  }

  .sync-dot-rl {
    top: 55%;
  }

  .sync-dot-lr.animate {
    animation: dot-fly-lr 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .sync-dot-rl.animate {
    animation: dot-fly-rl 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes dot-fly-lr {
    0% { left: 0; opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
    100% { left: calc(100% - 5px); opacity: 0; transform: scale(0.8); }
  }

  @keyframes dot-fly-rl {
    0% { right: 0; opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
    100% { right: calc(100% - 5px); opacity: 0; transform: scale(0.8); }
  }

  /* ─── Untask card (right) ─── */

  .ut-card-0107 {
    width: clamp(160px, 32%, 230px);
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--background);
    overflow: hidden;
    opacity: 0;
    transform: translateX(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .ut-card-0107.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .ut-chrome {
    display: flex;
    align-items: center;
    padding: 6px 8px 4px;
  }

  .ut-dots {
    display: flex;
    gap: 4px;
  }

  .ut-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    opacity: 0.7;
  }

  .ut-tabs {
    margin-left: auto;
    display: flex;
    gap: 2px;
  }

  .ut-tab {
    font-family: var(--font-sans);
    font-size: 8px;
    font-weight: 500;
    padding: 2px 5px;
    border-radius: 4px;
    color: var(--muted-foreground);
  }

  .ut-tab-active {
    background: var(--accent);
    color: var(--foreground);
  }

  .ut-list {
    padding: 4px 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .ut-item {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 4px;
    border-radius: 4px;
    transition: opacity 0.3s, transform 0.3s;
  }

  .ut-item-hidden {
    opacity: 0;
    max-height: 0;
    padding: 0 4px;
    overflow: hidden;
    transition: opacity 0.35s, max-height 0.35s ease, padding 0.35s;
  }

  .ut-item-hidden.shown {
    opacity: 1;
    max-height: 28px;
    padding: 4px 4px;
  }

  .ut-cb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--foreground) 30%, transparent);
    flex-shrink: 0;
    transition: background 0.3s, border-color 0.3s, border-style 0.3s;
    position: relative;
  }

  .ut-cb.checked {
    background: var(--foreground);
    border-color: var(--foreground);
    border-style: solid;
  }

  .ut-cb.checked::after {
    content: '';
    position: absolute;
    top: 1px;
    left: 2.5px;
    width: 3px;
    height: 4.5px;
    border: solid var(--background);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .ut-pri {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .ut-title {
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s, text-decoration 0.3s;
  }

  .ut-title.struck {
    text-decoration: line-through;
    color: var(--muted-foreground);
  }

  .ut-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 7px;
    color: var(--muted-foreground);
    padding: 1px 4px;
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ─── Toast ─── */

  .toast-0107 {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card, var(--background)) 90%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px -4px rgba(0,0,0,0.3);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .toast-0107.visible {
    opacity: 1;
  }

  .toast-label {
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--muted-foreground);
  }

  .toast-sep {
    font-size: 10px;
    color: var(--border);
  }

  .toast-action {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    color: var(--foreground);
    cursor: default;
  }
</style>

<script is:inline>
(function() {
  var timers = [];
  var running = false;

  function delay(ms) {
    return new Promise(function(resolve) {
      var t = setTimeout(resolve, ms);
      timers.push(t);
    });
  }

  function clearAllTimers() {
    timers.forEach(clearTimeout);
    timers = [];
  }

  // DOM refs
  var remCard = document.getElementById('rem-card-0107') || document.querySelector('.rem-card-0107');
  var utCard = document.getElementById('ut-card-0107') || document.querySelector('.ut-card-0107');
  var remItemNew = document.getElementById('rem-item-new-0107');
  var remCircleDone = document.getElementById('rem-circle-done-0107');
  var remTextDone = document.getElementById('rem-text-done-0107');
  var utItemNew = document.getElementById('ut-item-new-0107');
  var utCbDone = document.getElementById('ut-cb-done-0107');
  var utPriDone = document.getElementById('ut-pri-done-0107');
  var utTitleDone = document.getElementById('ut-title-done-0107');
  var dotLR = document.getElementById('sync-dot-lr-0107');
  var dotRL = document.getElementById('sync-dot-rl-0107');
  var toast = document.getElementById('toast-0107');
  var toastText = document.getElementById('toast-text-0107');

  function fireDot(dot, cls) {
    dot.classList.remove('animate');
    void dot.offsetWidth; // reflow
    dot.classList.add('animate');
  }

  function resetState() {
    // Cards hidden
    if (remCard) { remCard.classList.remove('visible'); }
    if (utCard) { utCard.classList.remove('visible'); }
    // New items hidden
    if (remItemNew) remItemNew.classList.remove('shown');
    if (utItemNew) utItemNew.classList.remove('shown');
    // Done states reset
    if (remCircleDone) remCircleDone.classList.remove('checked');
    if (remTextDone) remTextDone.classList.remove('struck');
    if (utCbDone) { utCbDone.classList.remove('checked'); }
    if (utPriDone) utPriDone.style.background = '#f43f5e';
    if (utTitleDone) { utTitleDone.classList.remove('struck'); }
    // Dots reset
    if (dotLR) dotLR.classList.remove('animate');
    if (dotRL) dotRL.classList.remove('animate');
    // Toast hidden
    if (toast) toast.classList.remove('visible');
  }

  async function runDemo() {
    if (!running) return;
    resetState();

    // 1. Cards slide in
    if (remCard) remCard.classList.add('visible');
    await delay(150);
    if (!running) return;
    if (utCard) utCard.classList.add('visible');
    await delay(600);
    if (!running) return;

    // 2. Complete task in Untask (right card)
    if (utCbDone) utCbDone.classList.add('checked');
    if (utPriDone) utPriDone.style.background = 'color-mix(in srgb, var(--foreground) 15%, transparent)';
    if (utTitleDone) utTitleDone.classList.add('struck');
    await delay(400);
    if (!running) return;

    // 3. Sync dot flies right → left
    if (dotRL) fireDot(dotRL, 'animate');
    await delay(650);
    if (!running) return;

    // 4. Reminders item gets checked
    if (remCircleDone) remCircleDone.classList.add('checked');
    if (remTextDone) remTextDone.classList.add('struck');
    await delay(700);
    if (!running) return;

    // 5. New task appears in Reminders (imported from elsewhere)
    if (remItemNew) remItemNew.classList.add('shown');
    await delay(500);
    if (!running) return;

    // 6. Sync dot flies left → right
    if (dotLR) fireDot(dotLR, 'animate');
    await delay(650);
    if (!running) return;

    // 7. New task appears in Untask
    if (utItemNew) utItemNew.classList.add('shown');
    await delay(500);
    if (!running) return;

    // 8. Toast pops up
    if (toastText) toastText.textContent = '3 tasks synced';
    if (toast) toast.classList.add('visible');
    await delay(2500);
    if (!running) return;

    // 9. Fade everything
    if (toast) toast.classList.remove('visible');
    await delay(300);
    if (!running) return;
    if (remCard) remCard.classList.remove('visible');
    if (utCard) utCard.classList.remove('visible');
    await delay(1500);
    if (!running) return;

    runDemo();
  }

  window.startPreview_0107 = function() {
    if (running) return;
    running = true;
    runDemo();
  };

  window.stopPreview_0107 = function() {
    running = false;
    clearAllTimers();
    resetState();
  };
})();
</script>

---
// TaskLifecyclePreview — Tasks flowing through Kanban-style status lanes
// Replaces InboxPreview. No cursor — tasks animate themselves.
// References: TasksView.tsx, SectionGroup.tsx, TaskItem.tsx
---

<section id="lifecycle-section" data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section label -->
    <div class="mb-8 flex flex-col items-center text-center">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[10px] tabular-nums text-muted-foreground/40">03</span>
        <span class="h-px w-4 border-t border-dashed border-border/60"></span>
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Start to Done</h2>
      </div>
      <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/55">
        Tasks move through status lanes as work progresses. Finish the subtasks, close the task, watch it flow to done.
      </p>
    </div>

    <!-- Window frame -->
    <div class="app-preview overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FEBC2E]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80"></span>
        </div>
        <div class="flex-1"></div>
        <nav class="flex items-center gap-0.5">
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Today</span>
          <span class="rounded-lg bg-accent px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-foreground">Tasks</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Inbox</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Notes</span>
        </nav>
      </header>

      <!-- ═══ Content area ═══ -->
      <div class="relative overflow-hidden p-3" style="min-height: 380px;">
        <div class="mx-auto flex max-w-3xl flex-col gap-3">

          <!-- ═══ SectionGroup: Backlog (expanded, 3 tasks) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">Backlog</span>
                <span id="lc-backlog-count" class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
              </div>
              <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/55">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </span>
            </div>

            <div class="border-t border-border/60 px-1 py-1">

              <!-- ═══ TaskItem 1: Finish landing page design (amber, date badge) ═══ -->
              <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                <div class="flex items-center gap-1.5">
                  <span class="inline-flex size-6 items-center justify-center">
                    <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </span>
                  <span class="size-[5px] rounded-full bg-amber-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] text-foreground transition-all duration-300">Finish landing page design</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">Feb 18</span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

              <!-- ═══ TaskItem 2: Prepare client presentation (animated row) ═══ -->
              <div id="lc-task-animate" class="overflow-hidden border-b border-border/40" style="max-height: 40px; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease-out;">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span id="lc-checkbox" class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                        <svg id="lc-check" class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span id="lc-dot" class="size-[5px] rounded-full bg-amber-500 transition-colors duration-300"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p id="lc-title" class="truncate text-[13px] text-foreground transition-all duration-300">Prepare client presentation</p>
                  </div>
                  <div class="ml-auto flex items-center gap-1">
                    <span id="lc-subtask-badge" class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">1/3</span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- ═══ TaskItem 3: Write project brief (rose, no date) ═══ -->
              <div class="flex min-h-10 items-center gap-2 px-1.5">
                <div class="flex items-center gap-1.5">
                  <span class="inline-flex size-6 items-center justify-center">
                    <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </span>
                  <span class="size-[5px] rounded-full bg-rose-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] text-foreground transition-all duration-300">Write project brief</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- ═══ SectionGroup: In Progress (expanded, 1 task) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">In Progress</span>
                <span class="ml-auto font-mono text-[11px] text-muted-foreground">1</span>
              </div>
              <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/55">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </span>
            </div>

            <div class="border-t border-border/60 px-1 py-1">
              <div class="flex min-h-10 items-center gap-2 px-1.5">
                <div class="flex items-center gap-1.5">
                  <span class="inline-flex size-6 items-center justify-center">
                    <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </span>
                  <span class="size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] text-foreground transition-all duration-300">Review feedback from Alex</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">1/3</span>
                  <span class="inline-flex size-6 items-center justify-center text-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- ═══ SectionGroup: Done (collapsed) ═══ -->
          <section id="lc-done-section" class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">Done</span>
                <span id="lc-done-count" class="ml-auto font-mono text-[11px] text-muted-foreground">5</span>
              </div>
            </div>
          </section>

        </div>

        <!-- ═══ Bottom bar ═══ -->
        <div class="mt-3 flex items-center gap-2">
          <div class="flex shrink-0 items-center gap-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
            <span class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.293 2.293a1 1 0 0 1 1.414 0l2.5 2.5 5.994 1.227a1 1 0 0 1 .506 1.687l-7 7a1 1 0 0 1-1.687-.506l-1.227-5.994-2.5-2.5a1 1 0 0 1 0-1.414z" />
                <path d="m14.207 4.793-3.414 3.414" />
                <path d="M3 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                <path d="m9.086 6.5-4.793 4.793a1 1 0 0 0-.18 1.17L7 18" />
              </svg>
            </span>
          </div>
          <div class="flex-1"></div>
          <div class="flex h-8 w-14 items-center justify-center rounded-md border border-border/60 bg-background/90 text-[10px] font-medium tracking-wide text-muted-foreground shadow-lg backdrop-blur-sm">
            Chat
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── Badge pulse ─── */

  @keyframes lc-badge-pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  .lc-badge-pulse {
    animation: lc-badge-pulse 250ms ease-out;
  }

  /* ─── Task glow (matches ChatPreview task-glow) ─── */

  @keyframes lc-task-glow {
    0%   { background-color: color-mix(in srgb, var(--foreground) 4%, transparent); }
    100% { background-color: transparent; }
  }

  .lc-task-highlight {
    animation: lc-task-glow 2s ease-out;
  }
</style>

<script is:inline>
var lcTimers = [];
var lcPaused = false;

function lcDelay(fn, ms) {
  var t = setTimeout(fn, ms);
  lcTimers.push(t);
  return t;
}

function lcClearTimers() {
  for (var i = 0; i < lcTimers.length; i++) clearTimeout(lcTimers[i]);
  lcTimers = [];
}

function lcReset() {
  var taskRow = document.getElementById('lc-task-animate');
  var checkbox = document.getElementById('lc-checkbox');
  var check = document.getElementById('lc-check');
  var dot = document.getElementById('lc-dot');
  var title = document.getElementById('lc-title');
  var badge = document.getElementById('lc-subtask-badge');
  var backlogCount = document.getElementById('lc-backlog-count');
  var doneCount = document.getElementById('lc-done-count');
  var doneSection = document.getElementById('lc-done-section');

  if (taskRow) {
    taskRow.style.maxHeight = '40px';
    taskRow.style.opacity = '1';
  }
  if (checkbox) {
    checkbox.style.borderStyle = 'dashed';
    checkbox.style.borderColor = 'var(--foreground-muted, rgba(245,245,245,0.35))';
    checkbox.style.backgroundColor = 'transparent';
  }
  if (check) { check.style.opacity = '0'; }
  if (dot) { dot.style.backgroundColor = ''; }
  if (title) {
    title.style.textDecoration = '';
    title.style.color = '';
  }
  if (badge) {
    badge.textContent = '1/3';
    badge.classList.remove('lc-badge-pulse');
  }
  if (backlogCount) backlogCount.textContent = '3';
  if (doneCount) doneCount.textContent = '5';
  if (doneSection) doneSection.classList.remove('lc-task-highlight');
}

function runLcDemo() {
  if (lcPaused) return;

  var badge = document.getElementById('lc-subtask-badge');
  var checkbox = document.getElementById('lc-checkbox');
  var check = document.getElementById('lc-check');
  var dot = document.getElementById('lc-dot');
  var title = document.getElementById('lc-title');
  var taskRow = document.getElementById('lc-task-animate');
  var backlogCount = document.getElementById('lc-backlog-count');
  var doneCount = document.getElementById('lc-done-count');
  var doneSection = document.getElementById('lc-done-section');

  if (!badge || !checkbox || !taskRow) return;

  // Step 1: Subtask counter ticks 1/3 → 2/3
  lcDelay(function() {
    if (lcPaused) return;
    badge.textContent = '2/3';
    badge.classList.remove('lc-badge-pulse');
    void badge.offsetWidth;
    badge.classList.add('lc-badge-pulse');

    // Step 2: Subtask counter ticks 2/3 → 3/3
    lcDelay(function() {
      if (lcPaused) return;
      badge.textContent = '3/3';
      badge.classList.remove('lc-badge-pulse');
      void badge.offsetWidth;
      badge.classList.add('lc-badge-pulse');

      // Step 3: Task completes — checkbox fills, strikethrough, dot mutes
      lcDelay(function() {
        if (lcPaused) return;

        // Checkbox fill (matches AppPreview toggleTask pattern)
        checkbox.style.borderStyle = 'solid';
        checkbox.style.borderColor = 'var(--foreground)';
        checkbox.style.backgroundColor = 'var(--foreground)';
        check.style.opacity = '1';

        // Title strikethrough + muted
        title.style.textDecoration = 'line-through';
        title.style.color = 'var(--muted-foreground)';

        // Priority dot mutes
        dot.style.backgroundColor = 'color-mix(in srgb, var(--foreground) 15%, transparent)';

        // Step 4: Task row slides out, counts update
        lcDelay(function() {
          if (lcPaused) return;

          taskRow.style.maxHeight = '0';
          taskRow.style.opacity = '0';

          // Update backlog count
          if (backlogCount) backlogCount.textContent = '2';

          // After slide-out completes, update Done count with glow
          lcDelay(function() {
            if (lcPaused) return;
            if (doneCount) doneCount.textContent = '6';

            // Glow the Done section border
            if (doneSection) {
              doneSection.classList.remove('lc-task-highlight');
              void doneSection.offsetWidth;
              doneSection.classList.add('lc-task-highlight');
            }

            // Hold for viewing, then reset and loop
            lcDelay(function() {
              if (lcPaused) return;
              lcReset();
              lcDelay(function() {
                if (!lcPaused) runLcDemo();
              }, 2000);
            }, 3000);
          }, 500);
        }, 700);
      }, 1000);
    }, 1000);
  }, 1500);
}

function startLcAutoPlay() {
  lcPaused = false;
  lcDelay(runLcDemo, 1500);
}

function stopLcAutoPlay() {
  lcPaused = true;
  lcClearTimers();
  lcReset();
}

window.startLcAutoPlay = startLcAutoPlay;
window.stopLcAutoPlay = stopLcAutoPlay;
</script>

---
// Why Untask — 2x2 grid of dashed-border cards (matches Features pattern)
import SectionLabel from './SectionLabel.astro';

interface Props {
  sectionNumber: string;
  sectionHeading: string;
  sectionDescription: string;
  principles: Array<{ label: string; description: string }>;
}

const { sectionNumber, sectionHeading, sectionDescription, principles } = Astro.props;
---

<section data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section header -->
    <SectionLabel number={sectionNumber} heading={sectionHeading} description={sectionDescription} />

    <!-- 2x2 + 1 grid of cards -->
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {principles.map((p, i) => (
        <div class={`rounded-md border border-dashed border-border/60 px-3 py-3${i === principles.length - 1 && principles.length % 2 !== 0 ? ' sm:col-span-2' : ''}`}>
          <h3 class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-foreground">
            {p.label}
          </h3>
          <p class="mt-2 text-[12px] leading-relaxed text-muted-foreground">
            {p.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

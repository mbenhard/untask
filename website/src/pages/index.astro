---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AppPreview from '../components/AppPreview.astro';
import ChatPreview from '../components/ChatPreview.astro';
import InboxPreview from '../components/InboxPreview.astro';
import NotesPreview from '../components/NotesPreview.astro';

import RemindersSyncCallout from '../components/RemindersSyncCallout.astro';
import Download from '../components/Download.astro';
import TechStack from '../components/TechStack.astro';
import Philosophy from '../components/Philosophy.astro';
import KeyboardPreview from '../components/KeyboardPreview.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <main>
    <div class="sections-wrap">
      <Hero />
      <AppPreview />
      <InboxPreview />
      <RemindersSyncCallout />
      <NotesPreview />
      <ChatPreview />
      <KeyboardPreview />
      <Philosophy />
      <TechStack />
      <Download />
    </div>
    <Footer />
  </main>

  <!-- Auto-play coordination: start/stop animations based on viewport visibility -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var sections = {
        'ap-section': {
          start: function () {
            if (typeof startApAutoPlay === 'function') startApAutoPlay();
          },
          stop: function () {
            if (typeof stopApAutoPlay === 'function') stopApAutoPlay();
          },
        },
        'inbox-section': {
          start: function () {
            if (typeof startInboxAutoPlay === 'function') startInboxAutoPlay();
          },
          stop: function () {
            if (typeof stopInboxAutoPlay === 'function') stopInboxAutoPlay();
          },
        },
        'notes-section': {
          start: function () {
            if (typeof startNotesAutoPlay === 'function') startNotesAutoPlay();
          },
          stop: function () {
            if (typeof stopNotesAutoPlay === 'function') stopNotesAutoPlay();
          },
        },
        'chat-section': {
          start: function () {
            if (typeof startChatAutoPlay === 'function') startChatAutoPlay();
          },
          stop: function () {
            if (typeof stopChatAutoPlay === 'function') stopChatAutoPlay();
          },
        },
        'kb-section': {
          start: function () {
            if (typeof startKbAutoPlay === 'function') startKbAutoPlay();
          },
          stop: function () {
            if (typeof stopKbAutoPlay === 'function') stopKbAutoPlay();
          },
        },
      };

      var active = {};
      var stopTimers = {};

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var id = entry.target.id;
            var cfg = sections[id];
            if (!cfg) return;
            if (entry.isIntersecting) {
              // Cancel any pending stop — section re-entered viewport
              if (stopTimers[id]) {
                clearTimeout(stopTimers[id]);
                stopTimers[id] = null;
              }
              if (!active[id]) {
                active[id] = true;
                cfg.start();
              }
            } else if (active[id]) {
              // Debounce stop to avoid oscillation from height-changing animations
              if (!stopTimers[id]) {
                stopTimers[id] = setTimeout(function () {
                  active[id] = false;
                  cfg.stop();
                  stopTimers[id] = null;
                  // Recalculate thread mask after height reset
                  if (typeof window.computeThreadMask === 'function') {
                    requestAnimationFrame(window.computeThreadMask);
                  }
                }, 1200);
              }
            }
          });
        },
        { threshold: 0.1, rootMargin: '200px 0px' }
      );

      Object.keys(sections).forEach(function (id) {
        var el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    });
  </script>

  <!-- Thread fade: line is only visible BETWEEN content sections, invisible through them -->
  <script is:inline>
    (function () {
      var FADE = 80;  // px for each fade-in / fade-out transition at content edges

      function computeThreadMask() {
        var wrap = document.querySelector('.sections-wrap');
        if (!wrap) return;
        var panels = wrap.querySelectorAll('[data-thread-content]');
        if (!panels.length) return;

        var wrapRect = wrap.getBoundingClientRect();
        var wrapTop = wrapRect.top + window.scrollY;
        var totalH = wrap.scrollHeight;
        if (totalH <= 0) return;

        // Collect content zones relative to .sections-wrap
        var zones = [];
        for (var i = 0; i < panels.length; i++) {
          var r = panels[i].getBoundingClientRect();
          var top = r.top + window.scrollY - wrapTop;
          var bot = r.bottom + window.scrollY - wrapTop;
          zones.push({ top: top, bottom: bot });
        }
        zones.sort(function (a, b) { return a.top - b.top; });

        // Merge overlapping/adjacent zones (content zones that touch or overlap)
        var merged = [zones[0]];
        for (var i = 1; i < zones.length; i++) {
          var prev = merged[merged.length - 1];
          if (zones[i].top <= prev.bottom) {
            prev.bottom = Math.max(prev.bottom, zones[i].bottom);
          } else {
            merged.push(zones[i]);
          }
        }

        // Build mask: transparent through content, visible only in gaps between
        //
        // Structure per gap between zone[i] and zone[i+1]:
        //   transparent ... zone[i].bottom
        //   → fade in over FADE px
        //   black (visible) in the middle of the gap
        //   → fade out over FADE px
        //   transparent ... zone[i+1].top
        //
        // First zone starts transparent, last zone ends transparent.

        var stops = [];
        // Start: invisible at top, through first content zone
        stops.push('transparent 0px');
        stops.push('transparent ' + merged[0].bottom + 'px');

        for (var i = 0; i < merged.length - 1; i++) {
          var gapStart = merged[i].bottom;       // where previous content ends
          var gapEnd = merged[i + 1].top;         // where next content starts
          var gapSize = gapEnd - gapStart;

          // Fade distance clamped to half the gap so fades don't overlap
          var f = Math.min(FADE, gapSize / 2);

          // Fade in: transparent → black after content ends
          stops.push('black ' + (gapStart + f) + 'px');

          // Fade out: black → transparent before next content starts
          stops.push('black ' + (gapEnd - f) + 'px');
          stops.push('transparent ' + gapEnd + 'px');

          // Stay transparent through the next content zone
          stops.push('transparent ' + merged[i + 1].bottom + 'px');
        }

        // End: already transparent through last content zone, stay transparent
        stops.push('transparent ' + totalH + 'px');

        var mask = 'linear-gradient(to bottom, ' + stops.join(', ') + ')';
        wrap.style.setProperty('--thread-mask', mask);
      }

      function init() {
        computeThreadMask();
        var timer;
        window.addEventListener('resize', function () {
          clearTimeout(timer);
          timer = setTimeout(computeThreadMask, 150);
        });
        window.addEventListener('load', computeThreadMask);
      }

      // Expose for auto-play observer to recalculate after resets
      window.computeThreadMask = computeThreadMask;

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Changelog — Untask">
  <main>
    <section class="flex min-h-[50vh] flex-col items-center justify-center px-6 pt-16 pb-8">
      <div class="flex max-w-lg flex-col items-center text-center">
        
        <div class="mascot mb-8" role="button" tabindex="0" aria-label="Click me!" onclick="birdBounce(this)" onkeydown="if(event.key==='Enter')birdBounce(this)">
          <div class="mascot-body">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.89 166.04">
              <path fill="currentColor" d="M120.39,36.58c1.07-.22,1.56-.39,2.49-1.01-15.26-5.36-30.9-9.88-46.49-14.2C75.08,3.55,51.53-5.85,37.12,3.96c-13.89,9.55-12.2,28.04-16.23,42.7-5.67,28.52-11.32,57.04-17,85.55-3.1,15.47-11.57,36.65,13.69,33.52,16.92-.48,33.84-1.07,50.75-1.85,22.47-.89,39.64,3.24,30.44-26.67-6.31-30.86-12.58-61.72-18.81-92.6,13.56-2.23,26.95-5.41,40.44-8.03ZM59.02,23.22c-.01,9.92-15.48,8.5-13.45-1.25,1.54-7.53,13.49-6.61,13.45,1.25Z"/>
            </svg>
          </div>
          <div class="mascot-feet">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40.72 50.38">
              <path fill="currentColor" d="M1.94,47.87c.23-.13.45-.26.69-.4.41-.22.83-.44,1.25-.65,0-.23,0-.46,0-.7.03-5.6.07-11.19.11-16.79.02-2.71.04-5.41.05-8.12.01-2.36.03-4.72.05-7.08,0-1.25.02-2.5.02-3.75,0-1.18.01-2.35.02-3.53,0-.64,0-1.27.01-1.91,0-.38,0-.76,0-1.15,0-.33,0-.66,0-1q.02-.94.37-2.15c1.17,0,2.34,0,3.55,0,.26,5.66.39,11.31.42,16.98,0,.82.01,1.64.02,2.46.02,1.91.03,3.83.04,5.74.02,2.19.03,4.37.05,6.56.04,4.48.07,8.97.1,13.45,1.37-.27,2.73-.56,4.1-.85.39-.08.77-.15,1.17-.23q3.2-.7,4.14-1.86c.2-.31.4-.62.6-.94q1.22-.75,2.58-.97c0-.37,0-.74,0-1.13,0-3.55-.01-7.1-.01-10.65,0-1.82,0-3.65,0-5.47q-.04-9.78.17-19.55.02-.55.04-1.1,0-1.6.47-3.09,1.64-.04,3.23.32c.4.8.36,1.32.36,2.21,0,.33,0,.66,0,1,0,.36,0,.73,0,1.1,0,.38,0,.76,0,1.15,0,1.05,0,2.09,0,3.14,0,1.09,0,2.19,0,3.28,0,2.07,0,4.14,0,6.21,0,2.36,0,4.71,0,7.07,0,4.85,0,9.7-.02,14.55.28-.07.55-.14.83-.22,1.02-.27,2.05-.53,3.08-.78.44-.11.89-.23,1.33-.34.64-.17 1.28-.33 1.92-.49.38-.1.77-.2 1.16-.3,1.14-.15 1.66-.05 2.66.51q.59.81.97 1.61c-1.59.57-3.19.95-4.84 1.29q.56.02 1.13.04c.5.02.99.04 1.49.06.25 0 .49.01.74.02,1.57.07 2.7.3 4.06 1.17q.74.91.65 1.94-10.55.16-21.31.32c.21.43.43.85.65 1.29-1.18.41-2.32.75-3.55.97.96.32 1.7.39 2.7.44,1.37.12 2.37.22 3.43 1.17.21.53.43 1.07.65 1.61-7.67,0-15.34,0-23.24,0q.63-1.66 1.94-2.5Z"/>
            </svg>
          </div>
          <div class="mascot-shadow"></div>
        </div>

        <h1 class="font-sans text-3xl font-normal tracking-tight text-foreground sm:text-4xl">
          Changelog
        </h1>

        <p class="mt-3 max-w-sm text-[14px] leading-relaxed text-muted-foreground">
          What's new in Untask. All releases, all the time.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
          >
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Home
          </a>
          <a
            href="https://github.com/mbenhard/untask/releases"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
          >
            GitHub Releases
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="px-6 pb-24 sm:pb-32">
      <div class="mx-auto max-w-2xl">
        
        <div id="releases-container">
          <div class="flex items-center justify-center py-12">
            <div class="h-5 w-5 animate-spin rounded-full border-2 border-border border-t-muted-foreground"></div>
          </div>
        </div>

      </div>
    </section>

    <Footer />
  </main>
</Base>

<style>
  .mascot {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .mascot.bounce .mascot-body {
    animation: bird-snap 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes bird-snap {
    0%   { transform: translateY(0) scaleX(1) scaleY(1); }
    8%   { transform: translateY(0.8px) scaleX(1.06) scaleY(0.94); }
    30%  { transform: translateY(-5.3px) scaleX(0.94) scaleY(1.06); }
    52%  { transform: translateY(0.8px) scaleX(1.04) scaleY(0.96); }
    68%  { transform: translateY(-1.1px) scaleX(0.98) scaleY(1.02); }
    82%  { transform: translateY(0.2px) scaleX(1.01) scaleY(0.99); }
    100% { transform: translateY(0) scaleX(1) scaleY(1); }
  }

  .mascot-body {
    width: 36px;
    position: relative;
    z-index: 2;
    transform-origin: center bottom;
    margin-bottom: -4px;
    animation: wobble-body 1.2s ease-in-out infinite;
  }

  .mascot-body svg,
  .mascot-feet svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .mascot-feet {
    width: 12px;
    position: relative;
    z-index: 1;
  }

  .mascot-shadow {
    width: 14px;
    height: 3px;
    background: radial-gradient(ellipse, rgba(255,255,255,0.08) 0%, transparent 70%);
    border-radius: 50%;
    margin-top: 1px;
    animation: wobble-shadow 1.2s ease-in-out infinite;
  }

  :root .mascot-shadow {
    background: radial-gradient(ellipse, rgba(0,0,0,0.12) 0%, transparent 70%);
  }

  .mascot.bounce .mascot-shadow {
    animation: bird-snap-shadow 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes bird-snap-shadow {
    0%   { transform: scaleX(1); opacity: 0.35; }
    8%   { transform: scaleX(0.8); opacity: 0.55; }
    30%  { transform: scaleX(1.5); opacity: 0.08; }
    52%  { transform: scaleX(0.85); opacity: 0.5; }
    68%  { transform: scaleX(1.1); opacity: 0.25; }
    82%  { transform: scaleX(0.95); opacity: 0.38; }
    100% { transform: scaleX(1); opacity: 0.35; }
  }

  @keyframes wobble-body {
    0%   { transform: translateY(0) rotate(0deg); }
    25%  { transform: translateY(-3.5px) rotate(2.5deg); }
    50%  { transform: translateY(0) rotate(0deg); }
    75%  { transform: translateY(-3.5px) rotate(-2.5deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  @keyframes wobble-shadow {
    0%   { transform: scaleX(1) translateX(0); opacity: 0.35; }
    25%  { transform: scaleX(1.15) translateX(0.5px); opacity: 0.18; }
    50%  { transform: scaleX(1) translateX(0); opacity: 0.35; }
    75%  { transform: scaleX(1.15) translateX(-0.5px); opacity: 0.18; }
    100% { transform: scaleX(1) translateX(0); opacity: 0.35; }
  }

  .release-card {
    border-radius: 0.375rem;
    border: 1px dashed var(--border);
    opacity: 0.6;
    padding: 0.75rem;
    transition: opacity 0.2s;
  }

  .release-card:hover {
    opacity: 1;
  }

  .release-body ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }

  .release-body li {
    margin: 0.25rem 0;
  }

  .release-body p {
    margin: 0.5rem 0;
  }

  .release-body code {
    background: var(--accent);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }
</style>

<script is:inline>
  function birdBounce(el) {
    if (el.classList.contains('bounce')) return;
    el.classList.add('bounce');
    el.addEventListener('animationend', function handler() {
      el.classList.remove('bounce');
      el.removeEventListener('animationend', handler);
    }, { once: false });
    setTimeout(function() { el.classList.remove('bounce'); }, 1100);
  }

  (function() {
    var CACHE_KEY = 'untask-releases-cache';
    var CACHE_TTL = 24 * 60 * 60 * 1000; // 24 hours
    var API_URL = 'https://api.github.com/repos/mbenhard/untask/releases';

    function formatDate(dateString) {
      var date = new Date(dateString);
      return date.toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      });
    }

    function truncateBody(body, maxLength) {
      if (!body) return '';
      var stripped = body.replace(/## What's Changed[\s\S]*/i, '').trim();
      if (stripped.length <= maxLength) return stripped;
      return stripped.substring(0, maxLength).trim() + '...';
    }

    function parseMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/`(.+?)`/g, '<code>$1</code>')
        .replace(/^- (.+)$/gm, '<li>$1</li>')
        .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
        .replace(/\n\n/g, '</p><p>')
        .replace(/\n/g, '<br/>')
        .replace(/^(.+)$/, '<p>$1</p>');
    }

    function renderReleases(releases) {
      var container = document.getElementById('releases-container');
      var html = '<div class="space-y-3">';

      releases.slice(0, 10).forEach(function(release) {
        var version = release.tag_name;
        var date = formatDate(release.published_at);
        var body = truncateBody(release.body, 300);
        var parsedBody = parseMarkdown(body);
        var url = release.html_url;

        html += '<div class="release-card">';
        html += '<div class="flex items-center justify-between">';
        html += '<h3 class="font-mono text-[12px] font-semibold text-foreground">' + version + '</h3>';
        html += '<span class="font-mono text-[10px] text-muted-foreground/60">' + date + '</span>';
        html += '</div>';
        if (parsedBody) {
          html += '<div class="release-body mt-2 text-[12px] leading-relaxed text-muted-foreground">' + parsedBody + '</div>';
        }
        html += '<a href="' + url + '" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-[0.06em] text-muted-foreground/60 transition-colors hover:text-muted-foreground">';
        html += 'View on GitHub';
        html += '<svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>';
        html += '</a>';
        html += '</div>';
      });

      html += '</div>';
      container.innerHTML = html;
    }

    function renderError() {
      var container = document.getElementById('releases-container');
      container.innerHTML = '<div class="text-center py-12">' +
        '<p class="text-muted-foreground text-[14px]">Unable to load releases.</p>' +
        '<a href="https://github.com/mbenhard/untask/releases" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground">' +
        'View on GitHub' +
        '<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
        '</a></div>';
    }

    function getCache() {
      try {
        var cached = localStorage.getItem(CACHE_KEY);
        if (!cached) return null;
        var data = JSON.parse(cached);
        if (Date.now() - data.timestamp > CACHE_TTL) {
          localStorage.removeItem(CACHE_KEY);
          return null;
        }
        return data.releases;
      } catch (e) {
        return null;
      }
    }

    function setCache(releases) {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({
          timestamp: Date.now(),
          releases: releases
        }));
      } catch (e) {}
    }

    function fetchReleases() {
      var cached = getCache();
      if (cached) {
        renderReleases(cached);
        return;
      }

      fetch(API_URL + '?per_page=10')
        .then(function(res) {
          if (!res.ok) throw new Error('Failed to fetch');
          return res.json();
        })
        .then(function(releases) {
          setCache(releases);
          renderReleases(releases);
        })
        .catch(function(err) {
          console.error('Failed to fetch releases:', err);
          renderError();
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fetchReleases);
    } else {
      fetchReleases();
    }
  })();
</script>

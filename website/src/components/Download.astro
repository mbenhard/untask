---
// Download section — industrial sleek CTA
---

<section id="download" class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-md">

    <!-- Card -->
    <div class="relative overflow-hidden rounded-lg border border-dashed border-border/60 px-8 py-10">

      <!-- Corner marks -->
      <div class="absolute top-0 left-0 h-3 w-3 border-t border-l border-border/40"></div>
      <div class="absolute top-0 right-0 h-3 w-3 border-t border-r border-border/40"></div>
      <div class="absolute bottom-0 left-0 h-3 w-3 border-b border-l border-border/40"></div>
      <div class="absolute bottom-0 right-0 h-3 w-3 border-b border-r border-border/40"></div>

      <div class="flex flex-col items-center text-center">

        <!-- App icon -->
        <img
          src="/icon-app.png"
          alt="Untask"
          width="56"
          height="56"
          class="rounded-xl"
          draggable="false"
        />

        <!-- Label -->
        <h2 class="mt-5 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted-foreground/60">
          Download
        </h2>

        <!-- Name -->
        <p class="mt-2 text-lg font-normal tracking-tight text-foreground">
          Untask
        </p>

        <!-- Subtitle -->
        <p class="mt-1.5 text-[13px] text-muted-foreground/70">
          Free, open source, runs on your Mac.
        </p>

        <!-- Buttons -->
        <div class="mt-6 flex items-center gap-2">
          <a
            href="https://github.com/mbenhard/untask/releases/latest"
            class="inline-flex h-7 items-center rounded-md bg-primary px-3.5 text-[11px] font-medium text-primary-foreground transition-opacity hover:opacity-80"
          >
            Download for macOS
          </a>
          <a
            href="https://github.com/mbenhard/untask"
            class="inline-flex h-7 items-center rounded-md border border-dashed border-border/60 px-3.5 text-[11px] font-medium text-muted-foreground transition-colors hover:border-border hover:text-foreground"
          >
            GitHub
          </a>
        </div>

        <!-- Divider -->
        <div class="mt-5 h-px w-12 border-t border-dashed border-border/40"></div>

        <!-- Brew command -->
        <button
          onclick="copyBrewInstall(this)"
          class="group mt-4 inline-flex h-6 cursor-pointer items-center gap-1.5 rounded border border-dashed border-border/40 px-2.5 font-mono text-[10px] text-muted-foreground/50 transition-colors hover:border-border/60 hover:text-muted-foreground"
          aria-label="Copy install command"
        >
          <span>brew install mbenhard/untask/untask</span>
          <svg class="copy-icon size-2.5 shrink-0 opacity-30 transition-opacity group-hover:opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
          <svg class="copy-check hidden size-2.5 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>

        <!-- License -->
        <p class="mt-3 font-mono text-[9px] uppercase tracking-[0.1em] text-muted-foreground/30">
          MIT Licensed &middot; macOS only
        </p>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  function copyBrewInstall(btn) {
    navigator.clipboard.writeText('brew install mbenhard/untask/untask').then(function() {
      var copyIcon = btn.querySelector('.copy-icon');
      var checkIcon = btn.querySelector('.copy-check');
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(function() {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 1500);
    });
  }
</script>

---
// RemindersSyncCallout — unnumbered callout strip showing two-way sync with Apple Reminders
---

<section data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section label -->
    <div class="mb-10 flex flex-col items-center text-center">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[10px] tabular-nums text-muted-foreground/25">02</span>
        <span class="h-px w-4 border-t border-dashed border-border/60"></span>
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Lives in Apple Reminders Too</h2>
      </div>
      <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/40">
        Two-way sync with macOS Reminders. Add tasks from Siri, Shortcuts, or any app that talks to Reminders. They show up here.
      </p>
    </div>

    <!-- Icons with sync indicator -->
    <div class="flex items-center justify-center gap-0">

      <!-- Untask icon -->
      <img src="/icon-app.png" alt="Untask" width="72" height="72" class="relative z-10 rounded-[16px]" draggable="false" />

      <!-- Sync tracks -->
      <div class="sync-track relative mx-1 h-10 w-20 sm:w-28">
        <!-- Top track: left → right -->
        <div class="absolute top-2 left-0 h-px w-full overflow-hidden">
          <span class="dot-lr absolute top-0 left-0 h-[3px] w-[3px] -translate-y-[1px] rounded-full bg-muted-foreground/50"></span>
          <span class="absolute inset-0 border-t border-dashed border-muted-foreground/10"></span>
        </div>
        <!-- Bottom track: right → left -->
        <div class="absolute bottom-2 left-0 h-px w-full overflow-hidden">
          <span class="dot-rl absolute top-0 right-0 h-[3px] w-[3px] -translate-y-[1px] rounded-full bg-muted-foreground/50"></span>
          <span class="absolute inset-0 border-t border-dashed border-muted-foreground/10"></span>
        </div>
        <!-- Center label -->
        <span class="absolute inset-0 flex items-center justify-center font-mono text-[8px] uppercase tracking-[0.12em] text-muted-foreground/15">sync</span>
      </div>

      <!-- Reminders icon -->
      <img src="/reminders.png" alt="Apple Reminders" width="72" height="72" class="relative z-10 rounded-[16px]" draggable="false" />

    </div>

  </div>
</section>

<style>
  @keyframes travel-lr {
    0%   { left: -3px; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  @keyframes travel-rl {
    0%   { right: -3px; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { right: 100%; opacity: 0; }
  }

  .dot-lr {
    animation: travel-lr 2.4s ease-in-out infinite;
  }

  .dot-rl {
    animation: travel-rl 2.4s ease-in-out infinite;
    animation-delay: 1.2s;
  }
</style>

---
// v0.1.9 "Search Panorama" — AI & Search release preview
// Tilted search popup over dimmed task list showing task + note results
---

<div class="preview-0109" data-changelog-preview="0109">
  <div class="preview-0109-stage">

    <!-- Background: dimmed task list -->
    <div class="preview-0109-bg">
      <div class="bg-row-0109">
        <span class="bg-cb-0109"></span>
        <span class="bg-pri-0109" style="background:#f59e0b"></span>
        <span class="bg-line-0109" style="width:65%"></span>
        <span class="bg-badge-0109">Feb 18</span>
      </div>
      <div class="bg-row-0109">
        <span class="bg-cb-0109"></span>
        <span class="bg-pri-0109" style="background:#f43f5e"></span>
        <span class="bg-line-0109" style="width:50%"></span>
        <span id="bg-body-dot-0109" class="bg-body-dot-0109"></span>
        <span class="bg-badge-0109">1/3</span>
      </div>
      <div class="bg-row-0109">
        <span class="bg-cb-0109 bg-cb-done-0109"></span>
        <span class="bg-pri-0109" style="background:color-mix(in srgb, var(--foreground) 15%, transparent)"></span>
        <span class="bg-line-0109 bg-line-done-0109" style="width:40%"></span>
      </div>
      <div class="bg-row-0109">
        <span class="bg-cb-0109"></span>
        <span class="bg-pri-0109" style="background:color-mix(in srgb, var(--foreground) 15%, transparent)"></span>
        <span class="bg-line-0109" style="width:58%"></span>
        <span class="bg-badge-0109">tomorrow</span>
      </div>
    </div>

    <!-- Hero: Search popup (tilted) -->
    <div class="preview-0109-search-wrap">
      <div id="search-popup-0109" class="search-popup-0109">
        <!-- Search input -->
        <div class="search-input-0109">
          <svg class="search-icon-0109" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <div class="search-input-wrap-0109">
            <span id="search-text-0109" class="search-typed-0109"></span>
            <span id="search-caret-0109" class="search-caret-0109"></span>
            <span id="search-ph-0109" class="search-ph-0109">Search tasks and notes...</span>
          </div>
          <kbd class="search-kbd-0109">esc</kbd>
        </div>

        <!-- Results area -->
        <div class="search-results-0109">
          <!-- Tasks section -->
          <div id="search-tasks-header-0109" class="search-section-header-0109">Tasks</div>
          <div id="search-result-1-0109" class="search-result-item-0109">
            <span class="sr-cb-0109"></span>
            <span class="sr-pri-0109" style="background:#f59e0b"></span>
            <span class="sr-title-0109">Q3 <mark>project plan</mark> draft</span>
            <span class="sr-badge-0109">today</span>
          </div>
          <div id="search-result-2-0109" class="search-result-item-0109">
            <span class="sr-cb-0109"></span>
            <span class="sr-pri-0109" style="background:color-mix(in srgb, var(--foreground) 15%, transparent)"></span>
            <span class="sr-title-0109">Update <mark>project plan</mark></span>
            <span class="sr-body-dot-0109"></span>
            <span class="sr-badge-0109">Feb 20</span>
          </div>

          <!-- Divider -->
          <div id="search-divider-0109" class="search-divider-0109">
            <div class="search-divider-line-0109"></div>
          </div>

          <!-- Notes section (new!) -->
          <div id="search-notes-header-0109" class="search-section-header-0109">
            Notes
            <span class="search-new-badge-0109">new</span>
          </div>
          <div id="search-result-note-0109" class="search-result-item-0109 search-result-note">
            <svg class="sr-note-icon-0109" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
            </svg>
            <span class="sr-title-0109"><mark>Project</mark> Planning Notes</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .preview-0109 {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.5rem;
  }

  .preview-0109-stage {
    width: 100%;
    height: 100%;
    position: relative;
    background: color-mix(in srgb, var(--background) 85%, black);
    perspective: 900px;
  }

  /* ─── Background task list ─── */

  .preview-0109-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 75%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.5s;
  }

  .preview-0109-bg.visible {
    opacity: 0.2;
  }

  .bg-row-0109 {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 8px;
  }

  .bg-cb-0109 {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--foreground) 30%, transparent);
    flex-shrink: 0;
  }

  .bg-cb-done-0109 {
    border-style: solid;
    border-color: var(--foreground);
    background: var(--foreground);
  }

  .bg-pri-0109 {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bg-line-0109 {
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--foreground) 25%, transparent);
  }

  .bg-line-done-0109 {
    opacity: 0.4;
  }

  .bg-badge-0109 {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 7px;
    color: var(--muted-foreground);
    padding: 1px 4px;
    border: 1px solid var(--border);
    border-radius: 3px;
    white-space: nowrap;
  }

  .bg-body-dot-0109 {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
    flex-shrink: 0;
    transition: transform 0.3s;
  }

  .bg-body-dot-0109.pulse {
    animation: dot-pulse-0109 0.6s ease-out;
  }

  @keyframes dot-pulse-0109 {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(2); opacity: 0.6; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ─── Search popup ─── */

  .preview-0109-search-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(240px, 65%, 400px);
    z-index: 5;
  }

  .search-popup-0109 {
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card, var(--background)) 95%, transparent);
    backdrop-filter: blur(12px);
    box-shadow:
      0 0 60px -15px rgba(255,255,255,0.03),
      0 20px 50px -15px rgba(0,0,0,0.5);
    overflow: hidden;
    opacity: 0;
    transform: perspective(900px) rotateY(-3deg) rotateX(1deg) translateY(-15px);
    transition: opacity 0.3s ease, transform 0.35s ease;
  }

  .search-popup-0109.visible {
    opacity: 1;
    transform: perspective(900px) rotateY(-3deg) rotateX(1deg) translateY(0);
  }

  /* ─── Search input ─── */

  .search-input-0109 {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .search-icon-0109 {
    width: 14px;
    height: 14px;
    color: var(--muted-foreground);
    flex-shrink: 0;
    opacity: 0.5;
  }

  .search-input-wrap-0109 {
    flex: 1;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-typed-0109 {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--foreground);
    white-space: nowrap;
  }

  .search-caret-0109 {
    display: inline-block;
    width: 1.5px;
    height: 13px;
    background: var(--foreground);
    margin-left: 0.5px;
    opacity: 0;
    vertical-align: middle;
  }

  .search-caret-0109.blinking {
    animation: caret-blink-0109 1s step-end infinite;
  }

  @keyframes caret-blink-0109 {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .search-ph-0109 {
    position: absolute;
    left: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    color: color-mix(in srgb, var(--muted-foreground) 35%, transparent);
    pointer-events: none;
  }

  .search-kbd-0109 {
    display: inline-flex;
    height: 16px;
    align-items: center;
    padding: 0 4px;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 40%, transparent);
    font-family: var(--font-mono);
    font-size: 8px;
    color: color-mix(in srgb, var(--muted-foreground) 50%, transparent);
    flex-shrink: 0;
  }

  /* ─── Results ─── */

  .search-results-0109 {
    padding: 6px;
  }

  .search-section-header-0109 {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 2px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .search-section-header-0109.visible {
    opacity: 1;
  }

  .search-new-badge-0109 {
    display: inline-flex;
    height: 14px;
    align-items: center;
    padding: 0 5px;
    border-radius: 7px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
  }

  .search-new-badge-0109.glow {
    animation: badge-glow-0109 0.8s ease-out;
  }

  @keyframes badge-glow-0109 {
    0% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
    40% { box-shadow: 0 0 10px 3px rgba(255,255,255,0.08); }
    100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
  }

  .search-result-item-0109 {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 5px;
    opacity: 0;
    transform: translateX(8px);
    transition: opacity 0.25s, transform 0.25s;
  }

  .search-result-item-0109.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .search-result-item-0109:first-of-type.visible {
    background: var(--accent);
  }

  .sr-cb-0109 {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--foreground) 30%, transparent);
    flex-shrink: 0;
  }

  .sr-pri-0109 {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .sr-title-0109 {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sr-title-0109 mark {
    background: color-mix(in srgb, var(--foreground) 15%, transparent);
    color: var(--foreground);
    border-radius: 2px;
    padding: 0 1px;
  }

  .sr-body-dot-0109 {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted-foreground) 45%, transparent);
    flex-shrink: 0;
  }

  .sr-badge-0109 {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--muted-foreground);
    padding: 1px 5px;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sr-note-icon-0109 {
    width: 12px;
    height: 12px;
    color: var(--muted-foreground);
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* ─── Divider ─── */

  .search-divider-0109 {
    padding: 4px 8px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .search-divider-0109.visible {
    opacity: 1;
  }

  .search-divider-line-0109 {
    height: 1px;
    background: var(--border);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .search-divider-0109.visible .search-divider-line-0109 {
    transform: scaleX(1);
  }

  .search-result-note {
    /* note row shares same style */
  }
</style>

<script is:inline>
(function() {
  var timers = [];
  var running = false;

  function delay(ms) {
    return new Promise(function(resolve) {
      var t = setTimeout(resolve, ms);
      timers.push(t);
    });
  }

  function clearAllTimers() {
    timers.forEach(clearTimeout);
    timers = [];
  }

  // DOM refs
  var bg = document.querySelector('.preview-0109-bg');
  var bodyDot = document.getElementById('bg-body-dot-0109');
  var popup = document.getElementById('search-popup-0109');
  var searchText = document.getElementById('search-text-0109');
  var searchCaret = document.getElementById('search-caret-0109');
  var searchPh = document.getElementById('search-ph-0109');
  var tasksHeader = document.getElementById('search-tasks-header-0109');
  var result1 = document.getElementById('search-result-1-0109');
  var result2 = document.getElementById('search-result-2-0109');
  var divider = document.getElementById('search-divider-0109');
  var notesHeader = document.getElementById('search-notes-header-0109');
  var resultNote = document.getElementById('search-result-note-0109');

  function typeSearch(text, speed) {
    var i = 0;
    return new Promise(function(resolve) {
      function step() {
        if (!running) return;
        if (i < text.length) {
          searchText.textContent += text[i];
          i++;
          var t = setTimeout(step, speed || 60);
          timers.push(t);
        } else {
          resolve();
        }
      }
      step();
    });
  }

  function resetState() {
    if (bg) bg.classList.remove('visible');
    if (bodyDot) bodyDot.classList.remove('pulse');
    if (popup) popup.classList.remove('visible');
    if (searchText) searchText.textContent = '';
    if (searchCaret) { searchCaret.classList.remove('blinking'); searchCaret.style.opacity = '0'; }
    if (searchPh) searchPh.style.opacity = '1';
    if (tasksHeader) tasksHeader.classList.remove('visible');
    if (result1) result1.classList.remove('visible');
    if (result2) result2.classList.remove('visible');
    if (divider) divider.classList.remove('visible');
    if (notesHeader) notesHeader.classList.remove('visible');
    if (resultNote) resultNote.classList.remove('visible');
    // Remove glow
    var badge = notesHeader ? notesHeader.querySelector('.search-new-badge-0109') : null;
    if (badge) badge.classList.remove('glow');
  }

  async function runDemo() {
    if (!running) return;
    resetState();

    // Background fades in
    if (bg) bg.classList.add('visible');
    await delay(300);
    if (!running) return;

    // Body dot pulse
    if (bodyDot) {
      bodyDot.classList.add('pulse');
    }
    await delay(300);
    if (!running) return;

    // Search popup slides in
    if (popup) popup.classList.add('visible');
    await delay(350);
    if (!running) return;

    // Caret + type
    if (searchCaret) { searchCaret.style.opacity = '1'; searchCaret.classList.add('blinking'); }
    if (searchPh) searchPh.style.opacity = '0';
    await delay(200);
    if (!running) return;

    await typeSearch('project plan', 60);
    if (!running) return;
    if (searchCaret) searchCaret.classList.remove('blinking');
    await delay(400);
    if (!running) return;

    // Tasks header
    if (tasksHeader) tasksHeader.classList.add('visible');
    await delay(200);
    if (!running) return;

    // Result 1
    if (result1) result1.classList.add('visible');
    await delay(300);
    if (!running) return;

    // Result 2
    if (result2) result2.classList.add('visible');
    await delay(500);
    if (!running) return;

    // Divider draws
    if (divider) divider.classList.add('visible');
    await delay(350);
    if (!running) return;

    // Notes header + badge
    if (notesHeader) notesHeader.classList.add('visible');
    var badge = notesHeader ? notesHeader.querySelector('.search-new-badge-0109') : null;
    await delay(150);
    if (badge) badge.classList.add('glow');
    await delay(200);
    if (!running) return;

    // Note result
    if (resultNote) resultNote.classList.add('visible');
    await delay(2500);
    if (!running) return;

    // Fade everything out
    if (popup) {
      popup.style.transition = 'opacity 0.5s';
      popup.classList.remove('visible');
    }
    if (bg) bg.classList.remove('visible');
    await delay(2000);
    if (!running) return;

    // Restore transition
    if (popup) popup.style.transition = '';

    // Loop
    runDemo();
  }

  window.startPreview_0109 = function() {
    if (running) return;
    running = true;
    runDemo();
  };

  window.stopPreview_0109 = function() {
    running = false;
    clearAllTimers();
    resetState();
  };
})();
</script>

function nFilterSlashItems(query) {
  var q = query.toLowerCase().replace(/^\//, '');
  var result = [];
  var firstMarked = false;
  for (var g = 0; g < nSlashAllItems.length; g++) {
    var group = nSlashAllItems[g];
    var filteredItems = [];
    for (var i = 0; i < group.items.length; i++) {
      var item = group.items[i];
      if (item.title.toLowerCase().indexOf(q) !== -1) {
        var isActive = !firstMarked;
        if (isActive) firstMarked = true;
        filteredItems.push({ title: item.title, icon: item.icon, active: isActive, subtext: item.subtext });
      }
    }
    if (filteredItems.length > 0) {
      result.push({ group: group.group, items: filteredItems });
    }
  }
  return result;
}

function nRenderSlashMenu(groups) {
  var container = document.getElementById('notes-slash-items');
  if (!container) return;
  var html = '';
  // Inline all styles to avoid Astro style scoping issues with dynamic innerHTML
  for (var g = 0; g < groups.length; g++) {
    var group = groups[g];
    html += '<div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:0.05em;color:color-mix(in srgb,var(--muted-foreground) 60%,transparent);padding:8px 8px 4px;">' + group.group + '</div>';
    for (var i = 0; i < group.items.length; i++) {
      var item = group.items[i];
      var itemStyle = 'display:flex;width:100%;align-items:center;gap:8px;border-radius:4px;padding:6px 8px;font-size:12px;transition:background-color 0.1s,color 0.1s;';
      if (item.active) {
        itemStyle += 'background-color:var(--accent);color:var(--foreground);';
      } else {
        itemStyle += 'color:var(--muted-foreground);';
      }
      html += '<div style="' + itemStyle + '">';
      html += '<span style="width:20px;height:20px;flex-shrink:0;display:flex;align-items:center;justify-content:center;">' + item.icon + '</span>';
      html += '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + item.title + '</span>';
      if (item.subtext) {
        html += '<span style="margin-left:auto;flex-shrink:0;font-family:ui-monospace,SFMono-Regular,SF Mono,Menlo,monospace;font-size:10px;color:color-mix(in srgb,var(--muted-foreground) 50%,transparent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">' + item.subtext + '</span>';
      }
      html += '</div>';
    }
  }
  container.innerHTML = html;
}

function nShowSlashMenu(anchorEl, query) {
  var menu = n$('notes-slash-menu');
  var body = n$('notes-editor-body');
  if (!menu || !body || !anchorEl) return;
  var bodyRect = body.getBoundingClientRect();
  var anchorRect = anchorEl.getBoundingClientRect();
  var groups = nFilterSlashItems(query);
  nRenderSlashMenu(groups);
  menu.style.display = '';
  var left = anchorRect.left - bodyRect.left;
  var top = anchorRect.bottom - bodyRect.top + 4;
  menu.style.left = left + 'px';
  menu.style.top = top + 'px';
  menu.style.transform = 'translateY(-4px)';
  void menu.offsetHeight;
  menu.style.opacity = '1';
  menu.style.transform = 'translateY(0)';
}

function nUpdateSlashFilter(query) {
  var groups = nFilterSlashItems(query);
  nRenderSlashMenu(groups);
}

function nHideSlashMenu() {
  var menu = n$('notes-slash-menu');
  if (!menu) return;
  menu.style.opacity = '0';
  menu.style.transform = 'translateY(-4px)';
  nDelay(function() { menu.style.display = 'none'; }, 150);
}

// ─── Reset ───

function nResetAll() {
  // Hide cursor and reset to arrow type
  nHideCursor();
  nSetCursorType('arrow');

  // Reset to list view (instant, no transition)
  var listView = n$('notes-list-view');
  var editorView = n$('notes-editor-view');
  if (listView) {
    listView.style.transition = 'none';
    listView.style.opacity = '1';
    listView.style.zIndex = '2';
    listView.style.pointerEvents = '';
  }
  if (editorView) {
    editorView.style.transition = 'none';
    editorView.style.opacity = '0';
    editorView.style.zIndex = '1';
    editorView.style.pointerEvents = 'none';
  }
  // Re-enable transitions next frame
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      if (listView) listView.style.transition = '';
      if (editorView) editorView.style.transition = '';
    });
  });

  // Remove list item active state
  var target = n$('notes-list-item-target');
  if (target) target.classList.remove('notes-item-active');

  // Reset toolbar & slash menu
  nHideToolbar();
  nHideSlashMenu();
  nBoldBtnActive(false);

  // Reset demo block
  var demoBlock = n$('notes-demo-block');
  if (demoBlock) { demoBlock.style.display = 'none'; }
  var demoPara = n$('notes-demo-para');
  if (demoPara) { demoPara.style.display = ''; }
  var demoSlashText = n$('notes-demo-slash-text');
  if (demoSlashText) demoSlashText.textContent = '';
  var demoCaret = n$('notes-demo-caret');
  if (demoCaret) demoCaret.style.display = 'none';
  var demoHeading = n$('notes-demo-heading');
  if (demoHeading) { demoHeading.style.display = 'none'; demoHeading.textContent = ''; demoHeading.style.opacity = ''; }

  // Reset typed line
  var typedLine = n$('notes-typed-line');
  if (typedLine) { typedLine.style.display = 'none'; typedLine.style.opacity = ''; }
  var typedText = n$('notes-typed-text');
  if (typedText) { typedText.textContent = ''; typedText.innerHTML = ''; }
  var typedCaret = n$('notes-typed-caret');
  if (typedCaret) typedCaret.style.display = 'none';

  // Clean up drag elements
  var dragHl = document.getElementById('notes-drag-hl');
  if (dragHl) dragHl.removeAttribute('id');
  var dragRest = document.getElementById('notes-drag-rest');
  if (dragRest) dragRest.remove();
}

// ─── Main demo sequence ───

function runNotesDemo() {
  if (notesDemoPaused) return;

  var listTarget = n$('notes-list-item-target');
  var demoBlock = n$('notes-demo-block');
  var demoPara = n$('notes-demo-para');
  var demoSlashText = n$('notes-demo-slash-text');
  var demoCaret = n$('notes-demo-caret');
  var demoHeading = n$('notes-demo-heading');
  var typedLine = n$('notes-typed-line');
  var typedText = n$('notes-typed-text');
  var typedCaret = n$('notes-typed-caret');

  if (!listTarget || !demoBlock) return;

  // ──────────────────────────────────
  // PHASE 1: List view — cursor moves to note, clicks
  // ──────────────────────────────────

  nDelay(function() {
    if (notesDemoPaused) return;

    // Move cursor to the target note item
    nMoveCursor(listTarget, function() {
      if (notesDemoPaused) return;

      // Highlight the list item
      listTarget.classList.add('notes-item-active');

      nDelay(function() {
        if (notesDemoPaused) return;

        // Click
        nClickCursor(function() {
          if (notesDemoPaused) return;

          // Hide cursor during transition
          nHideCursor();

          // ──────────────────────────────────
          // PHASE 2: Crossfade list → editor
          // ──────────────────────────────────
          nDelay(function() {
            if (notesDemoPaused) return;
            nShowView('editor');

            // ──────────────────────────────────
            // PHASE 3: Slash command → heading
            // ──────────────────────────────────
            nDelay(function() {
              if (notesDemoPaused) return;

              // Show the demo block (paragraph mode)
              demoBlock.style.display = '';
              demoPara.style.display = '';
              demoHeading.style.display = 'none';

              // Move cursor to the demo block area and click
              nMoveCursor(demoPara, function() {
                if (notesDemoPaused) return;
                nClickCursor(function() {
                  if (notesDemoPaused) return;

                  // Type "/" — show slash menu with all items
                  nTypewriter('/', 'notes-demo-slash-text', 'notes-demo-caret', 60, function() {
                    if (notesDemoPaused) return;

                    nShowSlashMenu(demoPara, '/');

                    // Type "hea" to filter — menu narrows to heading items
                    nDelay(function() {
                      if (notesDemoPaused) return;

                      var filterText = 'hea';
                      var filterIdx = 0;

                      function typeFilterChar() {
                        if (notesDemoPaused) return;
                        if (filterIdx < filterText.length) {
                          demoSlashText.textContent += filterText[filterIdx];
                          filterIdx++;
                          nUpdateSlashFilter(demoSlashText.textContent);
                          nDelay(typeFilterChar, 80);
                        } else {
                          // Pause on filtered results, then "select" Heading 2
                          nDelay(function() {
                            if (notesDemoPaused) return;

                            // Update menu to highlight Heading 2 instead of Heading 1
                            var groups = nFilterSlashItems('/hea');
                            if (groups.length > 0 && groups[0].items.length > 1) {
                              groups[0].items[0].active = false;
                              groups[0].items[1].active = true;
                              nRenderSlashMenu(groups);
                            }

                            nDelay(function() {
                              if (notesDemoPaused) return;

                              // Hide slash menu and morph line into heading
                              nHideSlashMenu();
                              demoCaret.style.display = 'none';

                              // Fade out paragraph text
                              demoPara.style.transition = 'opacity 0.2s ease';
                              demoPara.style.opacity = '0';

                              nDelay(function() {
                                if (notesDemoPaused) return;
                                demoPara.style.display = 'none';
                                demoPara.style.opacity = '';
                                demoPara.style.transition = '';

                                // Show heading element and type into it
                                demoHeading.style.display = '';
                                demoHeading.textContent = '';
                                demoHeading.style.opacity = '1';
                                demoHeading.classList.add('notes-heading-typing');

                                nDelay(function() {
                                  if (notesDemoPaused) return;
                                  var headingText = 'Action items';
                                  var hIdx = 0;
                                  notesTypeInterval = setInterval(function() {
                                    if (notesDemoPaused) { clearInterval(notesTypeInterval); notesTypeInterval = null; return; }
                                    demoHeading.textContent += headingText[hIdx];
                                    hIdx++;
                                    if (hIdx >= headingText.length) {
                                      clearInterval(notesTypeInterval);
                                      notesTypeInterval = null;
                                      demoHeading.classList.remove('notes-heading-typing');

                                      // ──────────────────────────────────
                                      // PHASE 4: Type paragraph
                                      // ──────────────────────────────────
                                      nDelay(function() {
                                        if (notesDemoPaused) return;

                                        typedLine.style.display = '';
                                        typedText.textContent = '';
                                        typedText.innerHTML = '';

                                        nTypewriter('Review deck with Lisa before Thursday', 'notes-typed-text', 'notes-typed-caret', 45, function() {
                                          if (notesDemoPaused) return;

                                          // ──────────────────────────────────
                                          // PHASE 5: Drag-select + Bold
                                          // ──────────────────────────────────
                                          nDelay(function() {
                                            if (notesDemoPaused) return;

                                            nDragSelect('notes-typed-text', 'before Thursday', function() {
                                              if (notesDemoPaused) return;

                                              // Show toolbar above selected text
                                              nShowToolbar(typedLine);

                                              nDelay(function() {
                                                if (notesDemoPaused) return;

                                                // Move cursor to Bold button
                                                var boldBtn = n$('notes-fmt-bold');
                                                if (!boldBtn) return;

                                                nMoveCursor(boldBtn, function() {
                                                  if (notesDemoPaused) return;

                                                  nClickCursor(function() {
                                                    if (notesDemoPaused) return;

                                                    // Apply bold
                                                    nBoldBtnActive(true);

                                                    nDelay(function() {
                                                      if (notesDemoPaused) return;

                                                      // Clear selection, apply bold styling to text
                                                      var raw = typedText.textContent || '';
                                                      var boldTarget = 'before Thursday';
                                                      var bIdx = raw.lastIndexOf(boldTarget);
                                                      if (bIdx >= 0) {
                                                        var beforeBold = raw.substring(0, bIdx);
                                                        typedText.innerHTML = beforeBold + '<strong>' + boldTarget + '</strong>';
                                                      }
                                                      nBoldBtnActive(false);
                                                      nHideToolbar();

                                                      // ──────────────────────────────────
                                                      // PHASE 6: Hold, then reset and loop
                                                      // ──────────────────────────────────
                                                      nDelay(function() {
                                                        if (notesDemoPaused) return;
                                                        nHideCursor();

                                                        // Fade out demo elements
                                                        nDelay(function() {
                                                          if (notesDemoPaused) return;

                                                          // Fade typed line
                                                          typedLine.style.transition = 'opacity 0.5s ease';
                                                          typedLine.style.opacity = '0';

                                                          // Fade heading
                                                          demoHeading.style.transition = 'opacity 0.5s ease';
                                                          demoHeading.style.opacity = '0';

                                                          nDelay(function() {
                                                            if (notesDemoPaused) return;

                                                            // Crossfade back to list
                                                            nShowView('list');
                                                            listTarget.classList.remove('notes-item-active');

                                                            // Clean up demo elements
                                                            nDelay(function() {
                                                              if (notesDemoPaused) return;

                                                              // Reset demo block
                                                              demoBlock.style.display = 'none';
                                                              demoPara.style.display = '';
                                                              demoPara.style.opacity = '';
                                                              demoSlashText.textContent = '';
                                                              demoCaret.style.display = 'none';
                                                              demoHeading.style.display = 'none';
                                                              demoHeading.textContent = '';
                                                              demoHeading.style.opacity = '';
                                                              demoHeading.style.transition = '';

                                                              typedLine.style.display = 'none';
                                                              typedLine.style.opacity = '';
                                                              typedLine.style.transition = '';
                                                              typedText.textContent = '';
                                                              typedText.innerHTML = '';
                                                              typedCaret.style.display = 'none';

                                                              // Loop after pause
                                                              nDelay(function() {
                                                                if (!notesDemoPaused) runNotesDemo();
                                                              }, 2000);
                                                            }, 400);
                                                          }, 600);
                                                        }, 2000);
                                                      }, 800);
                                                    }, 250);
                                                  });
                                                });
                                              }, 600);
                                            });
                                          }, 400);
                                        });
                                      }, 300);

                                    }
                                  }, 50);
                                }, 200);
                              }, 250);
                            }, 500);
                          }, 300);
                        }
                      }
                      typeFilterChar();
                    }, 400);
                  });
                });
              });
            }, 500);
          }, 200);
        });
      }, 300);
    });
  }, 1200);
}

// ─── Public API ───

function startNotesAutoPlay() {
  notesDemoPaused = false;
  nResetAll();
  nDelay(function() { runNotesDemo(); }, 500);
}

function stopNotesAutoPlay() {
  notesDemoPaused = true;
  nClearTimers();
  nResetAll();
}

window.startNotesAutoPlay = startNotesAutoPlay;
window.stopNotesAutoPlay = stopNotesAutoPlay;
</script>


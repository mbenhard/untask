---
// NotesPreview — 1:1 CSS recreation of NotesList + NoteEditor
// References: NotesView.tsx, NotesList.tsx, NoteEditor.tsx, BlockEditor.tsx,
//             UntaskFormattingToolbar.tsx, UntaskSlashMenu.tsx
// Animation: list view → click note → slash /heading → type paragraph → select+bold → loop
---

<section id="notes-section" data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section label -->
    <div class="mb-8 flex flex-col items-center text-center">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[10px] tabular-nums text-muted-foreground/25">03</span>
        <span class="h-px w-4 border-t border-dashed border-border/60"></span>
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Notes Live Here Too</h2>
      </div>
      <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/40">
        Meeting notes, ideas, rough drafts — same window, no context switch. Rich text and slash commands, stored locally alongside everything else.
      </p>
      </p>
    </div>

    <!-- Window frame -->
    <div class="relative overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FEBC2E]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80"></span>
        </div>
        <div class="flex-1"></div>
        <nav class="flex items-center gap-0.5">
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Today</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Tasks</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Inbox</span>
          <span class="rounded-lg bg-accent px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-foreground">Notes</span>
        </nav>
      </header>

      <!-- ═══ Content Container (crossfade between list ↔ editor) ═══ -->
      <div class="notes-content-area relative" style="min-height: 420px;">

        <!-- Demo cursor (shared across both views) -->
        <div id="notes-cursor" class="pointer-events-none absolute z-50 opacity-0" style="top: 0; left: 0; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s; will-change: transform;">
          <div id="notes-cursor-inner" style="transition: transform 0.12s;">
            <img id="notes-cursor-arrow" src="/cursor-default.svg" width="24" height="30" alt="" />
            <svg id="notes-cursor-text" width="16" height="20" viewBox="0 0 16 20" fill="none" style="display: none; margin-left: -8px; margin-top: -2px;">
              <path d="M5 1h2a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5M11 1H9a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h2" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M5 1h2a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5M11 1H9a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h2" stroke="black" stroke-width="0.75" stroke-linecap="round"/>
              <line x1="4" y1="10" x2="12" y2="10" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4" y1="10" x2="12" y2="10" stroke="black" stroke-width="0.75" stroke-linecap="round"/>
            </svg>
          </div>
        </div>

        <!-- ═══ STATE 1: Notes List View ═══ -->
        <div id="notes-list-view" class="notes-view-state absolute inset-0 flex flex-col pb-14" style="opacity: 1; z-index: 2;">

          <!-- List header -->
          <header class="flex items-center justify-between px-3 py-2">
            <span class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Notes</span>
            <button type="button" class="inline-flex h-6 items-center gap-1 rounded-md px-1.5 text-[11px] text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground focus:outline-none">
              <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              New
            </button>
          </header>

          <!-- Note items -->
          <div class="flex-1 overflow-hidden px-1">

            <!-- Note 1: Pinned — this is the one we'll click -->
            <button id="notes-list-item-target" type="button" class="notes-list-item group flex w-full items-center gap-2 border-b border-border/40 px-2 py-2 text-left transition-colors duration-100">
              <svg class="size-[10px] shrink-0 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>
              </svg>
              <div class="min-w-0 flex-1">
                <span class="block truncate pl-0.5 text-[13px] font-medium text-foreground">Meeting agenda</span>
                <p class="mt-0.5 truncate text-[11px] text-muted-foreground">Review project timeline and assign...</p>
              </div>
              <span class="shrink-0 font-mono text-[10px] text-muted-foreground">2m ago</span>
            </button>

            <!-- Note 2 -->
            <button type="button" class="notes-list-item group flex w-full items-center gap-2 border-b border-border/40 px-2 py-2 text-left transition-colors duration-100">
              <div class="min-w-0 flex-1">
                <span class="block truncate pl-0.5 text-[13px] font-medium text-foreground">Product launch checklist</span>
                <p class="mt-0.5 truncate text-[11px] text-muted-foreground">Final review items for the Q2 release...</p>
              </div>
              <span class="shrink-0 font-mono text-[10px] text-muted-foreground">1h ago</span>
            </button>

            <!-- Note 3 -->
            <button type="button" class="notes-list-item group flex w-full items-center gap-2 px-2 py-2 text-left transition-colors duration-100">
              <div class="min-w-0 flex-1">
                <span class="block truncate pl-0.5 text-[13px] font-medium text-foreground">Design feedback</span>
                <p class="mt-0.5 truncate text-[11px] text-muted-foreground">Spacing feels off on the settings page...</p>
              </div>
              <span class="shrink-0 font-mono text-[10px] text-muted-foreground">3h ago</span>
            </button>

            <!-- Archived section toggle (matching NotesList.tsx) -->
            <div class="mt-4 border-t border-border/50 pt-2 pb-2">
              <button type="button" class="flex w-full items-center gap-1.5 px-3 py-1.5 text-[11px] text-muted-foreground transition-colors hover:text-foreground">
                <svg class="size-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>
                </svg>
                <span>Archived</span>
                <span class="ml-auto rounded-full bg-accent px-1.5 py-0.5 text-[9px] font-medium">1</span>
              </button>
            </div>

          </div>
        </div>

        <!-- ═══ STATE 2: Note Editor View ═══ -->
        <div id="notes-editor-view" class="notes-view-state absolute inset-0 flex flex-col pb-14" style="opacity: 0; z-index: 1; pointer-events: none;">

          <!-- Note header bar -->
          <header class="flex items-center gap-2 px-3 py-2">
            <button type="button" class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground focus:outline-none">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            </button>
            <span class="text-[10px] text-muted-foreground/70">Edited 2m ago</span>
            <div class="min-w-0 flex-1"></div>
            <div class="flex shrink-0 items-center gap-1.5 opacity-0" id="notes-demo-status">
              <span class="text-[10px] tracking-[0.01em] text-muted-foreground">saving</span>
            </div>
            <div class="flex shrink-0 items-center gap-1">
              <button type="button" class="inline-flex h-6 items-center gap-1 rounded-md px-1.5 text-[11px] text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground focus:outline-none">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                  <path d="M20 3v4"/><path d="M22 5h-4"/>
                </svg>
                process
              </button>
              <button type="button" class="inline-flex h-6 items-center gap-1 rounded-md px-1.5 text-[11px] text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground focus:outline-none">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>
                </svg>
                archive
              </button>
            </div>
          </header>

          <!-- Editor body -->
          <div id="notes-editor-body" class="relative min-h-0 flex-1 overflow-visible px-3 py-4">

            <!-- ═══ Floating Formatting Toolbar ═══ -->
            <div id="notes-fmt-toolbar" class="notes-toolbar-float pointer-events-none absolute z-40" style="opacity: 0; display: none;">
              <div class="flex items-center gap-0.5 rounded-md border border-border/60 bg-popover p-0.5 shadow-md">
                <span id="notes-fmt-bold" class="notes-fmt-btn flex size-7 items-center justify-center rounded-sm text-muted-foreground transition-colors duration-100">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8"/></svg>
                </span>
                <span class="notes-fmt-btn flex size-7 items-center justify-center rounded-sm text-muted-foreground">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
                </span>
                <span class="notes-fmt-btn flex size-7 items-center justify-center rounded-sm text-muted-foreground">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4H9a3 3 0 0 0-2.83 4"/><path d="M14 12a4 4 0 0 1 0 8H6"/><line x1="4" x2="20" y1="12" y2="12"/></svg>
                </span>
                <span class="notes-fmt-btn flex size-7 items-center justify-center rounded-sm text-muted-foreground">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </span>
                <div class="mx-0.5 h-4 w-px bg-border/40" aria-hidden="true"></div>
                <span class="notes-fmt-btn flex size-7 items-center justify-center rounded-sm text-muted-foreground">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </span>
              </div>
            </div>

            <!-- ═══ Slash Command Menu ═══ -->
            <div id="notes-slash-menu" class="notes-slash-float pointer-events-none absolute z-40" style="opacity: 0; display: none;">
              <div class="min-w-[200px] max-h-[280px] overflow-y-auto rounded-md border border-border/60 bg-popover p-1 shadow-md">
                <div id="notes-slash-items"></div>
              </div>
            </div>

            <!-- Editor content blocks -->
            <div class="space-y-3 text-sm leading-relaxed text-foreground/90">

              <!-- Existing heading -->
              <h3 class="text-[0.95rem] font-semibold leading-[1.3] text-foreground">Meeting agenda</h3>

              <!-- Existing bullet list -->
              <ul class="list-disc space-y-1.5 pl-5 text-foreground/85">
                <li>Review project timeline and deliverables</li>
                <li>Assign owners for open items</li>
                <li>Discuss budget for Q2</li>
              </ul>

              <!-- Existing paragraph -->
              <p class="text-foreground/80">
                Need to block Wednesday afternoon for deep work on the new design. No meetings.
              </p>

              <!-- ═══ DEMO: Slash command line (morphs into heading) ═══ -->
              <div id="notes-demo-block" style="display: none;">
                <!-- This container morphs between states:
                     1. Paragraph with typed "/" text + caret
                     2. Heading result after slash command completes -->
                <p id="notes-demo-para" class="text-foreground/80" style="min-height: 1.5em;">
                  <span id="notes-demo-slash-text"></span><span id="notes-demo-caret" class="notes-caret" style="display: none;"></span>
                </p>
                <h4 id="notes-demo-heading" class="text-[1rem] font-semibold leading-[1.3] text-foreground" style="display: none;"></h4>
              </div>

              <!-- ═══ DEMO: Typed paragraph line ═══ -->
              <p id="notes-typed-line" style="display: none;">
                <span id="notes-typed-text" class="text-foreground/80"></span><span id="notes-typed-caret" class="notes-caret" style="display: none;"></span>
              </p>

            </div>
          </div>
        </div>

        <!-- ═══ Bottom bar (visible in both states) ═══ -->
        <div class="absolute inset-x-3 bottom-3 z-10 flex items-center gap-2">
          <div class="flex shrink-0 items-center gap-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.293 2.293a1 1 0 0 1 1.414 0l2.5 2.5 5.994 1.227a1 1 0 0 1 .506 1.687l-7 7a1 1 0 0 1-1.687-.506l-1.227-5.994-2.5-2.5a1 1 0 0 1 0-1.414z" />
                <path d="m14.207 4.793-3.414 3.414" />
                <path d="M3 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                <path d="m9.086 6.5-4.793 4.793a1 1 0 0 0-.18 1.17L7 18" />
              </svg>
            </span>
          </div>
          <div class="flex-1"></div>
          <div class="flex h-8 w-14 items-center justify-center rounded-lg border border-border/60 bg-card/90 text-[10px] font-medium tracking-wide text-muted-foreground shadow-lg backdrop-blur-sm">
            Chat
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── View state crossfade ─── */

  .notes-view-state {
    transition: opacity 0.3s ease;
  }

  /* ─── List items ─── */

  .notes-list-item:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .notes-list-item.notes-item-active {
    background-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* ─── Caret blink ─── */

  .notes-caret {
    display: inline-block;
    width: 1.5px;
    height: 1em;
    background-color: var(--foreground);
    vertical-align: text-bottom;
    margin-left: 0.5px;
    animation: notes-blink 1s step-end infinite;
  }
  @keyframes notes-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ─── Selection highlight ─── */

  .notes-selection-hl {
    background-color: color-mix(in srgb, #3b82f6 30%, transparent);
    color: var(--foreground);
    border-radius: 1px;
    padding: 1px 0;
  }

  /* ─── Formatting toolbar ─── */

  .notes-toolbar-float {
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .notes-fmt-btn-active {
    background-color: var(--accent);
    color: var(--foreground) !important;
    border-radius: 2px;
  }

  /* ─── Slash menu ─── */

  .notes-slash-float {
    transition: opacity 0.15s ease, transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Slash menu item styles are inlined in the JS render function
     to avoid Astro style scoping issues with dynamic innerHTML */
</style>

<script is:inline>
// ═══════════════════════════════════════════
// NotesPreview — Animation Controller
// ═══════════════════════════════════════════

var notesDemoPaused = false;
var notesTimers = [];
var notesTypeInterval = null;

// ─── Timer management ───

function nDelay(fn, ms) {
  var t = setTimeout(fn, ms);
  notesTimers.push(t);
  return t;
}

function nClearTimers() {
  notesTimers.forEach(clearTimeout);
  notesTimers = [];
  if (notesTypeInterval) {
    clearInterval(notesTypeInterval);
    notesTypeInterval = null;
  }
}

// ─── DOM helpers ───

var nCache = {};
function n$(id) { return nCache[id] || (nCache[id] = document.getElementById(id)); }

// ─── Cursor helpers ───

function nMoveCursor(targetEl, cb) {
  var cursor = n$('notes-cursor');
  if (!cursor || !targetEl) { if (cb) cb(); return; }
  var container = cursor.offsetParent;
  if (!container) { if (cb) cb(); return; }
  var cr = container.getBoundingClientRect();
  var tr = targetEl.getBoundingClientRect();
  var x = tr.left - cr.left + tr.width * 0.35;
  var y = tr.top - cr.top + tr.height * 0.35;
  cursor.style.opacity = '1';
  cursor.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
  nDelay(cb, 550);
}

function nMoveCursorXY(x, y, cb) {
  var cursor = n$('notes-cursor');
  if (!cursor) { if (cb) cb(); return; }
  cursor.style.opacity = '1';
  cursor.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
  nDelay(cb, 550);
}

function nClickCursor(cb) {
  var inner = n$('notes-cursor-inner');
  if (!inner) { if (cb) cb(); return; }
  inner.style.transform = 'scale(0.78)';
  nDelay(function() {
    inner.style.transform = 'scale(1)';
    nDelay(cb, 120);
  }, 120);
}

function nHideCursor() {
  var cursor = n$('notes-cursor');
  if (cursor) cursor.style.opacity = '0';
}

function nSetCursorType(type) {
  var arrow = document.getElementById('notes-cursor-arrow');
  var text = document.getElementById('notes-cursor-text');
  if (!arrow || !text) return;
  if (type === 'text') {
    arrow.style.display = 'none';
    text.style.display = '';
  } else {
    arrow.style.display = '';
    text.style.display = 'none';
  }
}

// ─── View state management ───

function nShowView(viewId) {
  var listView = n$('notes-list-view');
  var editorView = n$('notes-editor-view');
  if (viewId === 'list') {
    listView.style.opacity = '1';
    listView.style.zIndex = '2';
    listView.style.pointerEvents = '';
    editorView.style.opacity = '0';
    editorView.style.zIndex = '1';
    editorView.style.pointerEvents = 'none';
  } else {
    editorView.style.opacity = '1';
    editorView.style.zIndex = '2';
    editorView.style.pointerEvents = '';
    listView.style.opacity = '0';
    listView.style.zIndex = '1';
    listView.style.pointerEvents = 'none';
  }
}

// ─── Typewriter ───

function nTypewriter(text, spanId, caretId, speed, cb) {
  var span = document.getElementById(spanId);
  var caret = document.getElementById(caretId);
  if (!span) { if (cb) cb(); return; }
  span.textContent = '';
  if (caret) caret.style.display = '';
  var i = 0;
  notesTypeInterval = setInterval(function() {
    if (notesDemoPaused) { clearInterval(notesTypeInterval); notesTypeInterval = null; return; }
    span.textContent += text[i];
    i++;
    if (i >= text.length) {
      clearInterval(notesTypeInterval);
      notesTypeInterval = null;
      if (cb) nDelay(cb, 400);
    }
  }, speed);
}

// ─── Drag-select ───

function nDragSelect(spanId, hlText, cb) {
  var span = document.getElementById(spanId);
  var cursor = n$('notes-cursor');
  var caret = document.getElementById('notes-typed-caret');
  if (!span || !cursor) { if (cb) cb(); return; }
  if (caret) caret.style.display = 'none';

  // Switch to text cursor for selection
  nSetCursorType('text');

  // Use cursor's offsetParent as coordinate reference (same frame as nMoveCursor)
  var container = cursor.offsetParent;
  if (!container) { if (cb) cb(); return; }
  var containerRect = container.getBoundingClientRect();

  var fullText = span.textContent || '';
  var hlStart = fullText.lastIndexOf(hlText);
  if (hlStart < 0) hlStart = Math.max(0, fullText.length - hlText.length);
  var before = fullText.substring(0, hlStart);
  var highlight = fullText.substring(hlStart);

  // Build initial state: before text + empty hl + rest as plain
  // Inline highlight style to avoid Astro style scoping on dynamic innerHTML
  var hlStyle = 'background-color:color-mix(in srgb,#3b82f6 30%,transparent);color:var(--foreground);border-radius:1px;padding:1px 0;';
  span.innerHTML = before + '<span id="notes-drag-hl" style="' + hlStyle + '"></span><span id="notes-drag-rest">' + highlight + '</span>';

  var hlSpan = document.getElementById('notes-drag-hl');
  var restSpan = document.getElementById('notes-drag-rest');
  if (!hlSpan || !restSpan) { if (cb) cb(); return; }

  // Position cursor at start of highlight area
  var restRect = restSpan.getBoundingClientRect();
  var startX = restRect.left - containerRect.left - 4;
  var startY = restRect.top - containerRect.top + restRect.height * 0.5;
  cursor.style.transition = 'transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s';
  cursor.style.transform = 'translate(' + startX + 'px, ' + startY + 'px)';

  var charIdx = 0;
  var totalChars = highlight.length;

  nDelay(function() {
    if (notesDemoPaused) return;

    function dragStep() {
      if (notesDemoPaused) return;
      if (charIdx < totalChars) {
        charIdx++;
        hlSpan.textContent = highlight.substring(0, charIdx);
        restSpan.textContent = highlight.substring(charIdx);

        // Move cursor smoothly with the highlight edge
        var curHlRect = hlSpan.getBoundingClientRect();
        var cx = curHlRect.right - containerRect.left;
        var cy = curHlRect.top - containerRect.top + curHlRect.height * 0.5;
        cursor.style.transition = 'transform 0.04s linear, opacity 0.3s';
        cursor.style.transform = 'translate(' + cx + 'px, ' + cy + 'px)';

        nDelay(dragStep, 35);
      } else {
        restSpan.remove();
        // Restore arrow cursor and normal speed
        nSetCursorType('arrow');
        cursor.style.transition = 'transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s';
        nDelay(cb, 250);
      }
    }

    dragStep();
  }, 450);
}


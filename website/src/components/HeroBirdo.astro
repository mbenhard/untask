---
// Hero section — duplicate with dancing birdo mascot for comparison
const version = "v0.1.8";
---

<section class="relative flex min-h-screen flex-col items-center justify-center px-6">
  <div class="flex max-w-lg flex-col items-center text-center">

    <!-- Dancing birdo mascot -->
    <div class="birdo-mascot mb-6" role="button" tabindex="0" aria-label="Click me!" onclick="birdoBounce(this)" onkeydown="if(event.key==='Enter')birdoBounce(this)">
      <span class="birdo-chirp-bubble">Chirp!</span>
      <div class="birdo-scene">
        <svg viewBox="60 70 140 200" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <!-- Shadow on the floor -->
          <ellipse cx="130" cy="265" rx="35" ry="4" fill="currentColor" class="birdo-shadow" opacity="0.15" />

          <g class="birdo-all">
            <!-- Left Leg (Back) -->
            <g class="birdo-left-leg birdo-leg">
              <path
                d="M 120 228 L 120 260 L 136 260 M 120 260 L 132 255 M 120 260 L 113 260"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>

            <!-- Right Leg (Front) -->
            <g class="birdo-right-leg birdo-leg">
              <path
                d="M 140 228 L 140 260 L 156 260 M 140 260 L 152 255 M 140 260 L 133 260"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>

            <!-- Body, Beak, and Eye -->
            <g class="birdo-body-group">
              <!-- Beak -->
              <path d="M 154 99 L 192 105 L 156 119 Z" fill="currentColor" />

              <!-- Main Body -->
              <path
                d="
                  M 91 212
                  Q 87 228 102 228
                  L 158 228
                  Q 173 228 169 212
                  L 155 110
                  Q 153 80 130 80
                  Q 107 80 105 110
                  Z
                "
                fill="currentColor"
              />

              <!-- Eye -->
              <circle cx="132" cy="105" r="6.5" fill="var(--background, #161616)" class="birdo-eye" />
            </g>
          </g>
        </svg>
      </div>
    </div>

    <!-- Version badge -->
    <a
      href="/changelog"
      class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-border/40 px-3 py-1 font-mono text-[11px] text-muted-foreground/60 transition-colors hover:border-border hover:text-muted-foreground"
    >
      <span class="text-foreground/80">{version}</span>
      <span class="text-muted-foreground/30">&middot;</span>
      What's new
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <h1 class="font-sans text-4xl font-normal tracking-tight text-foreground sm:text-5xl">
      Untask
    </h1>

    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted-foreground sm:text-base">
      No cloud. No cost. No surveillance.<br class="hidden sm:inline" />
      An open-source task manager with AI built in.
    </p>

    <div class="mt-8 flex items-center gap-2.5">
      <a
        href="#download"
        class="inline-flex h-8 items-center rounded-md bg-primary px-4 text-[12px] font-medium text-primary-foreground transition-opacity hover:opacity-80"
      >
        Download for macOS
      </a>
      <a
        href="https://github.com/mbenhard/untask"
        class="inline-flex h-8 items-center rounded-md border border-dashed border-border/60 px-4 text-[12px] font-medium text-muted-foreground transition-colors hover:border-border hover:text-foreground"
      >
        GitHub
      </a>
    </div>

    <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground/50">
      MIT Licensed &middot; macOS only
    </p>
  </div>

  <!-- Scroll hint -->
  <div class="birdo-scroll-hint absolute bottom-8 text-muted-foreground/40" aria-hidden="true">
    <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
      <path d="M8 4v12M4 12l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<style>
  /*
   * Dancing birdo mascot
   * Extracted from birdo.html, adapted to hero scale
   * Body ~35px wide (similar to original mascot's 36px)
   */

  .birdo-mascot {
    --step-dur: 1.1s;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .birdo-scene {
    width: 80px;
    height: 62px;
    position: relative;
    z-index: 2;
  }

  .birdo-scene svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Shadow pulse */
  .birdo-shadow {
    transform-origin: 130px 265px;
    animation: birdo-shadow-pulse var(--step-dur) ease-in-out infinite;
  }

  /* Body dance — rocks back and forth with squash/stretch */
  .birdo-body-group {
    transform-origin: 130px 228px;
    animation: birdo-body-dance var(--step-dur) ease-in-out infinite;
  }

  /* Leg stepping */
  .birdo-leg {
    animation: birdo-leg-step var(--step-dur) ease-in-out infinite;
  }

  .birdo-left-leg {
    transform-origin: 120px 228px;
  }

  .birdo-right-leg {
    transform-origin: 140px 228px;
    animation-delay: calc(var(--step-dur) / -2);
  }

  /* Eye blink */
  .birdo-eye {
    transform-origin: 132px 105px;
    animation: birdo-blink 3.5s infinite;
  }

  /* Keyframes */
  @keyframes birdo-body-dance {
    0%   { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
    25%  { transform: translateY(-10px) rotate(4deg) scaleY(1.02); }
    50%  { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
    75%  { transform: translateY(-10px) rotate(-6deg) scaleY(1.02); }
    100% { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
  }

  @keyframes birdo-leg-step {
    0%   { transform: rotate(40deg) translateY(0); }
    25%  { transform: rotate(0deg) translateY(-28px); }
    50%  { transform: rotate(-40deg) translateY(0); }
    75%  { transform: rotate(0deg) translateY(0); }
    100% { transform: rotate(40deg) translateY(0); }
  }

  @keyframes birdo-shadow-pulse {
    0%, 50%, 100% { transform: scaleX(1); opacity: 0.15; }
    25%, 75%      { transform: scaleX(0.7); opacity: 0.05; }
  }

  @keyframes birdo-blink {
    0%, 46%, 50%, 100% { transform: scaleY(1); }
    48% { transform: scaleY(0); }
  }

  /* Click bounce — elastic snap */
  .birdo-mascot.bounce .birdo-body-group {
    animation: birdo-snap var(--step-dur) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes birdo-snap {
    0%   { transform: translateY(0) scaleX(1) scaleY(1); }
    8%   { transform: translateY(2px) scaleX(1.08) scaleY(0.92); }
    30%  { transform: translateY(-14px) scaleX(0.92) scaleY(1.08); }
    52%  { transform: translateY(2px) scaleX(1.05) scaleY(0.95); }
    68%  { transform: translateY(-3px) scaleX(0.97) scaleY(1.03); }
    82%  { transform: translateY(0.5px) scaleX(1.01) scaleY(0.99); }
    100% { transform: translateY(0) scaleX(1) scaleY(1); }
  }

  /* Chirp bubble */
  .birdo-chirp-bubble {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(calc(-50% + var(--chirp-offset, 0px))) rotate(var(--chirp-rotate, 0deg)) scale(0);
    background: var(--accent);
    color: var(--muted-foreground);
    font-size: 9px;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    z-index: 10;
  }

  .birdo-chirp-bubble::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid var(--accent);
  }

  .birdo-mascot.show-chirp .birdo-chirp-bubble {
    animation: birdo-chirp-pop 600ms ease-out forwards;
  }

  @keyframes birdo-chirp-pop {
    0%   { transform: translateX(calc(-50% + var(--chirp-offset, 0px))) rotate(var(--chirp-rotate, 0deg)) scale(0); opacity: 0; }
    20%  { transform: translateX(calc(-50% + var(--chirp-offset, 0px))) rotate(var(--chirp-rotate, 0deg)) scale(1.15); opacity: 1; }
    35%  { transform: translateX(calc(-50% + var(--chirp-offset, 0px))) rotate(var(--chirp-rotate, 0deg)) translateY(-2px) scale(1); opacity: 1; }
    100% { transform: translateX(calc(-50% + var(--chirp-offset, 0px))) rotate(var(--chirp-rotate, 0deg)) translateY(-8px) scale(1); opacity: 0; }
  }

  /* Scroll hint */
  .birdo-scroll-hint {
    animation: birdo-bob 2s ease-in-out infinite;
  }

  @keyframes birdo-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(6px); }
  }
</style>

<script is:inline>
  (function() {
    var phrases = ['Hi!', 'Hello!', "'sup", 'hey!', 'me?', 'yo!', 'hmm?', 'oh!', '!', '...hi', 'ooo!', 'heyy', 'hm?', 'wat', ':)', ':o', ';)', '!', 'uwu', "I'm just a bird", 'stop clicking', 'STOP', 'nope', 'why', '(ෆ˙ᵕ˙ෆ)♡'];
    var lastPhrase = -1;
    var timeoutId;

    function birdoBounce(el) {
      var bubble = el.querySelector('.birdo-chirp-bubble');

      var idx;
      do { idx = Math.floor(Math.random() * phrases.length); } while (idx === lastPhrase && phrases.length > 1);
      lastPhrase = idx;

      if (bubble) {
        bubble.textContent = phrases[idx];
        var angle = Math.floor(Math.random() * 25) - 12;
        var offsetX = Math.floor(Math.random() * 8) - 4;
        bubble.style.setProperty('--chirp-rotate', angle + 'deg');
        bubble.style.setProperty('--chirp-offset', offsetX + 'px');
      }

      if (el.classList.contains('bounce')) {
        el.classList.remove('bounce', 'show-chirp');
        void (bubble && bubble.offsetWidth);
      }

      el.classList.add('bounce', 'show-chirp');
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(function() {
        el.classList.remove('bounce', 'show-chirp');
      }, 600);
    }

    window.birdoBounce = birdoBounce;
  })();
</script>

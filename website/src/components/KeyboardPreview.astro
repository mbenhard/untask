<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── Nav tabs ─── */

  .kb-tab {
    color: var(--muted-foreground);
    transition: color 0.2s, background-color 0.2s;
  }

  .kb-tab-active {
    color: var(--foreground);
    background-color: var(--accent);
  }

  /* ─── Focus highlight ─── */

  .kb-focused {
    background-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* ─── Inline task input ─── */

  .kb-inline-input {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.2s;
  }

  .kb-inline-input.kb-visible {
    max-height: 48px;
    opacity: 1;
  }

  /* ─── Task body expand/collapse ─── */

  .kb-task-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s;
  }

  .kb-task-body.kb-expanded {
    max-height: 200px;
    opacity: 1;
  }

  /* ─── Typing cursor ─── */

  .kb-typing::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 14px;
    background: var(--foreground);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: kb-blink 0.8s step-end infinite;
  }

  @keyframes kb-blink {
    50% { opacity: 0; }
  }

  /* ─── Key badge pill container ─── */

  .kb-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 200px;
    height: 36px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s, transform 0.25s, border-color 0.3s;
  }

  .kb-pill.kb-pill-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .kb-pill.kb-pill-pulse {
    border-color: color-mix(in srgb, var(--foreground) 20%, transparent);
  }

  .kb-pill-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--muted-foreground);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .kb-pill-label.kb-label-visible {
    opacity: 1;
  }

  .kb-pill-keys {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  /* ─── Key badge ─── */

  .kb-key {
    display: inline-flex;
    height: 22px;
    min-width: 22px;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    border-radius: 5px;
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    background: color-mix(in srgb, var(--muted) 50%, transparent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    line-height: 1;
    color: var(--muted-foreground);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.12s, transform 0.12s, border-color 0.15s, color 0.15s, background-color 0.15s;
  }

  .kb-key.visible {
    opacity: 1;
    transform: scale(1);
  }

  .kb-key.active {
    border-color: color-mix(in srgb, var(--foreground) 35%, transparent);
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
    color: var(--foreground);
    transform: scale(1.08);
  }

  /* ─── View stack (smooth crossfade + height morph) ─── */

  .kb-view-stack {
    position: relative;
    overflow: hidden;
    /* height is driven by JS during transitions, natural otherwise */
  }

  .kb-view {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  .kb-view-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: relative;
  }

  /* Transitioning-out view: stays visible while fading */
  .kb-view-out {
    visibility: visible;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transition: opacity 0.32s ease, visibility 0s linear 0.32s;
  }

  /* Transitioning-in view: fades in, floats at top inside the morphing stack */
  .kb-view-in {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transition: opacity 0.32s ease;
  }

  /* After height morph completes, switch back to natural flow */
  .kb-view-in-settled {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  /* ─── Search overlay ─── */

  #kb-search-overlay.kb-search-open {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #kb-search-overlay.kb-search-open #kb-search-panel {
    transform: scale(1) !important;
    opacity: 1 !important;
  }
</style>

<script is:inline>
/* ═══════════════════════════════════════════════
   KeyboardPreview — step-based demo runner
   ═══════════════════════════════════════════════ */

var kbTimers = [];
var kbPaused = false;

function kbDelay(fn, ms) {
  var t = setTimeout(fn, ms);
  kbTimers.push(t);
  return t;
}

function kbClearTimers() {
  for (var i = 0; i < kbTimers.length; i++) clearTimeout(kbTimers[i]);
  kbTimers = [];
}

/* ─── Pill key badge system ─── */

function kbShowKeys(keys, label) {
  var pill = document.getElementById('kb-pill');
  var container = document.getElementById('kb-keys');
  var labelEl = document.getElementById('kb-key-label');
  if (!container || !pill) return;

  // Show pill
  pill.classList.add('kb-pill-visible');

  // Clear existing keys
  container.innerHTML = '';

  // Show label
  if (labelEl) {
    labelEl.textContent = label || '';
    if (label) {
      labelEl.classList.add('kb-label-visible');
    } else {
      labelEl.classList.remove('kb-label-visible');
    }
  }

  // Create key badges
  for (var i = 0; i < keys.length; i++) {
    var key = document.createElement('span');
    key.className = 'kb-key';
    key.textContent = keys[i];
    container.appendChild(key);
  }

  // Animate in with pulse
  requestAnimationFrame(function() {
    var els = container.querySelectorAll('.kb-key');
    for (var j = 0; j < els.length; j++) {
      els[j].classList.add('visible');
    }
    // Pulse the pill border
    pill.classList.add('kb-pill-pulse');
    // Brief active highlight on keys
    kbDelay(function() {
      for (var k = 0; k < els.length; k++) {
        els[k].classList.add('active');
      }
      kbDelay(function() {
        for (var m = 0; m < els.length; m++) {
          els[m].classList.remove('active');
        }
        pill.classList.remove('kb-pill-pulse');
      }, 180);
    }, 30);
  });
}

function kbHideKeys() {
  var pill = document.getElementById('kb-pill');
  var container = document.getElementById('kb-keys');
  var labelEl = document.getElementById('kb-key-label');
  if (!container) return;
  var els = container.querySelectorAll('.kb-key');
  for (var i = 0; i < els.length; i++) {
    els[i].classList.remove('visible', 'active');
  }
  if (labelEl) labelEl.classList.remove('kb-label-visible');
  if (pill) pill.classList.remove('kb-pill-visible', 'kb-pill-pulse');
}

/* ─── Task focus ─── */

function kbSetFocus(taskId) {
  var ids = ['kb-task-1', 'kb-task-2', 'kb-task-3'];
  for (var i = 0; i < ids.length; i++) {
    var el = document.getElementById(ids[i]);
    if (el) el.classList.remove('kb-focused');
  }
  if (taskId) {
    var target = document.getElementById('kb-task-' + taskId);
    if (target) target.classList.add('kb-focused');
  }
}

/* ─── Task complete/uncomplete ─── */

function kbCompleteTask(taskId) {
  var row = document.getElementById('kb-task-' + taskId);
  if (!row) return;
  var circle = row.querySelector('.kb-circle');
  var check = row.querySelector('.kb-check');
  var title = row.querySelector('.kb-title');

  if (circle) {
    circle.style.borderStyle = 'solid';
    circle.style.borderColor = 'var(--foreground)';
    circle.style.backgroundColor = 'var(--foreground)';
  }
  if (check) check.style.opacity = '1';
  if (title) {
    title.style.textDecoration = 'line-through';
    title.style.color = 'var(--muted-foreground)';
  }
}

function kbUncompleteTask(taskId) {
  var row = document.getElementById('kb-task-' + taskId);
  if (!row) return;
  var circle = row.querySelector('.kb-circle');
  var check = row.querySelector('.kb-check');
  var title = row.querySelector('.kb-title');

  if (circle) {
    circle.style.borderStyle = 'dashed';
    circle.style.borderColor = 'var(--foreground-muted, rgba(245,245,245,0.35))';
    circle.style.backgroundColor = 'transparent';
  }
  if (check) check.style.opacity = '0';
  if (title) {
    title.style.textDecoration = '';
    title.style.color = '';
  }
}

/* ─── Priority cycling ─── */

var kbPriorityColors = ['bg-foreground/15', 'bg-emerald-500', 'bg-amber-500', 'bg-rose-500'];
var kbPriorityLabels = ['', 'Low', 'Med', 'High'];
// Tailwind classes → inline colors for dynamic update
var kbPriorityMap = {
  'bg-foreground/15': null,
  'bg-emerald-500': '#10b981',
  'bg-amber-500': '#f59e0b',
  'bg-rose-500': '#f43f5e'
};
var kbCurrentPriority = 1; // start at emerald (low) — task 3 starts as low

function kbCyclePriority() {
  kbCurrentPriority = (kbCurrentPriority + 1) % kbPriorityColors.length;
  var dot = document.getElementById('kb-priority-dot');
  var metaDot = document.getElementById('kb-meta-dot');
  var metaLabel = document.getElementById('kb-meta-label');
  var color = kbPriorityMap[kbPriorityColors[kbCurrentPriority]];

  if (dot) {
    dot.className = 'size-[5px] rounded-full transition-colors duration-300';
    dot.classList.add(kbPriorityColors[kbCurrentPriority]);
  }
  if (metaDot) {
    metaDot.className = 'inline-block size-1.5 rounded-full transition-colors duration-300';
    metaDot.classList.add(kbPriorityColors[kbCurrentPriority]);
  }
  if (metaLabel) {
    metaLabel.textContent = kbPriorityLabels[kbCurrentPriority];
  }
}

function kbResetPriority() {
  kbCurrentPriority = 1; // reset to low (emerald)
  var dot = document.getElementById('kb-priority-dot');
  var metaDot = document.getElementById('kb-meta-dot');
  var metaLabel = document.getElementById('kb-meta-label');
  if (dot) {
    dot.className = 'size-[5px] rounded-full bg-emerald-500 transition-colors duration-300';
  }
  if (metaDot) {
    metaDot.className = 'inline-block size-1.5 rounded-full bg-emerald-500 transition-colors duration-300';
  }
  if (metaLabel) metaLabel.textContent = 'Low';
}

/* ─── Today toggle ─── */

var kbTodayActive = false;

function kbToggleToday() {
  kbTodayActive = !kbTodayActive;
  var toggle = document.getElementById('kb-today-toggle');
  if (!toggle) return;
  var svg = toggle.querySelector('svg');
  if (kbTodayActive) {
    toggle.classList.remove('text-muted-foreground');
    toggle.classList.add('text-foreground');
    if (svg) svg.setAttribute('fill', 'currentColor');
  } else {
    toggle.classList.remove('text-foreground');
    toggle.classList.add('text-muted-foreground');
    if (svg) svg.setAttribute('fill', 'none');
  }
}

function kbResetToday() {
  kbTodayActive = false;
  var toggle = document.getElementById('kb-today-toggle');
  if (!toggle) return;
  toggle.classList.remove('text-foreground');
  toggle.classList.add('text-muted-foreground');
  var svg = toggle.querySelector('svg');
  if (svg) svg.setAttribute('fill', 'none');
}

/* ─── Task expand/collapse ─── */

function kbExpandTask() {
  var body = document.getElementById('kb-task-body');
  if (body) body.classList.add('kb-expanded');
}

function kbCollapseTask() {
  var body = document.getElementById('kb-task-body');
  if (body) body.classList.remove('kb-expanded');
}

/* ─── View switching ─── */

var kbTabs = ['today', 'tasks', 'inbox', 'notes'];
var kbViews = ['today', 'tasks', 'inbox']; // views with actual content
var kbCurrentView = 'today';

function kbSwitchView(view) {
  // Toggle nav tab active state
  for (var i = 0; i < kbTabs.length; i++) {
    var tab = document.getElementById('kb-tab-' + kbTabs[i]);
    if (tab) {
      if (kbTabs[i] === view) {
        tab.classList.add('kb-tab-active');
      } else {
        tab.classList.remove('kb-tab-active');
      }
    }
  }

  // Skip view container animation if same view
  if (view === kbCurrentView) return;

  var stack = document.querySelector('.kb-view-stack');
  var oldView = document.getElementById('kb-view-' + kbCurrentView);
  var newView = document.getElementById('kb-view-' + view);

  if (!stack || !newView) {
    kbCurrentView = view;
    return;
  }

  // 1. Lock stack to its current rendered height
  var fromHeight = stack.getBoundingClientRect().height;
  stack.style.transition = 'none';
  stack.style.height = fromHeight + 'px';

  // 2. Measure the incoming view's natural height by briefly making it position:absolute
  //    (which it already is via .kb-view) with correct width constraints, then read scrollHeight.
  //    We need left/right:0 to be set so width matches the stack — .kb-view already has these.
  var toHeight = newView.scrollHeight;

  // 3. Reset all view classes
  for (var j = 0; j < kbViews.length; j++) {
    var v = document.getElementById('kb-view-' + kbViews[j]);
    if (v) v.className = 'kb-view';
  }

  // 4. Apply transition states: new view fades in (absolute, on top), old fades out
  if (newView) newView.className = 'kb-view kb-view-in';
  if (oldView) oldView.className = 'kb-view kb-view-out';

  kbCurrentView = view;

  // 5. On next frame, activate the height morph transition and animate to new height
  requestAnimationFrame(function() {
    stack.style.transition = 'height 0.38s cubic-bezier(0.16, 1, 0.3, 1)';
    stack.style.height = toHeight + 'px';
  });

  // 6. After morph completes, restore natural height and settle the new view into flow
  kbDelay(function() {
    // Switch new view to natural flow position so stack can size naturally again
    if (newView) newView.className = 'kb-view kb-view-in-settled';
    if (oldView) oldView.className = 'kb-view';
    // Remove explicit height so layout is natural again
    stack.style.transition = 'none';
    stack.style.height = '';
    // Let transition:none take effect before re-enabling
    requestAnimationFrame(function() {
      stack.style.transition = '';
      // Final stable state
      if (newView) newView.className = 'kb-view kb-view-active';
    });
  }, 400);
}

/* ─── Search ─── */

function kbShowSearch() {
  var overlay = document.getElementById('kb-search-overlay');
  if (overlay) overlay.classList.add('kb-search-open');
  // Show results with a delay
  kbDelay(function() {
    var results = document.getElementById('kb-search-results');
    if (results) results.style.opacity = '1';
  }, 300);
}

function kbHideSearch() {
  var overlay = document.getElementById('kb-search-overlay');
  var results = document.getElementById('kb-search-results');
  if (overlay) overlay.classList.remove('kb-search-open');
  if (results) results.style.opacity = '0';
}

/* ─── Inline new task ─── */

function kbShowInlineInput() {
  var input = document.getElementById('kb-inline-input');
  if (input) input.classList.add('kb-visible');
}

function kbHideInlineInput() {
  var input = document.getElementById('kb-inline-input');
  var text = document.getElementById('kb-inline-text');
  if (input) input.classList.remove('kb-visible');
  if (text) {
    text.textContent = 'New task...';
    text.className = 'truncate text-[13px] text-muted-foreground/40';
  }
}

function kbTypeInline(str, cb) {
  var text = document.getElementById('kb-inline-text');
  if (!text) return;
  text.textContent = '';
  text.className = 'truncate text-[13px] text-foreground kb-typing';
  var ci = 0;
  function nextChar() {
    if (kbPaused) return;
    if (ci < str.length) {
      text.textContent = str.substring(0, ci + 1);
      ci++;
      kbDelay(nextChar, 40);
    } else {
      text.className = 'truncate text-[13px] text-foreground';
      if (cb) cb();
    }
  }
  nextChar();
}

/* ─── Full reset ─── */

function kbReset() {
  // Disable transitions on height-changing elements for instant collapse
  var kbBody = document.getElementById('kb-task-body');
  var kbInput = document.getElementById('kb-inline-input');
  if (kbBody) kbBody.style.transition = 'none';
  if (kbInput) kbInput.style.transition = 'none';

  kbSetFocus(null);
  kbHideKeys();
  kbUncompleteTask(2);
  kbResetPriority();
  kbResetToday();
  kbCollapseTask();

  // Reset views — force direct class set without animation
  var stack = document.querySelector('.kb-view-stack');
  if (stack) {
    stack.style.transition = 'none';
    stack.style.height = '';
  }
  for (var j = 0; j < kbViews.length; j++) {
    var v = document.getElementById('kb-view-' + kbViews[j]);
    if (v) v.className = kbViews[j] === 'today' ? 'kb-view kb-view-active' : 'kb-view';
  }
  kbCurrentView = 'today';
  // Reset nav tabs
  for (var i = 0; i < kbTabs.length; i++) {
    var tab = document.getElementById('kb-tab-' + kbTabs[i]);
    if (tab) {
      if (kbTabs[i] === 'today') {
        tab.classList.add('kb-tab-active');
      } else {
        tab.classList.remove('kb-tab-active');
      }
    }
  }

  kbHideSearch();
  kbHideInlineInput();

  var count = document.getElementById('kb-today-count');
  if (count) count.textContent = '3';

  // Re-enable transitions after browser flushes collapsed state
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      if (kbBody) kbBody.style.transition = '';
      if (kbInput) kbInput.style.transition = '';
      if (stack) stack.style.transition = '';
    });
  });
}

/* ═══════════════════════════════════════════════
   Step-based demo runner
   ═══════════════════════════════════════════════ */

function runKbDemo() {
  if (kbPaused) return;

  // Define the full sequence as [delay, action] pairs
  // delay = ms to wait BEFORE this action runs
  var steps = [

    // ── Act 1: Task navigation & operations ──

    // ↓ — focus task 1
    [0, function() {
      kbShowKeys(['\u2193'], 'navigate');
      kbSetFocus(1);
    }],

    // ↓ — focus task 2
    [600, function() {
      kbShowKeys(['\u2193'], 'navigate');
      kbSetFocus(2);
    }],

    // Space — complete task 2
    [700, function() {
      kbShowKeys(['Space'], 'complete');
      kbCompleteTask(2);
    }],

    // ↓ — focus task 3
    [700, function() {
      kbShowKeys(['\u2193'], 'navigate');
      kbSetFocus(3);
    }],

    // P — cycle priority (emerald → amber)
    [700, function() {
      kbShowKeys(['P'], 'priority');
      kbCyclePriority();
    }],

    // P — cycle priority again (amber → rose)
    [500, function() {
      kbShowKeys(['P'], 'priority');
      kbCyclePriority();
    }],

    // T — toggle today bookmark
    [600, function() {
      kbShowKeys(['T'], 'today');
      kbToggleToday();
    }],

    // Enter — expand task 3
    [700, function() {
      kbShowKeys(['Enter'], 'expand');
      kbExpandTask();
    }],

    // Hold expanded
    [900, function() {}],

    // Esc — collapse
    [0, function() {
      kbShowKeys(['Esc'], 'collapse');
      kbCollapseTask();
    }],

    // Brief pause between acts
    [600, function() {
      kbHideKeys();
    }],

    // ── Act 2: View switching ──

    // ⌘2 — switch to Tasks
    [400, function() {
      kbShowKeys(['\u2318', '2'], 'switch view');
      kbSwitchView('tasks');
      kbSetFocus(null);
    }],

    // ⌘3 — switch to Inbox
    [700, function() {
      kbShowKeys(['\u2318', '3'], 'switch view');
      kbSwitchView('inbox');
    }],

    // ⌘1 — switch back to Today
    [700, function() {
      kbShowKeys(['\u2318', '1'], 'switch view');
      kbSwitchView('today');
    }],

    // Brief pause between acts
    [500, function() {
      kbHideKeys();
    }],

    // ── Act 3: Search + New task ──

    // ⌘F — open search
    [400, function() {
      kbShowKeys(['\u2318', 'F'], 'search');
      kbShowSearch();
    }],

    // Hold search
    [1000, function() {}],

    // Esc — close search
    [0, function() {
      kbShowKeys(['Esc'], 'dismiss');
      kbHideSearch();
    }],

    // ⌘N — new task
    [700, function() {
      kbShowKeys(['\u2318', 'N'], 'new task');
      kbShowInlineInput();
    }],

    // Type task title
    [400, function() {
      kbHideKeys();
      kbTypeInline('Prepare meeting agenda', function() {
        // After typing, show Enter to submit
        kbDelay(function() {
          if (kbPaused) return;
          kbShowKeys(['\u21A9'], 'submit');
          // Dismiss inline input
          kbDelay(function() {
            if (kbPaused) return;
            kbHideInlineInput();
            kbHideKeys();
            // Reset and loop
            kbDelay(function() {
              if (kbPaused) return;
              kbReset();
              kbDelay(function() {
                if (!kbPaused) runKbDemo();
              }, 1800);
            }, 1000);
          }, 600);
        }, 500);
      });
    }],
  ];

  // Run steps sequentially
  var stepIdx = 0;
  function runStep() {
    if (kbPaused || stepIdx >= steps.length) return;
    var delay = steps[stepIdx][0];
    var action = steps[stepIdx][1];
    stepIdx++;
    kbDelay(function() {
      if (kbPaused) return;
      action();
      // Continue to next step (unless it's the last step — typing handles its own continuation)
      if (stepIdx < steps.length) {
        runStep();
      }
    }, delay);
  }
  runStep();
}

/* ─── Auto-play API ─── */

function startKbAutoPlay() {
  kbPaused = false;
  kbDelay(runKbDemo, 1200);
}

function stopKbAutoPlay() {
  kbPaused = true;
  kbClearTimers();
  kbReset();
}

window.startKbAutoPlay = startKbAutoPlay;
window.stopKbAutoPlay = stopKbAutoPlay;
</script>

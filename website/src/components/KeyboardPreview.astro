---
// KeyboardPreview — Comprehensive keyboard-first showcase
// Demonstrates: task navigation, single-key ops (Space/P/Enter/Esc),
// view switching (⌘1-3), search (⌘F), new task (⌘N)
// References: useKeyboardShortcuts.ts, useTaskListKeyboard.ts, taskConstants.ts
---

<section id="kb-section" data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section label -->
    <div class="mb-8 flex flex-col items-center text-center">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[10px] tabular-nums text-muted-foreground/25">05</span>
        <span class="h-px w-4 border-t border-dashed border-border/60"></span>
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Mouse Not Required</h2>
      </div>
      <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/40">
        Arrows to navigate, Space to complete, P to cycle priority, Enter to expand. Every action is a keypress. The mouse is there if you want it.
      </p>
    </div>

    <!-- Window frame -->
    <div class="overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FEBC2E]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80"></span>
        </div>
        <div class="flex-1"></div>
        <nav class="relative flex items-center gap-0.5">
          <span id="kb-tab-today" class="kb-tab kb-tab-active rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em]">Today</span>
          <span id="kb-tab-tasks" class="kb-tab rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em]">Tasks</span>
          <span id="kb-tab-inbox" class="kb-tab rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em]">Inbox</span>
          <span id="kb-tab-notes" class="kb-tab rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em]">Notes</span>
        </nav>
      </header>

      <!-- ═══ Content area ═══ -->
      <div class="relative flex flex-col overflow-hidden p-3" style="min-height: 520px;">

        <!-- View stack — grid overlay for smooth crossfade without layout shifts -->
        <div class="kb-view-stack flex-1">

        <!-- ── Today view content ── -->
        <div id="kb-view-today" class="kb-view kb-view-active">
          <div class="mx-auto flex max-w-3xl flex-col gap-3">

            <!-- ═══ SectionGroup: Today (expanded, 3 tasks) ═══ -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">Today</span>
                  <span id="kb-today-count" class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
                </div>
                <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </span>
              </div>

              <div class="border-t border-border/60 px-1 py-1">

                <!-- ═══ Inline new task input (hidden, appears on ⌘N) ═══ -->
                <div id="kb-inline-input" class="kb-inline-input overflow-hidden border-b border-border/40">
                  <div class="flex min-h-10 items-center gap-2 px-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex size-6 items-center justify-center">
                        <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
                      </span>
                      <span class="size-[5px] rounded-full bg-foreground/15"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p id="kb-inline-text" class="truncate text-[13px] text-muted-foreground/40">New task...</p>
                    </div>
                  </div>
                </div>

                <!-- ═══ TaskItem 1: Review pitch deck (amber, time badge) ═══ -->
                <div id="kb-task-1" class="overflow-hidden border-b border-border/40 transition-colors duration-200">
                  <div class="flex min-h-10 items-center gap-2 px-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex size-6 items-center justify-center">
                        <span class="kb-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                          <svg class="kb-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        </span>
                      </span>
                      <span class="size-[5px] rounded-full bg-amber-500 transition-colors duration-300"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="kb-title truncate text-[13px] text-foreground transition-all duration-300">Review pitch deck</p>
                    </div>
                    <div class="ml-auto flex items-center gap-1">
                      <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">3 PM</span>
                      <span class="inline-flex size-6 items-center justify-center text-foreground">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                      </span>
                      <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- ═══ TaskItem 2: Send recap to the team (no priority) ═══ -->
                <div id="kb-task-2" class="overflow-hidden border-b border-border/40 transition-colors duration-200">
                  <div class="flex min-h-10 items-center gap-2 px-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex size-6 items-center justify-center">
                        <span class="kb-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                          <svg class="kb-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        </span>
                      </span>
                      <span class="size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="kb-title truncate text-[13px] text-foreground transition-all duration-300">Send recap to the team</p>
                    </div>
                    <div class="ml-auto flex items-center gap-1">
                      <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                      </span>
                      <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- ═══ TaskItem 3: Draft newsletter intro (emerald, expandable) ═══ -->
                <div id="kb-task-3" class="overflow-hidden transition-colors duration-200">
                  <div class="flex min-h-10 items-center gap-2 px-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex size-6 items-center justify-center">
                        <span class="kb-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                          <svg class="kb-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        </span>
                      </span>
                      <span id="kb-priority-dot" class="size-[5px] rounded-full bg-emerald-500 transition-colors duration-300"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="kb-title truncate text-[13px] text-foreground transition-all duration-300">Draft newsletter intro</p>
                    </div>
                    <div class="ml-auto flex items-center gap-1">
                      <span id="kb-today-toggle" class="inline-flex size-6 items-center justify-center text-muted-foreground transition-colors duration-200">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                      </span>
                      <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                      </span>
                    </div>
                  </div>

                  <!-- ═══ Expanded task body (hidden by default) ═══ -->
                  <div id="kb-task-body" class="kb-task-body">
                    <!-- Body editor placeholder -->
                    <div class="border-t border-border/30 px-3 py-2.5">
                      <p class="text-[12px] leading-relaxed text-muted-foreground/40">Add notes or details...</p>
                    </div>

                    <!-- Metadata line -->
                    <div class="flex items-center gap-1 border-t border-border/30 px-3 py-1.5">
                      <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] text-muted-foreground/50">
                        <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                        Feb 21
                      </span>
                      <span class="text-[10px] text-muted-foreground/20">&middot;</span>
                      <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] text-muted-foreground/50">
                        <span id="kb-meta-dot" class="inline-block size-1.5 rounded-full bg-emerald-500 transition-colors duration-300"></span>
                        <span id="kb-meta-label">Low</span>
                      </span>
                      <span class="text-[10px] text-muted-foreground/20">&middot;</span>
                      <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] text-muted-foreground/50">
                        <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" /><path d="m9 12 2 2 4-4" /></svg>
                        Backlog
                      </span>
                    </div>

                    <!-- Subtasks -->
                    <div class="px-3 pb-2">
                      <div class="flex min-h-7 items-center gap-2 pl-2">
                        <span class="inline-flex size-5 items-center justify-center">
                          <span class="inline-flex size-3.5 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
                        </span>
                        <p class="text-[12px] text-foreground/70">Write opening paragraph</p>
                      </div>
                      <div class="flex min-h-7 items-center gap-2 pl-2">
                        <span class="inline-flex size-5 items-center justify-center">
                          <span class="inline-flex size-3.5 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
                        </span>
                        <p class="text-[12px] text-foreground/70">Add product highlights</p>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </section>

            <!-- ═══ SectionGroup: Done today (collapsed) ═══ -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">Done today</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">1</span>
                </div>
              </div>
            </section>
          </div>
        </div>

        <!-- ── Tasks view content ── -->
        <div id="kb-view-tasks" class="kb-view">
          <div class="mx-auto flex max-w-3xl flex-col gap-3">

            <!-- Backlog section -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">Backlog</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
                </div>
                <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </span>
              </div>
              <div class="border-t border-border/60 px-1 py-1">
                <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-rose-500"></span>
                  <p class="truncate text-[13px] text-foreground">Update pricing page</p>
                </div>
                <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-amber-500"></span>
                  <p class="truncate text-[13px] text-foreground">Fix onboarding flow</p>
                </div>
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  <p class="truncate text-[13px] text-foreground">Research competitor features</p>
                </div>
              </div>
            </section>

            <!-- In Progress section -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">In Progress</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">2</span>
                </div>
                <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </span>
              </div>
              <div class="border-t border-border/60 px-1 py-1">
                <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-amber-500"></span>
                  <p class="truncate text-[13px] text-foreground">Review pitch deck</p>
                </div>
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-emerald-500"></span>
                  <p class="truncate text-[13px] text-foreground">Draft newsletter intro</p>
                </div>
              </div>
            </section>

            <!-- On Hold section -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">On Hold</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">1</span>
                </div>
                <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </span>
              </div>
              <div class="border-t border-border/60 px-1 py-1">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  <p class="truncate text-[13px] text-foreground">Reach out to partners</p>
                </div>
              </div>
            </section>

            <!-- Done section (collapsed) -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">Done</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">12</span>
                </div>
              </div>
            </section>
          </div>
        </div>

        <!-- ── Inbox view content ── -->
        <div id="kb-view-inbox" class="kb-view">
          <div class="mx-auto flex max-w-3xl flex-col gap-3">

            <!-- Inbox section -->
            <section class="rounded-md border border-border/60">
              <div class="flex items-center px-2 py-2">
                <div class="flex min-w-0 flex-1 items-center gap-2">
                  <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                  <span class="text-[12px] font-medium text-foreground">Inbox</span>
                  <span class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
                </div>
                <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </span>
              </div>
              <div class="border-t border-border/60 px-1 py-1">
                <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  <p class="truncate text-[13px] text-foreground">Check email from vendor</p>
                </div>
                <div class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  <p class="truncate text-[13px] text-foreground">Look into new analytics tool</p>
                </div>
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span></span>
                  <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  <p class="truncate text-[13px] text-foreground">Schedule dentist appointment</p>
                </div>
              </div>
            </section>
          </div>
        </div>

        </div><!-- end .kb-view-stack -->

        <!-- ═══ Search overlay ═══ -->
        <div id="kb-search-overlay"
             class="pointer-events-none absolute inset-0 z-10 flex items-start justify-center opacity-0"
             style="background: color-mix(in srgb, var(--background) 50%, transparent); backdrop-filter: blur(3px); padding-top: 12%; transition: opacity 0.2s;">

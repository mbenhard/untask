---
// Tech stack — spec-sheet with SettingsRow-style divide-y separators
const stack = [
  { label: 'Runtime', value: 'Electron + React + TypeScript' },
  { label: 'Database', value: 'SQLite (better-sqlite3 + Drizzle)' },
  { label: 'AI', value: 'Vercel AI SDK, multi-provider' },
  { label: 'State', value: 'Zustand' },
  { label: 'Styling', value: 'Tailwind CSS' },
  { label: 'Editor', value: 'BlockNote' },
  { label: 'Privacy', value: 'Zero telemetry — all data stays on your machine' },
  { label: 'Storage', value: '~/Library/Application Support/Untask/' },
  { label: 'License', value: 'MIT — fully open source' },
  { label: 'Platform', value: 'macOS (Apple Silicon & Intel)' },
];
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl">

    <!-- Section header -->
    <div class="mb-8">
      <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
        Stack
      </h2>
      <div class="mt-3 border-t border-border"></div>
    </div>

    <!-- Spec sheet with hairline dividers -->
    <div class="divide-y divide-border/40">
      {stack.map((item) => (
        <div class="flex items-baseline gap-8 py-2.5">
          <span class="w-24 shrink-0 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground">
            {item.label}
          </span>
          <span class="text-[13px] text-foreground">
            {item.value}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

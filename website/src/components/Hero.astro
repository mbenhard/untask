---
// Hero section — full viewport, centered, maximum negative space
// Uses actual bird mascot from /icons/animation with peppy wobble (v3)
---

<section class="relative flex min-h-screen flex-col items-center justify-center px-6">
  <div class="flex max-w-lg flex-col items-center text-center">

    <!-- Bird mascot (peppy wobble v3 — click for surprise!) -->
    <div class="mascot mb-8" role="button" tabindex="0" aria-label="Click me!" onclick="birdBounce(this)" onkeydown="if(event.key==='Enter')birdBounce(this)">
      <div class="mascot-body">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.89 166.04">
          <path fill="currentColor" d="M120.39,36.58c1.07-.22,1.56-.39,2.49-1.01-15.26-5.36-30.9-9.88-46.49-14.2C75.08,3.55,51.53-5.85,37.12,3.96c-13.89,9.55-12.2,28.04-16.23,42.7-5.67,28.52-11.32,57.04-17,85.55-3.1,15.47-11.57,36.65,13.69,33.52,16.92-.48,33.84-1.07,50.75-1.85,22.47-.89,39.64,3.24,30.44-26.67-6.31-30.86-12.58-61.72-18.81-92.6,13.56-2.23,26.95-5.41,40.44-8.03ZM59.02,23.22c-.01,9.92-15.48,8.5-13.45-1.25,1.54-7.53,13.49-6.61,13.45,1.25Z"/>
        </svg>
      </div>
      <div class="mascot-feet">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40.72 50.38">
          <path fill="currentColor" d="M1.94,47.87c.23-.13.45-.26.69-.4.41-.22.83-.44,1.25-.65,0-.23,0-.46,0-.7.03-5.6.07-11.19.11-16.79.02-2.71.04-5.41.05-8.12.01-2.36.03-4.72.05-7.08,0-1.25.02-2.5.02-3.75,0-1.18.01-2.35.02-3.53,0-.64,0-1.27.01-1.91,0-.38,0-.76,0-1.15,0-.33,0-.66,0-1q.02-.94.37-2.15c1.17,0,2.34,0,3.55,0,.26,5.66.39,11.31.42,16.98,0,.82.01,1.64.02,2.46.02,1.91.03,3.83.04,5.74.02,2.19.03,4.37.05,6.56.04,4.48.07,8.97.1,13.45,1.37-.27,2.73-.56,4.1-.85.39-.08.77-.15,1.17-.23q3.2-.7,4.14-1.86c.2-.31.4-.62.6-.94q1.22-.75,2.58-.97c0-.37,0-.74,0-1.13,0-3.55-.01-7.1-.01-10.65,0-1.82,0-3.65,0-5.47q-.04-9.78.17-19.55.02-.55.04-1.1,0-1.6.47-3.09,1.64-.04,3.23.32c.4.8.36,1.32.36,2.21,0,.33,0,.66,0,1,0,.36,0,.73,0,1.1,0,.38,0,.76,0,1.15,0,1.05,0,2.09,0,3.14,0,1.09,0,2.19,0,3.28,0,2.07,0,4.14,0,6.21,0,2.36,0,4.71,0,7.07,0,4.85,0,9.7-.02,14.55.28-.07.55-.14.83-.22,1.02-.27,2.05-.53,3.08-.78.44-.11.89-.23,1.33-.34.64-.17,1.28-.33,1.92-.49.38-.1.77-.2,1.16-.3,1.14-.15,1.66-.05,2.66.51q.59.81.97,1.61c-1.59.57-3.19.95-4.84,1.29q.56.02,1.13.04c.5.02.99.04,1.49.06.25,0,.49.01.74.02,1.57.07,2.7.3,4.06,1.17q.74.91.65,1.94-10.55.16-21.31.32c.21.43.43.85.65,1.29-1.18.41-2.32.75-3.55.97.96.32,1.7.39,2.7.44,1.37.12,2.37.22,3.43,1.17.21.53.43,1.07.65,1.61-7.67,0-15.34,0-23.24,0q.63-1.66,1.94-2.5Z"/>
        </svg>
      </div>
      <div class="mascot-shadow"></div>
    </div>

    <h1 class="font-sans text-4xl font-normal tracking-tight text-foreground sm:text-5xl">
      Untask
    </h1>

    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted-foreground sm:text-base">
      No cloud. No cost. No surveillance.<br class="hidden sm:inline" />
      An open-source task manager with AI built in.
    </p>

    <div class="mt-8 flex items-center gap-2.5">
      <a
        href="https://github.com/mbenhard/untask/releases/latest"
        class="inline-flex h-8 items-center rounded-md bg-primary px-4 text-[12px] font-medium text-primary-foreground transition-opacity hover:opacity-80"
      >
        Download for macOS
      </a>
      <a
        href="https://github.com/mbenhard/untask"
        class="inline-flex h-8 items-center rounded-md border border-border px-4 text-[12px] font-medium text-foreground transition-colors hover:bg-accent"
      >
        GitHub
      </a>
    </div>

    <!-- macOS Dock -->
    <div class="dock-region mt-6">
      <div class="dock-shelf">
        <div class="dock-bar" id="macos-dock">
          <div class="dock-item" data-dock-icon>
            <div class="dock-icon-inner"><div class="dock-ghost" style="--go:0.04"></div></div>
          </div>
          <div class="dock-item" data-dock-icon>
            <div class="dock-icon-inner"><div class="dock-ghost" style="--go:0.06"></div></div>
          </div>
          <div class="dock-item dock-app" data-dock-icon>
            <div class="dock-icon-inner">
              <a href="https://github.com/mbenhard/untask/releases/latest" class="dock-app-icon" aria-label="Download Untask for macOS">
                <img src="/icon-app.png" alt="Untask" width="40" height="40" draggable="false" />
              </a>
            </div>
            <span class="dock-tooltip">Untask</span>
          </div>
          <div class="dock-item" data-dock-icon>
            <div class="dock-icon-inner"><div class="dock-ghost" style="--go:0.05"></div></div>
          </div>
          <div class="dock-item" data-dock-icon>
            <div class="dock-icon-inner"><div class="dock-ghost" style="--go:0.035"></div></div>
          </div>
        </div>
        <div class="dock-dot-row">
          <span class="dock-dot"></span>
        </div>
      </div>
    </div>

    <!-- Copy install command -->
    <button
      onclick="copyInstall(this)"
      class="group mt-5 inline-flex h-7 cursor-pointer items-center gap-2 rounded-md border border-border/40 px-3 font-mono text-[11px] text-muted-foreground/70 transition-colors hover:border-border hover:text-foreground"
      aria-label="Copy install command"
    >
      <span class="select-all">brew install --cask mbenhard/untask/untask</span>
      <!-- Copy icon -->
      <svg id="copy-icon" class="size-3 shrink-0 opacity-40 transition-opacity group-hover:opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <!-- Check icon (hidden, shown on copy) -->
      <svg id="copy-check" class="hidden size-3 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </button>

    <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.08em] text-muted-foreground">
      MIT Licensed &middot; macOS
    </p>
  </div>

  <!-- Scroll hint -->
  <div class="scroll-hint absolute bottom-8 text-muted-foreground/40" aria-hidden="true">
    <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
      <path d="M8 4v12M4 12l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<style>
  /*
   * Bird mascot — peppy wobble (v3: 1.2s)
   * Exact bop.html structure, scaled 0.38x (body 95→36px)
   */
  .mascot {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  /* Click: elastic snap (v5 from bop.html, scaled 0.38x) */
  .mascot.bounce .mascot-body {
    animation: bird-snap 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes bird-snap {
    0%   { transform: translateY(0) scaleX(1) scaleY(1); }
    8%   { transform: translateY(0.8px) scaleX(1.06) scaleY(0.94); }
    30%  { transform: translateY(-5.3px) scaleX(0.94) scaleY(1.06); }
    52%  { transform: translateY(0.8px) scaleX(1.04) scaleY(0.96); }
    68%  { transform: translateY(-1.1px) scaleX(0.98) scaleY(1.02); }
    82%  { transform: translateY(0.2px) scaleX(1.01) scaleY(0.99); }
    100% { transform: translateY(0) scaleX(1) scaleY(1); }
  }

  .mascot-body {
    width: 36px;
    position: relative;
    z-index: 2;
    transform-origin: center bottom;
    margin-bottom: -4px;
    animation: wobble-body 1.2s ease-in-out infinite;
  }

  /* Match bop.html: SVG fills container, container controls size */
  .mascot-body svg,
  .mascot-feet svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .mascot-feet {
    width: 12px;
    position: relative;
    z-index: 1;
  }

  .mascot-shadow {
    width: 14px;
    height: 3px;
    background: radial-gradient(ellipse, rgba(255,255,255,0.08) 0%, transparent 70%);
    border-radius: 50%;
    margin-top: 1px;
    animation: wobble-shadow 1.2s ease-in-out infinite;
  }

  :root .mascot-shadow {
    background: radial-gradient(ellipse, rgba(0,0,0,0.12) 0%, transparent 70%);
  }

  /* v3 peppy wobble — translateY scaled 0.38x: -9→-3.5px */
  @keyframes wobble-body {
    0%   { transform: translateY(0) rotate(0deg); }
    25%  { transform: translateY(-3.5px) rotate(2.5deg); }
    50%  { transform: translateY(0) rotate(0deg); }
    75%  { transform: translateY(-3.5px) rotate(-2.5deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  .mascot.bounce .mascot-shadow {
    animation: bird-snap-shadow 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes bird-snap-shadow {
    0%   { transform: scaleX(1); opacity: 0.35; }
    8%   { transform: scaleX(0.8); opacity: 0.55; }
    30%  { transform: scaleX(1.5); opacity: 0.08; }
    52%  { transform: scaleX(0.85); opacity: 0.5; }
    68%  { transform: scaleX(1.1); opacity: 0.25; }
    82%  { transform: scaleX(0.95); opacity: 0.38; }
    100% { transform: scaleX(1); opacity: 0.35; }
  }

  .scroll-hint {
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(6px); }
  }

  @keyframes wobble-shadow {
    0%   { transform: scaleX(1) translateX(0); opacity: 0.35; }
    25%  { transform: scaleX(1.15) translateX(0.5px); opacity: 0.18; }
    50%  { transform: scaleX(1) translateX(0); opacity: 0.35; }
    75%  { transform: scaleX(1.15) translateX(-0.5px); opacity: 0.18; }
    100% { transform: scaleX(1) translateX(0); opacity: 0.35; }
  }

  /* ─── macOS Dock ─── */

  .dock-region {
    position: relative;
  }

  .dock-shelf {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 28px;
  }

  .dock-bar {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    padding: 4px 8px;
    border-radius: 16px;
    overflow: visible;
    position: relative;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  :global(.dark) .dock-bar {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 0.5px rgba(255, 255, 255, 0.04);
  }

  .dock-item {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: visible;
  }

  .dock-icon-inner {
    width: 100%;
    height: 100%;
    transform-origin: bottom center;
    transition: transform 0.2s ease;
    will-change: transform;
  }

  .dock-ghost {
    width: 100%;
    height: 100%;
    border-radius: 9px;
    background: rgb(0 0 0 / var(--go, 0.04));
  }

  :global(.dark) .dock-ghost {
    background: rgb(255 255 255 / var(--go, 0.04));
  }

  .dock-app {
    position: relative;
  }

  .dock-app-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dock-app-icon img {
    width: 100%;
    height: 100%;
    border-radius: 9px;
    display: block;
  }

  .dock-tooltip {
    position: absolute;
    bottom: calc(100% + 40px);
    left: 50%;
    transform: translateX(-50%) scale(0.96);
    padding: 3px 10px;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--accent);
    color: var(--foreground);
    border: 0.5px solid var(--border);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .dock-app:hover .dock-tooltip {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transition: opacity 0.15s ease 0.4s, transform 0.15s ease 0.4s;
  }

  .dock-dot-row {
    display: flex;
    justify-content: center;
    margin-top: 4px;
    height: 4px;
  }

  .dock-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0.4;
  }

  /* Entrance bounce — like a freshly installed app */
  @keyframes dock-install {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(-14px); }
    50%  { transform: translateY(0); }
    65%  { transform: translateY(-6px); }
    80%  { transform: translateY(0); }
    90%  { transform: translateY(-2px); }
    100% { transform: translateY(0); }
  }

  .dock-app .dock-icon-inner {
    animation: dock-install 0.7s cubic-bezier(0.22, 1, 0.36, 1) 2s both;
  }
</style>

<script is:inline>
  function birdBounce(el) {
    if (el.classList.contains('bounce')) return;
    el.classList.add('bounce');
    el.addEventListener('animationend', function handler() {
      el.classList.remove('bounce');
      el.removeEventListener('animationend', handler);
    }, { once: false });
    // Fallback removal in case animationend doesn't fire
    setTimeout(function() { el.classList.remove('bounce'); }, 1100);
  }

  function copyInstall(btn) {
    navigator.clipboard.writeText('brew install --cask mbenhard/untask/untask').then(function() {
      var icon = document.getElementById('copy-icon');
      var check = document.getElementById('copy-check');
      icon.classList.add('hidden');
      check.classList.remove('hidden');
      setTimeout(function() {
        icon.classList.remove('hidden');
        check.classList.add('hidden');
      }, 1500);
    });
  }

  // macOS dock magnification
  (function() {
    if (window.matchMedia && !window.matchMedia('(hover: hover)').matches) return;
    var dock = document.getElementById('macos-dock');
    if (!dock) return;
    var items = Array.prototype.slice.call(dock.querySelectorAll('[data-dock-icon]'));
    var maxScale = 1.8;
    var range = 150;

    dock.addEventListener('mousemove', function(e) {
      items.forEach(function(item) {
        var rect = item.getBoundingClientRect();
        var center = rect.left + rect.width / 2;
        var dist = Math.abs(e.clientX - center);
        var inner = item.querySelector('.dock-icon-inner');
        if (!inner) return;
        if (dist < range) {
          var s = 1 + (maxScale - 1) * Math.cos((dist / range) * (Math.PI / 2));
          inner.style.transform = 'scale(' + s.toFixed(3) + ')';
        } else {
          inner.style.transform = '';
        }
      });
    });

    dock.addEventListener('mouseleave', function() {
      items.forEach(function(item) {
        var inner = item.querySelector('.dock-icon-inner');
        if (inner) inner.style.transform = '';
      });
    });
  })();
</script>

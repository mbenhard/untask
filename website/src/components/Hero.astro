---
// Hero section — full viewport, centered, maximum negative space
import BirdMascot from './BirdMascot.astro';
import { version } from '../config';
---

<section data-reveal class="relative flex min-h-[calc(100vh-5rem)] flex-col items-center justify-center px-6">
  <div data-thread-content class="flex max-w-lg flex-col items-center text-center">

    <!-- Bird mascot -->
    <div class="mb-6">
      <BirdMascot />
    </div>

    <!-- Version badge -->
    <a
      href="/changelog"
      class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-border/40 px-3 py-1 font-mono text-[11px] text-muted-foreground/60 transition-colors hover:border-border hover:text-muted-foreground"
    >
      <span class="text-foreground/80">{version}</span>
      <span class="text-muted-foreground/30">&middot;</span>
      What's new
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <h1 class="font-sans text-4xl font-normal tracking-tight text-foreground sm:text-5xl">
      Untask
    </h1>

    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted-foreground sm:text-base">
      No cloud. No tracking. Open source.<br />
      A task manager with AI — on your terms.<br class="sm:hidden" /> <span class="hidden sm:inline">Or not at all.</span><span class="sm:hidden">Or not at all.</span>
    </p>

    <div class="mt-8 flex items-center gap-2.5">
      <a
        href="#download"
        class="inline-flex h-8 items-center rounded-md bg-primary px-4 text-[12px] font-medium text-primary-foreground transition-opacity hover:opacity-80"
      >
        Download for macOS
      </a>
      <a
        href="https://github.com/mbenhard/untask"
        class="inline-flex h-8 items-center rounded-md border border-dashed border-border/60 px-4 text-[12px] font-medium text-muted-foreground transition-colors hover:border-border hover:text-foreground"
      >
        GitHub
      </a>
    </div>

    <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground/50">
      Free &middot; MIT Licensed &middot; macOS only
    </p>
  </div>

  <!-- Scroll hint -->
  <div class="scroll-hint absolute bottom-6 text-muted-foreground/30" aria-hidden="true">
    <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
      <path d="M8 4v12M4 12l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<style>
  .scroll-hint {
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(6px); }
  }
</style>

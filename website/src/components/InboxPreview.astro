---
// InboxPreview — 1:1 CSS recreation of inbox view + Quick Add sequential animation
// References: InboxView.tsx, SectionGroup.tsx, TaskItem.tsx, QuickAddApp.tsx
---

<section id="inbox-section" data-reveal class="px-6 py-24 sm:py-32">
  <div data-thread-content class="mx-auto max-w-2xl">

    <!-- Section label -->
    <div class="mb-8 flex flex-col items-center text-center">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[10px] tabular-nums text-muted-foreground/25">01</span>
        <span class="h-px w-4 border-t border-dashed border-border/60"></span>
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">Fast by Default</h2>
      </div>
      <p class="mt-2 max-w-sm text-[13px] leading-relaxed text-muted-foreground/40">
        A shortcut from anywhere drops you into the inbox. Type the task, hit Enter, keep going. Structure is optional. Add it when it earns its place.
      </p>
    </div>

    <!-- Window frame -->
    <div class="overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FEBC2E]/80"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80"></span>
        </div>
        <div class="flex-1"></div>
        <nav class="flex items-center gap-0.5">
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Today</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Tasks</span>
          <span class="rounded-lg bg-accent px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-foreground">Inbox</span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">Notes</span>
        </nav>
      </header>

      <!-- ═══ Content area ═══ -->
      <div class="relative flex flex-col p-3" style="min-height: 380px;">

        <!-- Demo cursor -->
        <div id="inbox-cursor" class="pointer-events-none absolute z-30 opacity-0" style="top: 0; left: 0; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s; will-change: transform;">
          <div id="inbox-cursor-inner" style="transition: transform 0.1s;">
            <img src="/cursor-default.svg" width="24" height="30" alt="" />
          </div>
        </div>

        <!-- ═══ Quick Add Overlay ═══ -->
        <div id="inbox-qa-overlay">
          <div id="inbox-qa-panel" class="relative w-[85%] max-w-sm rounded-xl border border-border/70 bg-card shadow-[0_16px_40px_-12px_rgba(0,0,0,0.4)]">

            <!-- Collapsed input row -->
            <div class="flex items-center gap-2 px-3 py-2.5">
              <!-- Checkbox ghost -->
              <span class="inline-flex size-5 shrink-0 items-center justify-center">
                <span class="inline-flex size-3.5 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
              </span>
              <!-- Priority dot -->
              <span id="inbox-qa-dot" class="size-[5px] shrink-0 rounded-full transition-colors duration-200" style="background-color: color-mix(in srgb, var(--foreground) 15%, transparent);"></span>
              <!-- Input -->
              <span id="inbox-qa-input" class="min-w-0 flex-1 text-[13px] text-foreground">&nbsp;</span>
              <!-- Keyboard hints -->
              <div class="flex shrink-0 items-center gap-1.5">
                <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground/40">tab</span>
                <span class="font-mono text-[10px] text-muted-foreground/40">&crarr;</span>
              </div>
            </div>

            <!-- Metadata row (hidden initially) -->
            <div id="inbox-qa-meta">
              <div class="flex items-center gap-2 border-t px-3 py-1.5 font-mono text-[11px]" style="border-color: color-mix(in srgb, var(--border) 40%, transparent);">
                <span class="inline-flex items-center gap-1.5">
                  <span class="size-[5px] rounded-full bg-rose-500"></span>
                  <span class="text-foreground">High</span>
                </span>
                <span class="text-border select-none">&middot;</span>
                <span class="text-muted-foreground/50">due date</span>
                <span class="text-border select-none">&middot;</span>
                <span class="text-muted-foreground/50">today</span>
              </div>
            </div>

            <!-- Slash command popover -->
            <div id="inbox-qa-popover">
              <div class="flex items-center gap-2 rounded-t-lg bg-accent px-3 py-1.5 text-[13px]">
                <span class="font-mono text-[11px] text-muted-foreground">/p</span>
                <span class="text-foreground">Priority</span>
                <span class="ml-auto font-mono text-[11px] text-muted-foreground/60">high, med, low</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 text-[13px]">
                <span class="font-mono text-[11px] text-muted-foreground">/due</span>
                <span class="text-muted-foreground">Due date</span>
              </div>
              <div class="flex items-center gap-2 rounded-b-lg px-3 py-1.5 text-[13px]">
                <span class="font-mono text-[11px] text-muted-foreground">/today</span>
                <span class="text-muted-foreground">Today</span>
              </div>
            </div>

          </div>
        </div>

        <div class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-3">

          <!-- SectionGroup: Inbox -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">Inbox</span>
                <span id="inbox-count" class="ml-auto font-mono text-[11px] text-muted-foreground">4</span>
              </div>
              <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </span>
            </div>

            <div id="inbox-task-list" class="border-t border-border/60 px-1 py-1">

              <!-- Input row — matches app's InlineTaskInput exactly -->
              <div id="inbox-input-row" class="flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5">
                <span class="inline-flex size-6 items-center justify-center">
                  <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
                </span>
                <span class="size-[5px] rounded-full bg-foreground/15"></span>
                <input id="inbox-input" type="text" class="min-w-0 flex-1 bg-transparent text-[13px] text-foreground outline-none placeholder:text-muted-foreground/40" placeholder="Type to capture..." autocomplete="off" spellcheck="false" onkeydown="inboxHandleKey(event)" onfocus="pauseInboxAutoPlay()" />
              </div>

              <!-- Inbox task 1 -->
              <div id="inbox-t1" class="inbox-task-item overflow-hidden border-b border-border/40">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                        <svg class="size-2.5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[13px] text-foreground">Send recap to the team</p>
                  </div>
                  <div class="ml-auto flex items-center gap-1">
                    <span id="inbox-t1-bookmark" class="inline-flex size-6 items-center justify-center text-muted-foreground transition-colors duration-300">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Inbox task 2 -->
              <div id="inbox-t2" class="inbox-task-item overflow-hidden border-b border-border/40">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                        <svg class="size-2.5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span id="inbox-t2-dot" class="size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[13px] text-foreground">Try that new design tool</p>
                  </div>
                  <div class="ml-auto flex items-center gap-1">
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Inbox task 3 -->
              <div class="inbox-task-item overflow-hidden border-b border-border/40">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                        <svg class="size-2.5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span class="size-[5px] rounded-full bg-foreground/15"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[13px] text-foreground">Gift idea for Mom's birthday</p>
                  </div>
                  <div class="ml-auto flex items-center gap-1">
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Inbox task 4 (last — no bottom border) -->
              <div id="inbox-t4" class="inbox-task-item overflow-hidden" style="transition: max-height 0.5s ease, opacity 0.5s ease;">
                <div class="flex min-h-10 items-center gap-2 px-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span id="inbox-t4-circle" class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35)); transition: border-style 0.3s, border-color 0.3s, background-color 0.3s;">
                        <svg id="inbox-t4-check" class="size-2.5" style="opacity: 0; transition: opacity 0.3s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span id="inbox-t4-dot" class="size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p id="inbox-t4-title" class="truncate text-[13px] text-foreground transition-all duration-300">Research flights for conference</p>
                  </div>
                  <div class="ml-auto flex items-center gap-1">
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

            </div>
          </section>
        </div>

        <!-- ═══ Bottom bar ═══ -->
        <div class="mt-auto pt-3 flex items-center gap-2">
          <div class="flex shrink-0 items-center gap-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
            <span class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.293 2.293a1 1 0 0 1 1.414 0l2.5 2.5 5.994 1.227a1 1 0 0 1 .506 1.687l-7 7a1 1 0 0 1-1.687-.506l-1.227-5.994-2.5-2.5a1 1 0 0 1 0-1.414z" />
                <path d="m14.207 4.793-3.414 3.414" />
                <path d="M3 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                <path d="m9.086 6.5-4.793 4.793a1 1 0 0 0-.18 1.17L7 18" />
              </svg>
            </span>
          </div>
          <div class="flex-1"></div>
          <div class="flex h-8 w-14 items-center justify-center rounded-md border border-border/60 bg-background/90 text-[10px] font-medium tracking-wide text-muted-foreground shadow-lg backdrop-blur-sm">
            Chat
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── Quick Add Overlay ─── */

  #inbox-qa-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18%;
    background: color-mix(in srgb, var(--background) 40%, transparent);
    backdrop-filter: blur(2px);
    border-radius: 0 0 0.75rem 0.75rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #inbox-qa-panel {
    transform: scale(0.9);
    opacity: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
  }

  #inbox-qa-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  #inbox-qa-panel.visible {
    transform: scale(1);
    opacity: 1;
  }

  #inbox-qa-meta {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.2s ease, opacity 0.2s;
  }

  #inbox-qa-meta.expanded {
    max-height: 40px;
    opacity: 1;
  }

  #inbox-qa-popover {
    position: absolute;
    left: 12px;
    right: 12px;
    top: calc(100% + 4px);
    z-index: 50;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    background: color-mix(in srgb, var(--background) 95%, transparent);
    backdrop-filter: blur(20px);
    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  #inbox-qa-popover.visible {
    opacity: 1;
  }

  /* ─── Blinking cursor for Quick Add input ─── */

  #inbox-qa-input::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 14px;
    background: var(--foreground);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: qa-blink 1s step-end infinite;
  }

  #inbox-qa-input.typing::after {
    animation: none;
    opacity: 1;
  }

  #inbox-qa-input.done::after {
    display: none;
  }

  @keyframes qa-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ─── Triage / Complete animations ─── */

  @keyframes inbox-glow {
    0% { background-color: transparent; }
    30% { background-color: color-mix(in srgb, var(--foreground) 4%, transparent); }
    100% { background-color: transparent; }
  }

  .inbox-glow {
    animation: inbox-glow 1s ease;
  }
</style>

<script is:inline>
var inboxPauseTimer = null;
var inboxMaxItems = 6;

// ─── Manual input handling (kept for interactive use) ───

function inboxHandleKey(e) {
  if (e.key === 'Enter') {
    var val = e.target.value.trim();
    if (!val) return;
    inboxAddTask(val);
    e.target.value = '';
    pauseInboxAutoPlay();
  }
}

function inboxAddTask(text, priorityColor) {
  var list = document.getElementById('inbox-task-list');
  if (!list) return;
  var items = list.querySelectorAll('.inbox-task-item');
  if (items.length >= inboxMaxItems) {
    items[items.length - 1].remove();
  }
  var dotColor = priorityColor || 'color-mix(in srgb, var(--foreground) 15%, transparent)';
  var row = document.createElement('div');
  row.className = 'inbox-task-item inbox-qa-added overflow-hidden border-b border-border/40';
  row.style.maxHeight = '0';
  row.style.opacity = '0';
  row.style.transition = 'max-height 0.3s ease, opacity 0.3s';
  row.innerHTML = '<div class="flex min-h-10 items-center gap-2 px-1.5"><div class="flex items-center gap-1.5"><span class="inline-flex size-6 items-center justify-center"><span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"><svg class="size-2.5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span></span><span class="size-[5px] rounded-full" style="background-color: ' + dotColor + ';"></span></div><div class="min-w-0 flex-1"><p class="truncate text-[13px] text-foreground">' + text + '</p></div><div class="ml-auto flex items-center gap-1"><span class="inline-flex size-6 items-center justify-center text-muted-foreground"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg></span><span class="inline-flex size-6 items-center justify-center text-muted-foreground"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span><span class="inline-flex size-6 items-center justify-center text-muted-foreground"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="1"/><circle cx="9" cy="5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="19" r="1"/></svg></span></div></div>';

  var inputRow = document.getElementById('inbox-input-row');
  if (inputRow && inputRow.nextElementSibling) {
    list.insertBefore(row, inputRow.nextElementSibling);
  } else {
    list.appendChild(row);
  }
  requestAnimationFrame(function() {
    row.style.maxHeight = '40px';
    row.style.opacity = '1';
  });
  updateInboxCount();
}

function updateInboxCount() {
  var items = document.querySelectorAll('#inbox-task-list .inbox-task-item');
  var el = document.getElementById('inbox-count');
  if (el) el.textContent = items.length;
}

// ─── Quick Add sequential demo ───

var inboxQaTimers = [];
var inboxQaPaused = false;
var inboxQaText = 'Send proposal to Kaya /p high';
var inboxQaCleanText = 'Send proposal to Kaya';

function inboxQaClearTimers() {
  for (var i = 0; i < inboxQaTimers.length; i++) {
    clearTimeout(inboxQaTimers[i]);
  }
  inboxQaTimers = [];
}

function inboxQaDelay(fn, ms) {
  var t = setTimeout(fn, ms);
  inboxQaTimers.push(t);
  return t;
}

function inboxQaResetPanel() {
  var overlay = document.getElementById('inbox-qa-overlay');
  var panel = document.getElementById('inbox-qa-panel');
  var input = document.getElementById('inbox-qa-input');
  var dot = document.getElementById('inbox-qa-dot');
  var meta = document.getElementById('inbox-qa-meta');
  var popover = document.getElementById('inbox-qa-popover');

  if (overlay) { overlay.classList.remove('visible'); }
  if (panel) { panel.classList.remove('visible'); }
  if (input) { input.textContent = '\u00A0'; input.className = 'min-w-0 flex-1 text-[13px] text-foreground'; }
  if (dot) { dot.style.backgroundColor = 'color-mix(in srgb, var(--foreground) 15%, transparent)'; }
  if (meta) { meta.classList.remove('expanded'); }
  if (popover) { popover.classList.remove('visible'); }
}

function inboxQaRemoveAdded() {
  var added = document.querySelectorAll('.inbox-qa-added');
  added.forEach(function(el) {
    el.style.maxHeight = '0';
    el.style.opacity = '0';
    setTimeout(function() { el.remove(); }, 300);
  });
}

function inboxFullReset() {
  // Hide cursor
  inboxHideCursor();

  // Reset Quick Add panel
  inboxQaResetPanel();

  // Remove any dynamically added tasks
  var added = document.querySelectorAll('.inbox-qa-added');
  added.forEach(function(el) { el.remove(); });

  // Reset task 1 bookmark
  var t1Bookmark = document.getElementById('inbox-t1-bookmark');
  if (t1Bookmark) {
    t1Bookmark.classList.remove('text-foreground');
    t1Bookmark.classList.add('text-muted-foreground');
    var t1Svg = t1Bookmark.querySelector('svg');
    if (t1Svg) t1Svg.setAttribute('fill', 'none');
  }
  var t1 = document.getElementById('inbox-t1');
  if (t1) t1.classList.remove('inbox-glow');

  // Reset task 2 priority dot
  var t2Dot = document.getElementById('inbox-t2-dot');
  if (t2Dot) {
    t2Dot.classList.remove('bg-amber-500');
    t2Dot.classList.add('bg-foreground/15');
  }

  // Reset task 4 — checkbox, title, dot, row visibility
  var t4Circle = document.getElementById('inbox-t4-circle');
  if (t4Circle) {
    t4Circle.style.borderStyle = 'dashed';
    t4Circle.style.borderColor = 'var(--foreground-muted, rgba(245,245,245,0.35))';
    t4Circle.style.backgroundColor = 'transparent';
  }
  var t4Check = document.getElementById('inbox-t4-check');
  if (t4Check) {
    t4Check.style.opacity = '0';
    t4Check.setAttribute('stroke', 'currentColor');
  }
  var t4Title = document.getElementById('inbox-t4-title');
  if (t4Title) {
    t4Title.style.textDecoration = 'none';
    t4Title.classList.remove('text-muted-foreground');
    t4Title.classList.add('text-foreground');
  }
  var t4Dot = document.getElementById('inbox-t4-dot');
  if (t4Dot) {
    t4Dot.classList.remove('bg-amber-500');
    t4Dot.classList.add('bg-foreground/15');
  }
  var t4 = document.getElementById('inbox-t4');
  if (t4) {
    t4.style.transition = 'none';
    t4.style.maxHeight = '';
    t4.style.opacity = '1';
    // Re-enable transition after browser flushes restored state
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        if (t4) t4.style.transition = '';
      });
    });
  }

  // Reset count
  var countEl = document.getElementById('inbox-count');
  if (countEl) countEl.textContent = '4';
}

// ─── Cursor helpers ───

function inboxMoveCursor(targetEl, callback) {
  var cursor = document.getElementById('inbox-cursor');
  if (!cursor || !targetEl) { if (callback) callback(); return; }
  var container = cursor.offsetParent;
  if (!container) { if (callback) callback(); return; }
  var cr = container.getBoundingClientRect();
  var tr = targetEl.getBoundingClientRect();
  var x = tr.left - cr.left + tr.width * 0.35;
  var y = tr.top - cr.top + tr.height * 0.35;
  cursor.style.opacity = '1';
  cursor.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
  setTimeout(callback, 550);
}

function inboxClickCursor(callback) {
  var inner = document.getElementById('inbox-cursor-inner');
  if (!inner) { if (callback) callback(); return; }
  inner.style.transform = 'scale(0.75)';
  setTimeout(function() {
    inner.style.transform = 'scale(1)';
    if (callback) setTimeout(callback, 100);
  }, 100);
}

function inboxHideCursor() {
  var cursor = document.getElementById('inbox-cursor');
  if (cursor) cursor.style.opacity = '0';
}

// ─── Moment 1: Capture (Quick Add) ───

function inboxMoment1(onDone) {
  if (inboxQaPaused) return;

  var overlay = document.getElementById('inbox-qa-overlay');
  var panel = document.getElementById('inbox-qa-panel');
  var input = document.getElementById('inbox-qa-input');
  var dot = document.getElementById('inbox-qa-dot');
  var meta = document.getElementById('inbox-qa-meta');
  var popover = document.getElementById('inbox-qa-popover');

  if (!overlay || !panel || !input) return;

  // Show overlay
  inboxQaDelay(function() {
    if (inboxQaPaused) return;
    overlay.classList.add('visible');

    // Scale in panel
    inboxQaDelay(function() {
      if (inboxQaPaused) return;
      panel.classList.add('visible');

      // Typewriter
      inboxQaDelay(function() {
        if (inboxQaPaused) return;
        input.textContent = '';
        input.className = 'min-w-0 flex-1 text-[13px] text-foreground typing';
        var i = 0;
        var slashShown = false;

        function typeChar() {
          if (inboxQaPaused) return;
          if (i < inboxQaText.length) {
            input.textContent = inboxQaText.substring(0, i + 1);
            i++;

            var currentText = inboxQaText.substring(0, i);
            if (!slashShown && currentText.indexOf('/p ') !== -1) {
              slashShown = true;
              if (popover) popover.classList.add('visible');
            }

            inboxQaDelay(typeChar, 50);
          } else {
            // Typing done — process slash command
            inboxQaDelay(function() {
              if (inboxQaPaused) return;
              if (popover) popover.classList.remove('visible');
              input.textContent = inboxQaCleanText;
              if (dot) dot.style.backgroundColor = '#f43f5e';
              if (meta) meta.classList.add('expanded');

              inboxQaDelay(function() {
                if (inboxQaPaused) return;
                input.className = 'min-w-0 flex-1 text-[13px] text-foreground done';

                // Dismiss panel
                inboxQaDelay(function() {
                  if (inboxQaPaused) return;
                  panel.classList.remove('visible');

                  inboxQaDelay(function() {
                    if (inboxQaPaused) return;
                    overlay.classList.remove('visible');

                    // Insert task into inbox
                    inboxQaDelay(function() {
                      if (inboxQaPaused) return;
                      inboxAddTask(inboxQaCleanText, '#f43f5e');

                      // Count is now 5
                      if (onDone) onDone();
                    }, 200);
                  }, 200);
                }, 800);
              }, 800);
            }, 300);
          }
        }

        typeChar();
      }, 500);
    }, 300);
  }, 0);
}

// ─── Moment 2: Triage ───

function inboxMoment2(onDone) {
  if (inboxQaPaused) return;

  var t1Bookmark = document.getElementById('inbox-t1-bookmark');

  // Move cursor to bookmark
  inboxQaDelay(function() {
    if (inboxQaPaused) return;
    inboxMoveCursor(t1Bookmark, function() {
      if (inboxQaPaused) return;

      // Click bookmark
      inboxClickCursor(function() {
        if (inboxQaPaused) return;
        var t1 = document.getElementById('inbox-t1');
        if (t1Bookmark) {
          t1Bookmark.classList.remove('text-muted-foreground');
          t1Bookmark.classList.add('text-foreground');
          var svg = t1Bookmark.querySelector('svg');
          if (svg) svg.setAttribute('fill', 'currentColor');
        }
        if (t1) t1.classList.add('inbox-glow');

        // Move cursor to task 2 row (near the dot area)
        var t2 = document.getElementById('inbox-t2');
        inboxQaDelay(function() {
          if (inboxQaPaused) return;
          inboxMoveCursor(t2, function() {
            if (inboxQaPaused) return;

            // Click to set priority
            inboxClickCursor(function() {
              if (inboxQaPaused) return;
              var t2Dot = document.getElementById('inbox-t2-dot');
              if (t2Dot) {
                t2Dot.classList.remove('bg-foreground/15');
                t2Dot.classList.add('bg-amber-500');
              }

              if (onDone) inboxQaDelay(onDone, 600);
            });
          });
        }, 400);
      });
    });
  }, 1000);
}

// ─── Moment 3: Complete ───

function inboxMoment3(onDone) {
  if (inboxQaPaused) return;

  var t4Circle = document.getElementById('inbox-t4-circle');

  // Move cursor to task 4 checkbox
  inboxQaDelay(function() {
    if (inboxQaPaused) return;
    inboxMoveCursor(t4Circle, function() {
      if (inboxQaPaused) return;

      // Click checkbox
      inboxClickCursor(function() {
        if (inboxQaPaused) return;

        // Checkbox: dashed → solid, fill foreground, check opacity → 1
        var t4Check = document.getElementById('inbox-t4-check');
        if (t4Circle) {
          t4Circle.style.borderStyle = 'solid';
          t4Circle.style.borderColor = 'var(--foreground)';
          t4Circle.style.backgroundColor = 'var(--foreground)';
        }
        if (t4Check) {
          t4Check.style.opacity = '1';
          t4Check.style.color = 'var(--background)';
          t4Check.setAttribute('stroke', 'var(--background)');
        }

        // Priority dot mutes
        var t4Dot = document.getElementById('inbox-t4-dot');
        if (t4Dot) {
          t4Dot.classList.remove('bg-amber-500');
          t4Dot.classList.add('bg-foreground/15');
        }

        // Title: line-through + muted
        var t4Title = document.getElementById('inbox-t4-title');
        if (t4Title) {
          t4Title.style.textDecoration = 'line-through';
          t4Title.classList.remove('text-foreground');
          t4Title.classList.add('text-muted-foreground');
        }

        // Hide cursor, pause, then slide out
        inboxHideCursor();

        inboxQaDelay(function() {
          if (inboxQaPaused) return;
          var t4 = document.getElementById('inbox-t4');
          if (t4) {
            t4.style.maxHeight = '0';
            t4.style.opacity = '0';
          }

          // Update count: 5 → 4
          inboxQaDelay(function() {
            if (inboxQaPaused) return;
            var countEl = document.getElementById('inbox-count');
            if (countEl) countEl.textContent = '4';

            if (onDone) onDone();
          }, 500);
        }, 500);
      });
    });
  }, 400);
}

// ─── Main demo loop — chains all three moments ───

function runInboxQaDemo() {
  if (inboxQaPaused) return;

  inboxFullReset();

  inboxMoment1(function() {
    if (inboxQaPaused) return;

    inboxMoment2(function() {
      if (inboxQaPaused) return;

      inboxMoment3(function() {
        if (inboxQaPaused) return;

        // Hold, then reset and loop
        inboxQaDelay(function() {
          if (inboxQaPaused) return;
          inboxQaRemoveAdded();

          inboxQaDelay(function() {
            if (inboxQaPaused) return;
            inboxFullReset();
            inboxQaDelay(function() {
              if (!inboxQaPaused) runInboxQaDemo();
            }, 1500);
          }, 300);
        }, 2000);
      });
    });
  });
}

function startInboxAutoPlay() {
  inboxQaPaused = false;
  inboxQaDelay(runInboxQaDemo, 1500);
}

function stopInboxAutoPlay() {
  inboxQaPaused = true;
  inboxQaClearTimers();
  inboxFullReset();
}

function pauseInboxAutoPlay() {
  stopInboxAutoPlay();
  clearTimeout(inboxPauseTimer);
  inboxPauseTimer = setTimeout(startInboxAutoPlay, 6000);
}

window.startInboxAutoPlay = startInboxAutoPlay;
window.stopInboxAutoPlay = stopInboxAutoPlay;
</script>

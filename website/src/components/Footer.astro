<style>
  /* ─── Scene container ─── */
  .footer-scene {
    --step-dur: 1.1s;
    position: relative;
    height: 130px;
    overflow: hidden;
    margin-top: 2rem;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  /* ─── Parallax layers (shared) ─── */
  .scene-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .scene-track {
    display: flex;
    width: 200%;
    height: 100%;
    will-change: transform;
  }

  .scene-track > * {
    flex: 0 0 50%;
  }

  /* ─── Layer speeds ─── */
  .scene-layer--far .scene-track {
    animation: footer-scroll 28s linear infinite;
  }

  .scene-layer--mid .scene-track {
    animation: footer-scroll 18s linear infinite;
  }

  .scene-layer--ground {
    top: auto;
    bottom: 18px;
    height: auto;
  }

  .scene-layer--ground .scene-track {
    animation: footer-scroll 5.5s linear infinite;
    height: auto;
  }

  /* ─── Layer colors ─── */
  .scene-layer--far {
    color: color-mix(in srgb, var(--muted-foreground) 14%, transparent);
  }

  .scene-layer--mid {
    color: color-mix(in srgb, var(--muted-foreground) 25%, transparent);
  }

  /* ─── Ground line ─── */
  .ground-line {
    width: 100%;
    border-top: 1px dashed color-mix(in srgb, var(--border) 60%, transparent);
  }

  /* ─── Scroll keyframe ─── */
  @keyframes footer-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Bird (centered, non-scrolling) ─── */
  .scene-bird {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .birdo-scene {
    width: 56px;
    height: 44px;
    perspective: 200px;
  }

  .birdo-scene svg {
    transition: transform 0.3s ease;
  }

  /* ─── Direction flip on click ─── */
  .footer-scene.scene-flipped .birdo-scene svg {
    transform: rotateY(180deg);
  }

  .birdo-scene svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ─── Bird animation ─── */
  .birdo-shadow {
    transform-origin: 130px 265px;
    animation: birdo-shadow-pulse var(--step-dur) ease-in-out infinite;
  }

  .birdo-body-group {
    transform-origin: 130px 228px;
    animation: birdo-body-dance var(--step-dur) ease-in-out infinite;
  }

  .birdo-leg {
    animation: birdo-leg-step var(--step-dur) ease-in-out infinite;
  }

  .birdo-left-leg {
    transform-origin: 120px 228px;
  }

  .birdo-right-leg {
    transform-origin: 140px 228px;
    animation-delay: calc(var(--step-dur) / -2);
  }

  .birdo-eye {
    transform-origin: 132px 105px;
    animation: birdo-blink 3.5s infinite;
  }

  @keyframes birdo-body-dance {
    0%   { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
    25%  { transform: translateY(-10px) rotate(4deg) scaleY(1.02); }
    50%  { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
    75%  { transform: translateY(-10px) rotate(-6deg) scaleY(1.02); }
    100% { transform: translateY(4px) rotate(-3deg) scaleY(0.95); }
  }

  @keyframes birdo-leg-step {
    0%   { transform: rotate(40deg) translateY(0); }
    25%  { transform: rotate(0deg) translateY(-28px); }
    50%  { transform: rotate(-40deg) translateY(0); }
    75%  { transform: rotate(0deg) translateY(0); }
    100% { transform: rotate(40deg) translateY(0); }
  }

  @keyframes birdo-shadow-pulse {
    0%, 50%, 100% { transform: scaleX(1); opacity: 0.15; }
    25%, 75%      { transform: scaleX(0.7); opacity: 0.05; }
  }

  @keyframes birdo-blink {
    0%, 46%, 50%, 100% { transform: scaleY(1); }
    48% { transform: scaleY(0); }
  }

  /* ─── Reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .scene-track,
    .birdo-body-group,
    .birdo-leg,
    .birdo-shadow,
    .birdo-eye {
      animation: none !important;
    }

    .birdo-scene {
      transition: none;
    }
  }
</style>

<script>
  (function() {
    var bird = document.querySelector('.scene-bird');
    var scene = document.querySelector('.footer-scene');
    if (!bird || !scene) return;

    var direction = 1;
    var transitioning = false;

    function easeInOut(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    bird.addEventListener('click', function() {
      if (transitioning) return;
      transitioning = true;

      var from = direction;
      var to = direction * -1;
      direction = to;
      scene.classList.toggle('scene-flipped');

      var tracks = scene.querySelectorAll('.scene-track');
      var animations = [];
      tracks.forEach(function(track) {
        track.getAnimations().forEach(function(a) { animations.push(a); });
      });

      var start = performance.now();
      var duration = 600;

      function step(now) {
        var t = Math.min((now - start) / duration, 1);
        var rate = from + (to - from) * easeInOut(t);
        animations.forEach(function(a) { a.playbackRate = rate; });
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          transitioning = false;
        }
      }

      requestAnimationFrame(step);
    });
  })();
</script>

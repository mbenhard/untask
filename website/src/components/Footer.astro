---
// Footer — minimal, centered, pill chip links
---

<footer class="px-6 pb-16 pt-24 sm:pt-32">
  <div class="mx-auto max-w-2xl">

    <!-- Ruled line -->
    <div class="border-t border-border"></div>

    <div class="mt-12 flex flex-col items-center text-center">
      <p class="text-[13px] text-muted-foreground">
        Untask is MIT licensed and open source.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <a
          href="https://github.com/mbenhard/untask"
          class="inline-flex items-center rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
        >
          GitHub
        </a>
        <a
          href="https://github.com/mbenhard/untask/releases/latest"
          class="inline-flex items-center rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
        >
          Download
        </a>
        <a
          href="/changelog"
          class="inline-flex items-center rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
        >
          Changelog
        </a>
        <a
          href="/support"
          class="inline-flex items-center rounded-full border border-border/60 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-border hover:text-foreground"
        >
          Support
        </a>
      </div>

      <!-- Theme toggle (real LampDesk icon) -->
      <button
        onclick="toggleTheme(event)"
        class="mt-8 flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground/40 transition-colors hover:text-muted-foreground"
        aria-label="Toggle theme"
      >
        <svg class="h-[14px] w-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.293 2.293a1 1 0 0 1 1.414 0l2.5 2.5 5.994 1.227a1 1 0 0 1 .506 1.687l-7 7a1 1 0 0 1-1.687-.506l-1.227-5.994-2.5-2.5a1 1 0 0 1 0-1.414z" />
          <path d="m14.207 4.793-3.414 3.414" />
          <path d="M3 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
          <path d="m9.086 6.5-4.793 4.793a1 1 0 0 0-.18 1.17L7 18" />
        </svg>
      </button>

      <div class="mt-4 flex items-center justify-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-muted-foreground/20" viewBox="0 0 100 95.17" fill="currentColor" aria-hidden="true">
          <path d="M50,0C22.39,0,0,22.39,0,50c0,15.54,7.09,29.43,18.22,38.6,3.07-15.42,6.13-30.85,9.19-46.27,2.25-8.16,1.31-18.45,9.04-23.77,8.03-5.46,21.14-.23,21.87,9.69,8.68,2.4,17.39,4.93,25.88,7.91-.52.35-.79.44-1.39.56h0c-7.51,1.46-14.97,3.24-22.52,4.47,3.47,17.2,6.96,34.38,10.48,51.57.26.86.49,1.66.67,2.42,16.88-8.03,28.55-25.24,28.55-45.17C100,22.39,77.61,0,50,0Z"/>
          <path d="M48.65,29.27c.03-4.38-6.63-4.89-7.49-.69-1.13,5.42,7.48,6.22,7.49.69Z"/>
        </svg>
        <span class="font-mono text-[10px] tracking-[0.1em] text-muted-foreground/30">MIT Licensed</span>
      </div>

      <div class="mt-8">
        <a href="/support" class="font-mono text-[10px] text-muted-foreground/40 transition-colors hover:text-muted-foreground">
          Love from Marcus
        </a>
      </div>
    </div>

  </div>
</footer>

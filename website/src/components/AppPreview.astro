<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── macOS Dock ─── */

  .dock-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px;
    border-radius: 18px;
    background: var(--dock-bg);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 0.5px solid var(--dock-border);
    box-shadow: var(--dock-shadow);
  }

  .dock-item {
    position: relative;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    padding-bottom: 0;
  }

  .dock-icon {
    display: block;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    opacity: 1;
    transform-origin: bottom center;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .dock-item:hover .dock-icon {
    transform: translateY(-4px) scale(1.10);
  }

  .dock-app-link {
    display: block;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    transform-origin: bottom center;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .dock-item:hover .dock-app-link {
    transform: translateY(-4px) scale(1.10);
  }

  .dock-app-link img {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    display: block;
  }

  .dock-tooltip {
    position: absolute;
    bottom: calc(100% + 20px);
    left: 50%;
    transform: translateX(-50%) scale(0.96);
    padding: 3px 10px;
    border-radius: 5px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--accent);
    color: var(--foreground);
    border: 0.5px solid var(--border);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .dock-app:hover .dock-tooltip {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transition: opacity 0.15s ease 0.3s, transform 0.15s ease 0.3s;
  }

  button.dock-app-link {
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    outline: none;
    -webkit-appearance: none;
  }

  /* ─── Smooth Scale minimize/restore ─── */

  #app-window {
    will-change: transform, opacity;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease-out;
    transform-origin: center center;
  }

  #app-window.scale-minimized {
    transform: scale(0.01);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s 0.1s ease-out;
    pointer-events: none;
  }

  /* ─── Easter Egg: Sleeping Mascot ─── */

  #easter-egg {
    opacity: 1;
  }

  .bird-container {
    width: 90px;
    height: 55px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .bird-container svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    --breathe-dur: 3.5s;
  }

  #shadow {
    transform-origin: 25px 26px;
    animation: shadow-breathe var(--breathe-dur) ease-in-out infinite;
    opacity: 0.6;
  }

  #body-group {
    transform-origin: 25px 25px;
    animation: body-breathe var(--breathe-dur) ease-in-out infinite;
  }

  #snot-bubble {
    transform-origin: 16px 12px;
    animation: bubble-breathe var(--breathe-dur) ease-in-out infinite;
  }

  .z-particle {
    opacity: 0;
  }

  #z1 { animation: float-z1 4s infinite linear 0.5s; }
  #z2 { animation: float-z2 4s infinite linear 1.8s; }
  #z3 { animation: float-z3 4s infinite linear 3.1s; }

  @keyframes body-breathe {
    0%, 100% { transform: scaleY(0.96); }
    50% { transform: scaleY(1.04); }
  }

  @keyframes shadow-breathe {
    0%, 100% { transform: scaleX(1); opacity: 0.6; }
    50% { transform: scaleX(1.05); opacity: 0.4; }
  }

  @keyframes bubble-breathe {
    0%, 10% { transform: scale(0.2); opacity: 0; }
    50% { transform: scale(1.1); opacity: 0.25; }
    90%, 100% { transform: scale(0.2); opacity: 0; }
  }

  @keyframes float-z1 {
    0% { transform: translate(16px, 1px) scale(0.4); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 0.8; }
    100% { transform: translate(10px, -12px) scale(0.6); opacity: 0; }
  }

  @keyframes float-z2 {
    0% { transform: translate(16px, 1px) scale(0.4); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 0.8; }
    100% { transform: translate(6px, -16px) scale(0.9); opacity: 0; }
  }

  @keyframes float-z3 {
    0% { transform: translate(16px, 1px) scale(0.4); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 0.8; }
    100% { transform: translate(0px, -20px) scale(1.1); opacity: 0; }
  }

  .dock-dot {
    position: absolute;
    bottom: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0.5;
  }

  /* ─── Task Detail Animation ─── */

  .td-cursor-blink::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1em;
    background: var(--muted-foreground);
    opacity: 0.4;
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: td-blink 0.8s step-end infinite;
  }

  .td-typing::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1em;
    background: var(--foreground);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: td-blink 0.8s step-end infinite;
  }

  @keyframes td-blink { 50% { opacity: 0; } }

  .td-flash {
    animation: td-field-flash 0.6s ease-out;
  }

  @keyframes td-field-flash {
    0%   { background-color: color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 3px; }
    100% { background-color: transparent; }
  }


  .td-chevron-up { transform: rotate(180deg); }


</style>

<script is:inline>
// ─── Interactive task helpers ───

var apPriorityColors = { amber: '#f59e0b', rose: '#f43f5e', none: '' };

function apToggleTask(row) {
  var isDone = row.dataset.done === 'true';
  var circle = row.querySelector('.task-circle');
  var check = row.querySelector('.task-check');
  var dot = row.querySelector('.task-dot');
  var title = row.querySelector('.task-title');
  var priority = row.dataset.priority;

  if (isDone) {
    row.dataset.done = 'false';
    circle.style.borderStyle = 'dashed';
    circle.style.borderColor = 'var(--foreground-muted, rgba(245,245,245,0.35))';
    circle.style.backgroundColor = 'transparent';
    check.style.opacity = '0';
    dot.style.backgroundColor = priority === 'none'
      ? 'color-mix(in srgb, var(--foreground) 15%, transparent)'
      : apPriorityColors[priority];
    title.classList.remove('line-through', 'text-muted-foreground');
    title.classList.add('text-foreground');
  } else {
    row.dataset.done = 'true';
    circle.style.borderStyle = 'solid';
    circle.style.borderColor = 'var(--foreground)';
    circle.style.backgroundColor = 'var(--foreground)';
    check.style.opacity = '1';
    dot.style.backgroundColor = 'color-mix(in srgb, var(--foreground) 15%, transparent)';
    title.classList.add('line-through', 'text-muted-foreground');
    title.classList.remove('text-foreground');
  }
  apUpdateCounts();
}

function apToggleBookmark(btn) {
  var isActive = btn.dataset.bookmarked === 'true';
  var icon = btn.querySelector('svg');
  if (isActive) {
    btn.dataset.bookmarked = 'false';
    btn.classList.remove('text-foreground');
    btn.classList.add('text-muted-foreground');
    icon.setAttribute('fill', 'none');
  } else {
    btn.dataset.bookmarked = 'true';
    btn.classList.remove('text-muted-foreground');
    btn.classList.add('text-foreground');
    icon.setAttribute('fill', 'currentColor');
  }
}

function apUpdateCounts() {
  var rows = document.querySelectorAll('#ap-section .ap-task-row');
  var active = 0;
  var done = 0;
  rows.forEach(function(r) {
    if (r.dataset.done === 'true') done++;
    else active++;
  });
  // +1 for the morphing task which is always "active"
  var countEl = document.getElementById('td-count');
  var doneEl = document.getElementById('ap-done-count');
  if (countEl) countEl.textContent = active + 1;
  if (doneEl) doneEl.textContent = 3 + done;
}

window.apToggleTask = apToggleTask;
window.apToggleBookmark = apToggleBookmark;


// ─── Task Detail Animation (step sequencer) ───

var tdTimers = [];
var tdPaused = false;
var tdTypingInterval = null;

var tdCache = {};
function $(id) { return tdCache[id] || (tdCache[id] = document.getElementById(id)); }

function tdDelay(fn, ms) { var t = setTimeout(fn, ms); tdTimers.push(t); return t; }

function tdClearAll() {
  tdTimers.forEach(clearTimeout);
  tdTimers = [];
  if (tdTypingInterval) { clearInterval(tdTypingInterval); tdTypingInterval = null; }
}

function tdType(el, text, ms, cb) {
  el.textContent = '';
  var i = 0;
  tdTypingInterval = setInterval(function() {
    if (tdPaused) { clearInterval(tdTypingInterval); tdTypingInterval = null; return; }
    el.textContent = text.substring(0, ++i);
    if (i >= text.length) { clearInterval(tdTypingInterval); tdTypingInterval = null; if (cb) cb(); }
  }, ms);
}

function tdFlash(el) {
  el.classList.remove('td-flash');
  void el.offsetWidth;
  el.classList.add('td-flash');
}

function tdRun(steps, i) {
  if (tdPaused || i >= steps.length) return;
  var step = steps[i];
  if (typeof step === 'function') {
    step(function() { tdRun(steps, i + 1); });
  } else {
    tdDelay(function() {
      if (tdPaused) return;
      step[1]();
      tdRun(steps, i + 1);
    }, step[0]);
  }
}

function tdReset() {
  // Disable transitions on height-changing elements for instant collapse
  // (prevents scroll glitch from animated height change re-triggering observer)
  var heightEls = ['td-body','td-subs','td-sub-input','td-s1','td-s2'];
  heightEls.forEach(function(id) { $(id).style.transition = 'none'; });

  $('td-title').textContent = 'Type and press Enter';
  $('td-title').className = 'text-[13px] text-muted-foreground/30';

  $('td-row').style.backgroundColor = '';

  $('td-actions').style.opacity = '0';
  $('td-chevron').classList.remove('td-chevron-up');
  $('td-dot').className = 'size-[5px] rounded-full bg-foreground/15 transition-colors duration-300';
  $('td-body').style.maxHeight = '0';
  $('td-count').textContent = '4';

  $('td-badge-date').style.display = 'none';
  $('td-badge-subtasks').style.display = 'none';

  [['td-m-date','+ due date'],['td-m-priority','+ priority'],['td-m-client','+ client'],['td-m-subtask','+ subtask']].forEach(function(s) {
    $(s[0]).textContent = s[1];
    $(s[0]).className = 'td-seg text-muted-foreground/50';
  });
  $('td-m-status').className = 'td-seg text-muted-foreground/80';

  heightEls.forEach(function(id) { $(id).style.maxHeight = '0'; });

  $('td-content').textContent = '';
  $('td-content').style.opacity = '0';

  $('td-sub-text').textContent = 'New subtask...';
  $('td-sub-text').className = 'text-[13px] text-muted-foreground/30';

  var s1check = $('td-s1-check');
  s1check.style.borderStyle = 'dashed';
  s1check.style.borderColor = '';
  s1check.style.backgroundColor = '';
  s1check.querySelector('svg').style.opacity = '0';
  $('td-s1-text').className = 'truncate text-[13px] text-foreground transition-all duration-300';

  // Re-enable transitions after the browser has flushed the collapsed state
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      heightEls.forEach(function(id) { $(id).style.transition = ''; });
    });
  });
}

function runTdDemo() {
  if (tdPaused) return;

  tdRun([
    [800, function() {
      $('td-row').style.backgroundColor = 'color-mix(in srgb, var(--accent) 40%, transparent)';
      $('td-title').className = 'td-typing text-[13px] text-foreground';
      $('td-title').textContent = '';
    }],
    function(next) { tdType($('td-title'), 'Prepare client presentation', 35, next); },

    [300, function() {
      $('td-title').className = 'text-[13px] text-foreground truncate';
      $('td-actions').style.opacity = '1';
      $('td-count').textContent = '5';
    }],

    [300, function() {
      $('td-chevron').classList.add('td-chevron-up');
    }],

    [200, function() { $('td-body').style.maxHeight = '400px'; }],

    [350, function() {
      $('td-content').style.opacity = '1';
      $('td-content').className = 'td-typing text-[13px] leading-relaxed text-foreground/80';
    }],
    function(next) { tdType($('td-content'), 'Finalize deck with design team before Thursday.', 22, next); },
    [0, function() {
      $('td-content').className = 'text-[13px] leading-relaxed text-foreground/80';
    }],

    [400, function() {
      $('td-m-priority').innerHTML = '<span class="inline-block size-[5px] rounded-full bg-emerald-500" style="vertical-align:middle"></span> Low';
      $('td-m-priority').className = 'td-seg text-muted-foreground';
      tdFlash($('td-m-priority'));
      $('td-dot').className = 'size-[5px] rounded-full bg-emerald-500 transition-colors duration-300';
    }],

    [500, function() {
      $('td-m-date').textContent = 'Feb 20';
      $('td-m-date').className = 'td-seg text-muted-foreground';
      tdFlash($('td-m-date'));
      $('td-badge-date').style.display = '';
    }],

    [500, function() {
      $('td-m-client').className = 'td-seg text-muted-foreground td-typing';
      $('td-m-client').textContent = '';
    }],
    function(next) { tdType($('td-m-client'), 'Wavelength', 40, next); },
    [0, function() {
      $('td-m-client').className = 'td-seg text-muted-foreground';
      tdFlash($('td-m-client'));
    }],

    [500, function() {
      $('td-m-subtask').className = 'td-seg text-muted-foreground';
      tdFlash($('td-m-subtask'));
      $('td-subs').style.maxHeight = '200px';
    }],
    [200, function() { $('td-sub-input').style.maxHeight = '40px'; }],

    [250, function() { $('td-sub-text').className = 'td-typing text-[13px] text-foreground'; }],
    function(next) { tdType($('td-sub-text'), 'Draft slide outline', 35, next); },
    [250, function() {
      $('td-s1').style.maxHeight = '40px';
      $('td-sub-text').textContent = 'New subtask...';
      $('td-sub-text').className = 'text-[13px] text-muted-foreground/30';
    }],

    [500, function() {
      var check = $('td-s1-check');
      check.style.borderStyle = 'solid';
      check.style.borderColor = 'var(--foreground)';
      check.style.backgroundColor = 'var(--foreground)';
      check.querySelector('svg').style.opacity = '1';
      $('td-s1-text').className = 'truncate text-[13px] text-muted-foreground line-through transition-all duration-300';
    }],

    [350, function() { $('td-sub-text').className = 'td-typing text-[13px] text-foreground'; }],
    function(next) { tdType($('td-sub-text'), 'Collect latest metrics', 35, next); },
    [250, function() {
      $('td-s2').style.maxHeight = '40px';
      $('td-sub-input').style.maxHeight = '0';
      $('td-m-subtask').textContent = '1/2 subtasks';
      $('td-m-subtask').className = 'td-seg text-muted-foreground';
      tdFlash($('td-m-subtask'));
      $('td-badge-subtasks').style.display = '';
    }],

    // Smooth reset: collapse body first, then reset text/styles
    [2000, function() {
      $('td-body').style.maxHeight = '0';
      $('td-subs').style.maxHeight = '0';
    
      $('td-chevron').classList.remove('td-chevron-up');
      $('td-row').style.backgroundColor = '';
    }],
    [400, function() { tdReset(); }],
    [1000, function() { runTdDemo(); }],
  ], 0);
}

// ─── Public API (exposed as ap-prefixed for observer) ───

function startApAutoPlay() {
  tdPaused = false;
  tdReset();
  tdDelay(runTdDemo, 800);
}

function stopApAutoPlay() {
  tdPaused = true;
  tdClearAll();
  tdReset();
}

window.startApAutoPlay = startApAutoPlay;
window.stopApAutoPlay = stopApAutoPlay;

// ─── Smooth Scale minimize/restore ───

var isWindowMinimized = false;

function toggleScaleMinimize() {
  var win = document.getElementById('app-window');
  var dockIcon = document.querySelector('.dock-app');
  if (!win || !dockIcon) return;

  if (!isWindowMinimized) {
    var winRect = win.getBoundingClientRect();
    var iconRect = dockIcon.getBoundingClientRect();
    var originX = iconRect.left + iconRect.width / 2 - winRect.left;
    var originY = iconRect.top + iconRect.height / 2 - winRect.top;
    win.style.transformOrigin = originX + 'px ' + originY + 'px';

    stopApAutoPlay();
    win.classList.add('scale-minimized');
    isWindowMinimized = true;
  } else {
    win.classList.remove('scale-minimized');
    isWindowMinimized = false;

    setTimeout(function() {
      if (!isWindowMinimized) {
        startApAutoPlay();
      }
    }, 800);
  }
}
window.toggleScaleMinimize = toggleScaleMinimize;
</script>

---
// 1:1 CSS recreation of the Untask app window
// Content: Task detail morphing animation (input → task → expanded)
// Replaces cursor demo with TaskDetailPreview's step-sequenced animation
---

<section id="ap-section" class="px-6 pt-6 pb-24 sm:pb-32">
  <div data-thread-content class="mx-auto max-w-2xl relative">

    <!-- ═══ Easter Egg: Sleeping Mascot (Behind Window) ═══ -->
    <div id="easter-egg" class="absolute inset-0 flex items-start justify-center -z-10 rounded-xl overflow-hidden">
      <div class="flex flex-col items-center justify-center pt-[260px]">
        <div class="bird-container" style="color: var(--muted-foreground);">
          <svg viewBox="0 0 52 32" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
              <!-- Shadow on the floor -->
              <rect x="8" y="26" width="34" height="1" fill="currentColor" id="shadow" opacity="0.3" />

              <!-- Sleeping Bird Base -->
              <g id="body-group">

                  <!-- BEAK: Shorter and thicker -->
                  <rect x="15" y="11" width="2" height="3" fill="currentColor" />
                  <rect x="14" y="14" width="4" height="3" fill="currentColor" />

                  <!-- BODY -->
                  <rect x="14" y="17" width="20" height="1" fill="currentColor" />
                  <rect x="13" y="18" width="22" height="1" fill="currentColor" />
                  <rect x="12" y="19" width="24" height="1" fill="currentColor" />
                  <rect x="11" y="20" width="26" height="1" fill="currentColor" />

                  <rect x="10" y="21" width="27" height="4" fill="currentColor" />
                  <rect x="11" y="25" width="25" height="1" fill="currentColor" />

                  <!-- LEGS -->
                  <rect x="37" y="20" width="4" height="1" fill="currentColor" />
                  <rect x="40" y="21" width="1" height="1" fill="currentColor" />
                  <rect x="37" y="23" width="4" height="1" fill="currentColor" />
                  <rect x="40" y="24" width="1" height="1" fill="currentColor" />

                  <!-- Sleeping U-shaped Eye -->
                  <rect x="14" y="20" width="1" height="1" fill="var(--background)" />
                  <rect x="14" y="21" width="3" height="1" fill="var(--background)" />
                  <rect x="16" y="20" width="1" height="1" fill="var(--background)" />

                  <!-- Cheek Blush -->
                  <rect x="18" y="21" width="2" height="1" fill="currentColor" opacity="0.6" />

                  <!-- Snot Sleep Bubble -->
                  <g id="snot-bubble" fill="var(--foreground)" opacity="0.15">
                      <rect x="15" y="8" width="2" height="1" />
                      <rect x="14" y="9" width="4" height="2" />
                      <rect x="15" y="11" width="2" height="1" />
                  </g>
              </g>

              <!-- Zzz Particles -->
              <g class="z-particle" id="z1">
                  <rect x="0" y="0" width="3" height="1" fill="currentColor" />
                  <rect x="2" y="1" width="1" height="1" fill="currentColor" />
                  <rect x="1" y="2" width="1" height="1" fill="currentColor" />
                  <rect x="0" y="3" width="3" height="1" fill="currentColor" />
              </g>
              <g class="z-particle" id="z2">
                  <rect x="0" y="0" width="3" height="1" fill="currentColor" />
                  <rect x="2" y="1" width="1" height="1" fill="currentColor" />
                  <rect x="1" y="2" width="1" height="1" fill="currentColor" />
                  <rect x="0" y="3" width="3" height="1" fill="currentColor" />
              </g>
              <g class="z-particle" id="z3">
                  <rect x="0" y="0" width="3" height="1" fill="currentColor" />
                  <rect x="2" y="1" width="1" height="1" fill="currentColor" />
                  <rect x="1" y="2" width="1" height="1" fill="currentColor" />
                  <rect x="0" y="3" width="3" height="1" fill="currentColor" />
              </g>
          </svg>
        </div>
        <p class="mt-4 text-xs font-medium text-muted-foreground tracking-widest uppercase opacity-40">Shhh...</p>
      </div>
    </div>

    <!-- Window frame -->
    <div id="app-window" data-reveal data-reveal-eager class="overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <!-- Traffic lights -->
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80 transition-colors"></span>
          <span class="block h-[10px] w-[10px] cursor-pointer rounded-full bg-[#FEBC2E]/80 transition-colors" onclick="toggleScaleMinimize()"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80 transition-colors"></span>
        </div>

        <div class="flex-1"></div>

        <!-- Nav tabs -->
        <nav class="flex items-center gap-0.5">
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Today
          </span>
          <span class="rounded-lg bg-accent px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-foreground">
            Tasks
          </span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Inbox
          </span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Notes
          </span>
        </nav>
      </header>

      <!-- ═══ Content area ═══ -->
      <div class="relative flex flex-col overflow-hidden p-3" style="min-height: 600px;">
        <div class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-2">

          <!-- ═══ SectionGroup: In Progress (expanded) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">In Progress</span>
                <span id="td-count" class="ml-auto font-mono text-[11px] text-muted-foreground">4</span>
              </div>
              <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </span>
            </div>

            <div class="border-t border-border/60 px-1 py-1">

              <!-- ═══ The Task — single row that morphs from input → task → expanded ═══ -->
              <div id="td-task" class="border-b border-border/40">

                <!-- Row (always 40px, no height changes during input→task transition) -->
                <div id="td-row" class="flex min-h-10 items-center gap-2 px-1.5 transition-colors duration-200">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-6 items-center justify-center">
                      <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                        <svg class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    </span>
                    <span id="td-dot" class="size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <span id="td-title" class="text-[13px] text-muted-foreground/30">Type and press Enter</span>
                  </div>
                  <!-- Right-side actions (hidden in input mode) -->
                  <div id="td-actions" class="ml-auto flex items-center gap-1 opacity-0 transition-opacity duration-300">
                    <span id="td-badge-date" class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground" style="display: none;">Feb 20</span>
                    <span id="td-badge-subtasks" class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground" style="display: none;">1/2</span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                    </span>
                    <span id="td-chevron" class="inline-flex size-6 items-center justify-center text-muted-foreground transition-transform duration-200">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                    <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                        <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Expanded body (opens after task is "created" and focused) -->
                <div id="td-body" class="overflow-hidden" style="max-height: 0; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);">

                  <!-- Content / notes area (BlockNote editor zone) -->
                  <div class="border-t border-border/30 px-3 py-3">
                    <p id="td-content" class="text-[13px] leading-relaxed text-foreground/80 opacity-0 transition-opacity duration-500"></p>
                  </div>

                  <!-- MetadataLine -->
                  <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 px-3 py-2 font-mono text-[11px]">
                    <span id="td-m-date" class="td-seg text-muted-foreground/50">+ due date</span>
                    <span class="text-border/60">&middot;</span>
                    <span id="td-m-priority" class="td-seg text-muted-foreground/50">+ priority</span>
                    <span class="text-border/60">&middot;</span>
                    <span id="td-m-status" class="td-seg text-muted-foreground/80">In Progress</span>
                    <span class="text-border/60">&middot;</span>
                    <span id="td-m-client" class="td-seg text-muted-foreground/50">+ client</span>
                    <span class="text-border/60">&middot;</span>
                    <span id="td-m-subtask" class="td-seg text-muted-foreground/50">+ subtask</span>
                  </div>

                  <!-- Subtask area -->
                  <div id="td-subs" class="overflow-hidden" style="max-height: 0; transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);">

                    <!-- Subtask inline input -->
                    <div id="td-sub-input" class="overflow-hidden border-t border-border/30" style="max-height: 0; transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
                      <div class="flex min-h-10 items-center gap-2 px-1.5 pl-8">
                        <span class="inline-flex size-6 items-center justify-center">
                          <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));"></span>
                        </span>
                        <div class="min-w-0 flex-1">
                          <span id="td-sub-text" class="text-[13px] text-muted-foreground/30">New subtask...</span>
                        </div>
                      </div>
                    </div>

                    <!-- Subtask 1: Draft slide outline (starts unchecked, gets completed in animation) -->
                    <div id="td-s1" class="overflow-hidden border-t border-border/30" style="max-height: 0; transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
                      <div class="flex min-h-10 items-center gap-2 px-1.5 pl-8">
                        <span class="inline-flex size-6 items-center justify-center">
                          <span id="td-s1-check" class="inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                            <svg class="size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                          </span>
                        </span>
                        <div class="min-w-0 flex-1">
                          <p id="td-s1-text" class="truncate text-[13px] text-foreground transition-all duration-300">Draft slide outline</p>
                        </div>
                      </div>
                    </div>

                    <!-- Subtask 2: Collect latest metrics (active) -->
                    <div id="td-s2" class="overflow-hidden border-t border-border/30" style="max-height: 0; transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
                      <div class="flex min-h-10 items-center gap-2 px-1.5 pl-8">
                        <span class="inline-flex size-6 items-center justify-center">
                          <span class="inline-flex size-4 items-center justify-center rounded-full border border-dashed" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                            <svg class="size-2.5 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                          </span>
                        </span>
                        <div class="min-w-0 flex-1">
                          <p class="truncate text-[13px] text-foreground">Collect latest metrics</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ═══ Static task 1: Write project brief (high priority) ═══ -->
              <div class="ap-task-row flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5" data-done="false" data-priority="rose">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="apToggleTask(this.closest('.ap-task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="task-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full bg-rose-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-foreground transition-all duration-300">Write project brief</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <button type="button" onclick="apToggleBookmark(this)" data-bookmarked="true" class="inline-flex size-6 cursor-pointer items-center justify-center text-foreground transition-colors">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </button>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

              <!-- ═══ Static task 2: Review Q1 analytics (med priority, date badge) ═══ -->
              <div class="ap-task-row flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5" data-done="false" data-priority="amber">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="apToggleTask(this.closest('.ap-task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="task-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full bg-amber-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-foreground transition-all duration-300">Review Q1 analytics</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">Feb 22</span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

              <!-- ═══ Static task 3: Update team wiki (no priority) ═══ -->
              <div class="ap-task-row flex min-h-10 items-center gap-2 px-1.5" data-done="false" data-priority="none">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="apToggleTask(this.closest('.ap-task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="task-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full transition-colors duration-300" style="background-color: color-mix(in srgb, var(--foreground) 15%, transparent);"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-foreground transition-all duration-300">Update team wiki</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

            </div>
          </section>

          <!-- ═══ SectionGroup: Backlog (collapsed) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">Backlog</span>
                <span class="ml-auto font-mono text-[11px] text-muted-foreground">5</span>
              </div>
            </div>
          </section>

          <!-- ═══ SectionGroup: Done (collapsed) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                <span class="text-[12px] font-medium text-foreground">Done</span>
                <span id="ap-done-count" class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
              </div>
            </div>
          </section>

        </div>

        <!-- ═══ Bottom bar ═══ -->
        <div class="mt-auto pt-3 flex items-center gap-2">
          <div class="flex shrink-0 items-center gap-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">

---
// 1:1 CSS recreation of the Untask app window
// Matches: TitleBar, SectionGroup, TaskItem, ChatInput components exactly
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl">

    <!-- Window frame -->
    <div class="overflow-hidden rounded-xl border border-border/70 bg-background shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)]">

      <!-- ═══ TitleBar ═══ -->
      <header class="flex items-center px-[10px] pt-[4px] pb-1">
        <!-- Traffic lights -->
        <div class="traffic-lights flex w-[68px] shrink-0 items-center gap-[6px]">
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FF5F57]/80 transition-colors"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#FEBC2E]/80 transition-colors"></span>
          <span class="block h-[10px] w-[10px] rounded-full bg-[#28C840]/80 transition-colors"></span>
        </div>

        <div class="flex-1"></div>

        <!-- Nav tabs -->
        <nav class="flex items-center gap-0.5">
          <span class="rounded-lg bg-accent px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-foreground">
            Today
          </span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Tasks
          </span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Inbox
          </span>
          <span class="rounded-lg px-2.5 py-1 text-[11px] font-medium tracking-[0.01em] text-muted-foreground">
            Notes
          </span>
        </nav>
      </header>

      <!-- ═══ Content area ═══ -->
      <div class="relative p-3">
        <div class="mx-auto flex max-w-3xl flex-col gap-3">

          <!-- ═══ SectionGroup: Today ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 rotate-90 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6" />
                </svg>
                <span class="text-[12px] font-medium text-foreground">Today</span>
                <span id="today-count" class="ml-auto font-mono text-[11px] text-muted-foreground">3</span>
              </div>
              <span class="ml-1.5 inline-flex size-5 items-center justify-center text-muted-foreground/40">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" /><path d="M12 5v14" />
                </svg>
              </span>
            </div>

            <!-- Task list -->
            <div class="border-t border-border/60 px-1 py-1">

              <!-- ═══ TaskItem 1: active, medium priority ═══ -->
              <div class="task-row flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5" data-done="false" data-priority="amber">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="toggleTask(this.closest('.task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="task-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full bg-amber-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-foreground transition-all duration-300">Ship landing page</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">
                    Feb 18
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

              <!-- ═══ TaskItem 2: active, high priority ═══ -->
              <div class="task-row flex min-h-10 items-center gap-2 border-b border-border/40 px-1.5" data-done="false" data-priority="rose">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="toggleTask(this.closest('.task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-dashed transition-all duration-300" style="border-color: var(--foreground-muted, rgba(245,245,245,0.35));">
                      <svg class="task-check size-2.5 text-background opacity-0 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full bg-rose-500 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-foreground transition-all duration-300">Review PR from Alex</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/70 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground">
                    1/3
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

              <!-- ═══ TaskItem 3: already done ═══ -->
              <div class="task-row flex min-h-10 items-center gap-2 px-1.5" data-done="true" data-priority="none">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="toggleTask(this.closest('.task-row'))" class="inline-flex size-6 cursor-pointer items-center justify-center" aria-label="Toggle task">
                    <span class="task-circle inline-flex size-4 items-center justify-center rounded-full border border-solid bg-foreground transition-all duration-300" style="border-color: var(--foreground); background-color: var(--foreground);">
                      <svg class="task-check size-2.5 text-background opacity-100 transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                  </button>
                  <span class="task-dot size-[5px] rounded-full bg-foreground/15 transition-colors duration-300"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="task-title truncate text-[13px] text-muted-foreground line-through transition-all duration-300">Update invoice for Kaya</p>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <span class="inline-flex h-5 items-center rounded border border-border/50 px-1.5 font-mono text-[10px] text-muted-foreground">
                    Feb 18
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </span>
                  <span class="inline-flex size-6 items-center justify-center text-muted-foreground">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="12" r="1" /><circle cx="9" cy="5" r="1" /><circle cx="9" cy="19" r="1" />
                      <circle cx="15" cy="12" r="1" /><circle cx="15" cy="5" r="1" /><circle cx="15" cy="19" r="1" />
                    </svg>
                  </span>
                </div>
              </div>

            </div>
          </section>

          <!-- ═══ SectionGroup: Done today (collapsed) ═══ -->
          <section class="rounded-md border border-border/60">
            <div class="flex items-center px-2 py-2">
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6" />
                </svg>
                <span class="text-[12px] font-medium text-foreground">Done today</span>
                <span id="done-count" class="ml-auto font-mono text-[11px] text-muted-foreground">1</span>
              </div>
            </div>
          </section>

        </div>

        <!-- ═══ Bottom bar ═══ -->
        <div class="mt-3 flex items-center gap-2">
          <div class="flex shrink-0 items-center gap-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground">
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
            <button
              type="button"
              onclick="toggleTheme(event)"
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-foreground"
              aria-label="Toggle theme"
            >
              <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.293 2.293a1 1 0 0 1 1.414 0l2.5 2.5 5.994 1.227a1 1 0 0 1 .506 1.687l-7 7a1 1 0 0 1-1.687-.506l-1.227-5.994-2.5-2.5a1 1 0 0 1 0-1.414z" />
                <path d="m14.207 4.793-3.414 3.414" />
                <path d="M3 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                <path d="m9.086 6.5-4.793 4.793a1 1 0 0 0-.18 1.17L7 18" />
              </svg>
            </button>
          </div>

          <div class="flex-1"></div>

          <div class="flex h-8 w-14 items-center justify-center rounded-md border border-border/60 bg-background/90 text-[10px] font-medium tracking-wide text-muted-foreground shadow-lg backdrop-blur-sm">
            Chat
          </div>
        </div>
      </div>

    </div>

    <!-- macOS Dock — sits below app window like a real desktop -->
    <div class="mt-24 flex flex-col items-center">
      <div class="dock-bar">
        <!-- Finder -->
        <div class="dock-item">
          <img class="dock-icon" src="/finder.png" alt="Finder" width="50" height="50" draggable="false" />
        </div>
        <!-- Safari -->
        <div class="dock-item">
          <img class="dock-icon" src="/safari.png" alt="Safari" width="50" height="50" draggable="false" />
        </div>
        <!-- Messages -->
        <div class="dock-item">
          <img class="dock-icon" src="/messages.png" alt="Messages" width="50" height="50" draggable="false" />
        </div>
        <!-- Untask (your app) -->
        <div class="dock-item dock-app">
          <a href="https://github.com/mbenhard/untask/releases/latest" class="dock-app-link" aria-label="Download Untask for macOS">
            <img src="/icon-app.png" alt="Untask" width="50" height="50" draggable="false" />
          </a>
          <span class="dock-tooltip">Untask</span>
          <span class="dock-dot"></span>
        </div>
        <!-- Calendar -->
        <div class="dock-item">
          <img class="dock-icon" src="/calendar.png" alt="Calendar" width="50" height="50" draggable="false" />
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .traffic-lights:hover span:nth-child(1) { background-color: #FF5F57; }
  .traffic-lights:hover span:nth-child(2) { background-color: #FEBC2E; }
  .traffic-lights:hover span:nth-child(3) { background-color: #28C840; }

  /* ─── macOS Dock ─── */

  .dock-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px;
    border-radius: 18px;
    background: var(--dock-bg);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 0.5px solid var(--dock-border);
    box-shadow: var(--dock-shadow);
  }

  /* Wrapper — stays still, provides hit area + anchor for dot */
  .dock-item {
    position: relative;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    /* extra space below for dot */
    padding-bottom: 0;
  }

  /* The icon/link is what actually lifts on hover */
  .dock-icon {
    display: block;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    opacity: var(--dock-icon-opacity);
    transform-origin: bottom center;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .dock-item:hover .dock-icon {
    transform: translateY(-4px) scale(1.10);
  }

  /* Untask link wrapper */
  .dock-app-link {
    display: block;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    transform-origin: bottom center;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .dock-item:hover .dock-app-link {
    transform: translateY(-4px) scale(1.10);
  }

  .dock-app-link img {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    display: block;
  }

  /* Tooltip */
  .dock-tooltip {
    position: absolute;
    bottom: calc(100% + 20px);
    left: 50%;
    transform: translateX(-50%) scale(0.96);
    padding: 3px 10px;
    border-radius: 5px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--accent);
    color: var(--foreground);
    border: 0.5px solid var(--border);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .dock-app:hover .dock-tooltip {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transition: opacity 0.15s ease 0.3s, transform 0.15s ease 0.3s;
  }

  /* Running dot — anchored to the wrapper, unaffected by icon hover */
  .dock-dot {
    position: absolute;
    bottom: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0.5;
  }
</style>

<script is:inline>
  var priorityColors = { amber: '#f59e0b', rose: '#f43f5e', none: '' };

  function toggleTask(row) {
    var isDone = row.dataset.done === 'true';
    var circle = row.querySelector('.task-circle');
    var check = row.querySelector('.task-check');
    var dot = row.querySelector('.task-dot');
    var title = row.querySelector('.task-title');
    var priority = row.dataset.priority;

    if (isDone) {
      // Uncomplete
      row.dataset.done = 'false';
      circle.style.borderStyle = 'dashed';
      circle.style.borderColor = 'var(--foreground-muted, rgba(245,245,245,0.35))';
      circle.style.backgroundColor = 'transparent';
      check.style.opacity = '0';
      dot.style.backgroundColor = priority === 'none'
        ? 'color-mix(in srgb, var(--foreground) 15%, transparent)'
        : priorityColors[priority];
      title.classList.remove('line-through', 'text-muted-foreground');
      title.classList.add('text-foreground');
    } else {
      // Complete
      row.dataset.done = 'true';
      circle.style.borderStyle = 'solid';
      circle.style.borderColor = 'var(--foreground)';
      circle.style.backgroundColor = 'var(--foreground)';
      check.style.opacity = '1';
      dot.style.backgroundColor = 'color-mix(in srgb, var(--foreground) 15%, transparent)';
      title.classList.add('line-through', 'text-muted-foreground');
      title.classList.remove('text-foreground');
    }

    updateCounts();
  }

  function updateCounts() {
    var rows = document.querySelectorAll('.task-row');
    var active = 0;
    var done = 0;
    rows.forEach(function(r) {
      if (r.dataset.done === 'true') done++;
      else active++;
    });
    var todayEl = document.getElementById('today-count');
    var doneEl = document.getElementById('done-count');
    if (todayEl) todayEl.textContent = active + done;
    if (doneEl) doneEl.textContent = done;
  }
</script>

{
  "name": "untask",
  "productName": "Untask",
  "version": "0.1.17",
  "description": "AI-powered task management assistant for solo freelancers",
  "main": ".vite/build/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:helper": "cd swift-helper && swift build -c release && cp .build/release/UntaskHelper ../resources/bin/untask-helper && codesign -s - ../resources/bin/untask-helper",
    "package": "npm run build:helper && electron-forge package",
    "make": "npm run build:helper && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "npm run ensure:sqlite-native && vitest run",
    "test:full": "npm run test",
    "test:smoke": "npm run ensure:sqlite-native && vitest run src/main/services/taskService.test.ts src/renderer/stores/taskStore.test.ts src/renderer/stores/chatStore.test.ts src/renderer/hooks/useTaskListKeyboard.test.ts",
    "test:watch": "vitest",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "ensure:sqlite-native": "node scripts/ensure-better-sqlite3.cjs",
    "postinstall": "node scripts/postinstall.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run rebuild:node && drizzle-kit migrate && npm run rebuild:electron",
    "db:studio": "npm run rebuild:node && drizzle-kit studio && npm run rebuild:electron"
  },
  "keywords": [],
  "author": {
    "name": "marcusbenhard",
    "email": "github@benhard.sk"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "drizzle-kit": "^0.31.9",
    "electron": "40.4.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.45",
    "@ai-sdk/openai": "^3.0.29",
    "@blocknote/ariakit": "0.46.2",
    "@blocknote/core": "^0.46.2",
    "@blocknote/react": "^0.46.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^6.0.91",
    "ai-sdk-ollama": "^3.7.1",
    "better-sqlite3": "^12.6.2",
    "chrono-node": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  }
}

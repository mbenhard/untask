{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron", "@electron-forge/plugin-vite/forge-vite-env"]
  },
  "include": [
    "forge.config.ts",
    "vite.aliases.ts",
    "vite.main.config.ts",
    "src/main/**/*.ts",
    "src/types/**/*.ts",
    "forge.env.d.ts"
  ]
}
